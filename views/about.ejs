<%
    const institution = (typeof siteSettings === 'object' && siteSettings) ? siteSettings : {};
    const setting = (key, fallback) => institution[key] || fallback;
    const legacySchoolDescription = 'Camarines Sur Polytechnic Colleges is a state-funded institution of higher learning in Nabua, Camarines Sur providing quality education in engineering, technology, and other disciplines.';
    const defaultSchoolContext = 'As the campus expands to accommodate growing academic programs and an increasing student body, the need for efficient campus management and navigation has become more vital than ever. CampuSphere acts as a digital twin to this dynamic physical environment.';
    const rawDescriptionText = setting('school_description', `${legacySchoolDescription}\n\n${defaultSchoolContext}`);
    const normalizedDescriptionText = String(rawDescriptionText).replace(/\r\n?/g, '\n').trim();
    const descriptionText = normalizedDescriptionText === legacySchoolDescription
        ? `${legacySchoolDescription}\n\n${defaultSchoolContext}`
        : normalizedDescriptionText;
    const providedDescriptionParts = (typeof schoolDescriptionParts !== 'undefined' && Array.isArray(schoolDescriptionParts))
        ? schoolDescriptionParts
        : null;
    const descriptionParts = (providedDescriptionParts || descriptionText.replace(/\r\n?/g, '\n').trim().split(/\n\s*\n/))
        .map((part) => String(part).trim())
        .filter(Boolean);
    const schoolOverview = descriptionParts[0] || legacySchoolDescription;
    const campusContext = descriptionParts.slice(1).join(' ');
%>
<!DOCTYPE html>

<html lang="en">



<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
        content="<%= schoolOverview %>">

    <title>CampuSphere | About Us</title>

    <link rel="stylesheet" href="/css/styles.css?v=10">

    <link rel="icon" type="image/png" href="/img/cspc-logo.png">

    <!-- Iconify Icon 1.0.7 component — self-hosted (M12.P1-R6). The component
         still fetches icon DATA from the approved api.iconify.design origin. -->

    <script src="/vendor/iconify-icon/iconify-icon.min.js"></script>

</head>



<body>

    <!-- ===== NAVBAR (shared partial) ===== -->
    <%- include('partials/dash-navbar', { activeTab: 'tabAbout' }) %>



        <!-- ===== PAGE ===== -->

        <div class="about-page page-transition">



            <!-- Hero -->

            <header class="about-hero">

                <div class="about-hero__content">

                    <h1 class="about-hero__title">Pioneering Smart Campus Navigation</h1>

                    <p class="about-hero__sub">Empowering students, faculty, and visitors at <%= setting('school_name', 'Camarines Sur Polytechnic Colleges') %> through innovative spatial technology and sustainable design.</p>

                </div>

            </header>



            <!-- Main Content -->

            <main class="about-container">



                <!-- CSPC History & Description -->

                <section class="split-block">

                    <div class="split-content">

                        <span class="section-tag">Our Institution</span>

                        <h2 class="section-title"><%= setting('school_name', 'Camarines Sur Polytechnic Colleges') %></h2>

                        <p><%= schoolOverview %></p>

                        <p><%= setting('school_acronym', 'CSPC') %> was founded in <%= setting('school_founded', '1983') %> and is located at <%= setting('school_address', 'Nabua, Camarines Sur, Philippines') %>.<% if (campusContext) { %> <%= campusContext %><% } %></p>

                    </div>

                    <div class="split-media">

                        <img src="/img/campus-hero.jpg" alt="CSPC Campus Overview" loading="lazy">

                    </div>

                </section>



                <!-- Project Overview & Problem Statement -->

                <section class="split-block reverse">

                    <div class="split-content">

                        <span class="section-tag">The Challenge</span>

                        <h2 class="section-title">Why CampuSphere?</h2>

                        <p><strong>The Problem:</strong> Navigating a growing campus can be overwhelming for freshmen,

                            transferees, and visitors. Finding specific halls, offices, or tracking down event locations

                            often leads to wasted time and unnecessary confusion. Furthermore, campus administration
                            lacks a

                            centralized, digital view of facility utilization.</p>

                        <p><strong>The Solution:</strong> CampuSphere is an interactive web-based campus map and
                            directory.

                            It provides real-time geographic insights, detailed building profiles, floor plans, and a

                            centralized hub for campus events. By merging GIS data with an intuitive interface, we
                            transform

                            the physical campus into an easily accessible digital experience.</p>

                    </div>

                    <div class="split-media">

                        <img src="/img/Camarines-sur-polytechnic-colleges.png" alt="Students navigating campus"
                            loading="lazy">

                    </div>

                </section>



                <!-- SDG Alignment -->

                <section>

                    <div class="section-header">

                        <span class="section-tag">Sustainable Impact</span>

                        <h2 class="section-title">Aligning with Global Goals</h2>

                        <p class="section-desc">CampuSphere isn't just a convenience tool; it's built to support the
                            United

                            Nations Sustainable Development Goals (SDGs) by fostering better education access and
                            innovative

                            infrastructure.</p>

                    </div>



                    <div class="sdg-grid">

                        <!-- SDG 4 -->

                        <div class="sdg-card sdg-4">

                            <div class="sdg-icon">

                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">

                                    <path d="M22 10v6M2 10l10-5 10 5-10 5z" />

                                    <path d="M6 12v5c3 3 9 3 12 0v-5" />

                                </svg>

                            </div>

                            <h3 class="sdg-title">Quality Education (SDG 4)</h3>

                            <p class="sdg-desc">By making campus facilities, libraries, and event schedules easily

                                accessible, CampuSphere ensures that students can focus on learning rather than
                                logistics.

                                It creates an inclusive environment where all educational resources are geographically

                                transparent to every student.</p>

                        </div>

                        <!-- SDG 9 -->

                        <div class="sdg-card sdg-9">

                            <div class="sdg-icon">

                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">

                                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />

                                </svg>

                            </div>

                            <h3 class="sdg-title">Industry, Innovation & Infrastructure (SDG 9)</h3>

                            <p class="sdg-desc">CampuSphere modernizes institutional infrastructure by taking physical

                                campus maps into the digital age. It represents a technological innovation in facility

                                management, promoting a sustainable and highly efficient campus environment through
                                smart

                                technology.</p>

                        </div>

                    </div>

                </section>



                <!-- Team Dutchess -->

                <section>

                    <div class="section-header">

                        <span class="section-tag">The Creators</span>

                        <h2 class="section-title">Meet Team Dutchess</h2>

                        <p class="section-desc">The dedicated minds behind the design, development, and mapping of

                            CampuSphere.</p>

                    </div>



                    <div class="team-grid">

                        <div class="member-card">
                            <div class="member-img">
                                <img src="/img/Baldoza.png" alt="Carl Andrie D. Baldoza">
                            </div>
                            <h3 class="member-name">Carl Andrie D. Baldoza</h3>
                            <p class="member-role">Project Head</p>
                        </div>

                        <div class="member-card">
                            <div class="member-img">
                                <img src="/img/Lagrimas.png" alt="Carl Ryan P. Lagrimas">
                            </div>
                            <h3 class="member-name">Carl Ryan P. Lagrimas</h3>
                            <p class="member-role">Backend Developer</p>
                        </div>

                        <div class="member-card">
                            <div class="member-img">
                                <img src="/img/Regondola.jpeg" alt="Ocean Derek L. Regondola">
                            </div>
                            <h3 class="member-name">Ocean Derek L. Regondola</h3>
                            <p class="member-role">Frontend Developer</p>
                        </div>

                        <div class="member-card">
                            <div class="member-img">
                                <img src="/img/Lasprillas.jpeg" alt="Aaron V. Lasprillas">
                            </div>
                            <h3 class="member-name">Aaron V. Lasprillas</h3>
                            <p class="member-role">UI/UX Designer</p>
                        </div>

                        <div class="member-card">
                            <div class="member-img">
                                <img class="member-photo member-photo--paga"
                                    src="/img/Paga.jpg" alt="John Lawrence A. Paga"
                                    width="879" height="960" loading="lazy" decoding="async">
                            </div>
                            <h3 class="member-name">John Lawrence A. Paga</h3>
                            <p class="member-role">Documenter</p>
                        </div>

                    </div>

                </section>



                <!-- Contact Info -->

                <section class="contact-card">

                    <h2 class="contact-title">Contact <%= setting('school_acronym', 'CSPC') %></h2>

                    <p class="contact-desc"><%= setting('contact_address', 'San Miguel, Nabua, Camarines Sur 4434') %> · <%= setting('contact_phone', '(054) 288 4421 to 23') %> · <%= setting('contact_hours', 'Monday - Friday, 8:00 AM - 5:00 PM') %></p>



                    <div class="contact-links">

                        <a href="mailto:<%= setting('contact_email', 'mail@cspc.edu.ph') %>" class="contact-btn">

                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">

                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />

                                <polyline points="22,6 12,13 2,6" />

                            </svg>

                            Email <%= setting('school_acronym', 'CSPC') %>

                        </a>

                        <a href="<%= setting('contact_website', 'https://cspc.edu.ph') %>" class="contact-btn outline" target="_blank" rel="noopener noreferrer">

                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">

                                <circle cx="12" cy="12" r="9" />
                                <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />

                            </svg>

                            Visit <%= setting('school_acronym', 'CSPC') %> Website

                        </a>

                    </div>

                </section>



            </main>

        </div>



        <!-- Theme Toggle -->

        <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">

            <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">

                <circle cx="12" cy="12" r="5" />

                <line x1="12" y1="1" x2="12" y2="3" />

                <line x1="12" y1="21" x2="12" y2="23" />

                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />

                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />

                <line x1="1" y1="12" x2="3" y2="12" />

                <line x1="21" y1="12" x2="23" y2="12" />

                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />

                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />

            </svg>

            <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">

                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />

            </svg>

        </button>



        <script nonce="<%= cspNonce %>">

            /* ===== NAVBAR ===== */

            const dashNav = document.getElementById('dashNav');

            window.addEventListener('scroll', () => {

                dashNav.classList.toggle('scrolled', window.scrollY > 10);

            });

            /* Mobile hamburger: owned by the shared /js/authenticated-nav.js
               client (M12.P1-D2) */



            /* ===== USERNAME — rendered server-side via EJS ===== */



            /* ===== THEME ===== */

            (function () {

                const toggle = document.getElementById('themeToggle');

                const iconSun = toggle.querySelector('.icon-sun');

                const iconMoon = toggle.querySelector('.icon-moon');



                function updateThemeUI(isDark) {

                    if (isDark) {

                        document.documentElement.setAttribute('data-theme', 'dark');

                        iconSun.style.display = 'none';

                        iconMoon.style.display = 'block';

                    } else {

                        document.documentElement.removeAttribute('data-theme');

                        iconSun.style.display = 'block';

                        iconMoon.style.display = 'none';

                    }

                }



                if (localStorage.getItem('campussphere-theme') === 'dark') {

                    updateThemeUI(true);

                }



                toggle.addEventListener('click', () => {

                    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

                    updateThemeUI(!isDark);

                    localStorage.setItem('campussphere-theme', !isDark ? 'dark' : 'light');

                });

            })();

        </script>

        <!-- Edit Profile Script -->

        <script src="/js/profile-script.js"></script>

        <script src="/js/nav-role.js"></script>

</body>



</html>
