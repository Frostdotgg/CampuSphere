                        <h2 class="section-title">Meet Team Dutchess</h2>

                        <p class="section-desc">The dedicated minds behind the design, development, and mapping of

                            CampuSphere.</p>

                    </div>



                    <div class="team-grid">

                        <div class="member-card">
                            <div class="member-img">
                                <img src="/img/Baldoza.png" alt="Carl Andrie D. Baldoza">
                            </div>
                            <h3 class="member-name">Carl Andrie D. Baldoza</h3>
                            <p class="member-role">Project Head</p>
                        </div>

                        <div class="member-card">
                            <div class="member-img">
                                <img src="/img/Lagrimas.png" alt="Carl Ryan P. Lagrimas">
                            </div>
                            <h3 class="member-name">Carl Ryan P. Lagrimas</h3>
                            <p class="member-role">Backend Developer</p>
                        </div>

                        <div class="member-card">
                            <div class="member-img">
                                <img src="/img/Regondola.jpeg" alt="Ocean Derek L. Regondola">
                            </div>
                            <h3 class="member-name">Ocean Derek L. Regondola</h3>
                            <p class="member-role">Frontend Developer</p>
                        </div>

                        <div class="member-card">
                            <div class="member-img">
