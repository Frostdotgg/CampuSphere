<!DOCTYPE html>

<html lang="en">



<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
        content="CampuSphere — Browse all CSPC campus buildings, view floor plans, and find rooms.">

    <title>CampuSphere | Campus Buildings</title>

    <link rel="stylesheet" href="/css/styles.css?v=8">
    <link rel="stylesheet" href="/css/room-schedule-viewer.css">

    <link rel="icon" type="image/png" href="/img/cspc-logo.png">
    <!-- PWA: installability + app metadata (Milestone 6, Section 6.2) -->
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#0f2a44">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="CampuSphere">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="apple-touch-icon" href="/img/icons/apple-touch-icon.png">
    <!-- PWA: service worker registration + connectivity banner (Milestone 6, Section 6.3) -->
    <script src="/js/pwa.js" defer></script>

    <!-- Iconify -->

    <!-- iconify-icon script removed (Milestone 11.8 cleanup): this page uses no
         <iconify-icon> elements (the navbar icons are inline SVGs), and the
         component's shadow-root styles violate style-src-elem under the CSP. -->

</head>



<body>

    <!-- ===== NAVBAR (shared partial) ===== -->
    <%- include('partials/dash-navbar', { activeTab: 'tabBuildings' }) %>



        <!-- ===== PAGE ===== -->

        <div class="bldg-page">



            <!-- Hero -->

            <div class="bldg-hero">

                <img src="/img/campus-hero.jpg" alt="CSPC Campus">

                <div class="bldg-hero__overlay"></div>

                <div class="bldg-hero__content">

                    <h1 class="bldg-hero__title">Campus Buildings</h1>

                    <p class="bldg-hero__sub">Explore all facilities — click any building to view floors, rooms, and

                        entrances.</p>

                </div>

            </div>



            <!-- Main -->

            <div class="bldg-main">



                <!-- Search bar -->

                <div class="bldg-search-wrap">

                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">

                        <circle cx="11" cy="11" r="8" />

                        <line x1="21" y1="21" x2="16.65" y2="16.65" />

                    </svg>

                    <input class="bldg-search" id="bldgSearch" type="search"
                        placeholder="Search buildings by name or description…" autocomplete="off">

                    <button class="bldg-search-clear" id="bldgSearchClear" aria-label="Clear search">✖</button>

                </div>



                <!-- Filter bar -->

                <div class="bldg-filters" id="filterBar">

                    <button class="bldg-filter-btn active" data-filter="all">All Buildings</button>

                    <button class="bldg-filter-btn" data-filter="Academic">

                        <span
                            style="width:8px;height:8px;border-radius:50%;background:var(--navy-500);display:inline-block;"></span>Academic

                    </button>

                    <button class="bldg-filter-btn" data-filter="Administrative">

                        <span
                            style="width:8px;height:8px;border-radius:50%;background:var(--gold);display:inline-block;"></span>Administrative

                    </button>

                    <button class="bldg-filter-btn" data-filter="Facilities">

                        <span
                            style="width:8px;height:8px;border-radius:50%;background:var(--green-accent);display:inline-block;"></span>Facilities

                    </button>

                    <span class="bldg-count" id="bldgCount"></span>

                </div>



                <!-- Grid -->

                <div class="bldg-grid" id="bldgGrid"></div>



                <!-- Empty state -->

                <div class="bldg-empty" id="emptyState">

                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="1.5">

                        <rect x="4" y="2" width="16" height="20" rx="2" />

                        <path d="M9 22v-4h6v4" />

                    </svg>

                    <p>No buildings match this filter.</p>

                </div>

            </div>

        </div>



        <!-- ===== BUILDING DETAIL MODAL ===== -->

        <div class="modal-overlay" id="modalOverlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle">

            <div class="modal" id="modal">

                <div class="modal__header">

                    <div>

                        <div class="modal__title" id="modalTitle">Building Name</div>

                        <span class="modal__tag" id="modalTag"></span>

                    </div>

                    <button class="modal__close" id="modalClose" aria-label="Close">✖</button>

                </div>

                <div class="modal__body">



                    <!-- Floor plan panel -->

                    <div class="floor-panel">

                        <div class="floor-panel__label">Floor Plan</div>

                        <div class="floor-selector" id="floorSelector"></div>

                        <div class="floor-plan-box">

                            <div class="floor-plan-header" id="floorPlanHeader">Ground Floor</div>

                            <div class="floor-plan-rooms" id="floorPlanRooms"></div>

                        </div>

                    </div>



                    <!-- Info grid -->

                    <div class="info-grid">

                        <div class="info-section">

                            <div class="info-section__title">Entrances &amp; Exits</div>

                            <ul class="info-list" id="modalEntrances"></ul>

                        </div>

                        <div class="info-section">

                            <div class="info-section__title">Key Information</div>

                            <ul class="info-list" id="modalInfo"></ul>

                        </div>

                    </div>

                    <!-- Room & facility schedules (Milestone 11, Section 11.6).
                     Real admin-managed entries only; rendered with
                     createElement/textContent — never unescaped HTML. -->
                    <div class="info-section" id="schedulePanel" style="margin-top:1rem;">
                        <div class="info-section__title">Current Semester Room Schedules</div>
                        <p id="scheduleLoading"
                            style="color:var(--gray-500);font-size:.85rem;padding:.35rem 0;margin:0;">Loading schedules…
                        </p>
                        <p id="scheduleEmpty" style="color:var(--gray-500);font-size:.85rem;padding:.35rem 0;margin:0;"
                            hidden>No room schedule images are available for this building.</p>
                        <p id="scheduleError" style="color:var(--gray-500);font-size:.85rem;padding:.35rem 0;margin:0;"
                            hidden>Unable to load schedules.</p>
                        <ul class="info-list" id="scheduleList" hidden></ul>
                    </div>

                </div>

            </div>

        </div>



        <!-- Theme Toggle -->

        <!-- ===== ROUTE MODAL ===== -->

        <div class="route-modal-overlay" id="routeModalOverlay" role="dialog" aria-modal="true">

            <div class="route-modal">

                <div class="route-modal__header">

                    <div>

                        <div class="route-modal__title" id="routeModalTitle">Routes to Building</div>

                        <div class="route-modal__subtitle" id="routeModalSubtitle">Walking directions from Main Gate
                        </div>

                    </div>

                    <button class="route-modal__close" id="routeModalClose" aria-label="Close">✖</button>

                </div>

                <div class="route-modal__body" id="routeModalBody"></div>

            </div>

        </div>



        <!-- Theme Toggle -->

        <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">

            <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">

                <circle cx="12" cy="12" r="5" />

                <line x1="12" y1="1" x2="12" y2="3" />

                <line x1="12" y1="21" x2="12" y2="23" />

                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />

                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />

                <line x1="1" y1="12" x2="3" y2="12" />

                <line x1="21" y1="12" x2="23" y2="12" />

                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />

                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />

            </svg>

            <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">

                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />

            </svg>

        </button>



        <script id="buildingsData" type="application/json"
            nonce="<%= cspNonce %>"><%- safeJson(buildings || []) %></script>

        <script nonce="<%= cspNonce %>">

            /* ===== BUILDINGS DATA ===== */

            const BUILDINGS = JSON.parse(document.getElementById('buildingsData').textContent);

            /* ===== OUTPUT-ENCODING HELPERS (R1: Stored-XSS Removal) =====
               Database-derived building/floor/room/entrance/route/landmark values
               must never be interpreted as HTML. escapeHtml() encodes text and
               quoted-attribute contexts; safeUrl() validates dynamic image URLs and
               rejects javascript:, unsafe data:, and attribute-breakout input. */
            function escapeHtml(value) {
                if (value === null || value === undefined) return '';
                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }
            function safeUrl(value, opts) {
                if (value === null || value === undefined) return '';
                var s = String(value).trim();
                if (s === '') return '';
                var scheme = s.replace(/\s+/g, '').toLowerCase();
                if (scheme.indexOf('javascript:') === 0 || scheme.indexOf('vbscript:') === 0) return '';
                if (scheme.indexOf('data:') === 0) {
                    if (opts && opts.allowDataImage &&
                        /^data:image\/(png|jpe?g|gif|webp|bmp);base64,[a-z0-9+/=\s]+$/i.test(s)) return s;
                    return '';
                }
                if (s.charAt(0) === '/' || s.charAt(0) === '#' || s.charAt(0) === '.') return s;
                if (/^https?:\/\//i.test(s)) return s;
                var colon = s.indexOf(':');
                if (colon === -1) return s;
                var slash = s.indexOf('/');
                if (slash !== -1 && slash < colon) return s;
                return '';
            }
            // Positive-integer coercion for ids used in URL path segments.
            function safeIntId(value) {
                var n = Number(value);
                return (Number.isInteger(n) && n > 0) ? n : null;
            }

            /* BE.3: fixed, sanitized labels for the server's route-availability
               verdict. The reason codes come from services/routeAvailability.js;
               anything unrecognised falls back to a generic label, so a future code
               can never render as raw text. */
            function routeUnavailableLabel(b) {
                switch (b && b.route_unavailable_reason) {
                    case 'not_mapped': return 'Route not set up yet';
                    case 'unreachable': return 'No walking route yet';
                    case 'invalid_geometry': return 'Route unavailable';
                    case 'ambiguous_name': return 'Duplicate building name — route unavailable';
                    case 'route_data_unavailable': return 'Route status unavailable';
                    default: return 'Route unavailable';
                }
            }



            /* ===== TAG COLORS ===== */

            const TAG_CLASS = { Academic: 'tag--academic', Administrative: 'tag--admin', Facilities: 'tag--facilities' };

            const TAG_STYLE = { Academic: 'background:rgba(30,77,140,.15);color:var(--navy-700)', Administrative: 'background:rgba(212,168,67,.2);color:#7a4f00', Facilities: 'background:rgba(22,163,74,.15);color:#15803d' };



            /* ===== RENDER GRID ===== */

            let currentFilter = 'all';

            let currentQuery = '';



            function renderGrid(filter = currentFilter, query = currentQuery) {

                currentFilter = filter;

                currentQuery = query;

                const grid = document.getElementById('bldgGrid');

                const empty = document.getElementById('emptyState');

                const countEl = document.getElementById('bldgCount');

                const q = query.toLowerCase().trim();

                let filtered = filter === 'all' ? BUILDINGS : BUILDINGS.filter(b => b.category === filter);

                if (q) filtered = filtered.filter(b => b.name.toLowerCase().includes(q) || b.desc.toLowerCase().includes(q));

                countEl.textContent = filtered.length + ' building' + (filtered.length !== 1 ? 's' : '');

                if (!filtered.length) { grid.innerHTML = ''; empty.style.display = 'block'; return; }

                empty.style.display = 'none';

                const role = window.__SESSION_USER && window.__SESSION_USER.role ? window.__SESSION_USER.role : 'anonymous';

                const isLimitedVisitor = role === 'guest' || role === 'anonymous';

                grid.innerHTML = filtered.map(b => `

        <div class="bldg-card${b.route_available === true ? '' : ' bldg-card--route-unavailable'}" data-id="${Number(b.id)}"${b.route_available === true ? '' : ' data-route-unavailable="true"'}>

            <div class="bldg-card__img">

                <img src="${escapeHtml(safeUrl(b.img))}" alt="${escapeHtml(b.name)}" loading="lazy">

                <span class="bldg-card__tag ${TAG_CLASS[b.category] || ''}">${escapeHtml(b.category)}</span>

                ${isLimitedVisitor && !b.guestAccess ? '<span class="bldg-card__restricted-badge"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Restricted</span>' : ''}

                ${b.route_available === true ? '' : `<span class="bldg-card__route-badge">${escapeHtml(routeUnavailableLabel(b))}</span>`}

            </div>

            <div class="bldg-card__body">

                <div class="bldg-card__name">${escapeHtml(b.name)}</div>

                <p class="bldg-card__desc">${escapeHtml(b.desc)}</p>

                <div class="bldg-card__footer">

                    <button class="bldg-card__btn bldg-card__btn--primary" data-action="details">View Details</button>

                    <button class="bldg-card__btn bldg-card__btn--routes" data-action="routes">View Routes</button>

                </div>

            </div>

        </div>`).join('');

                // Stored ids never enter inline handlers: the card listener reads the
                // validated integer data-id and routes by data-action (R1).
                grid.querySelectorAll('.bldg-card').forEach(c => c.addEventListener('click', (e) => {
                    const id = Number(c.dataset.id);
                    const actionBtn = e.target.closest('[data-action]');
                    if (actionBtn && actionBtn.dataset.action === 'routes') { openRouteModal(id); }
                    else { openModal(id); }
                }));

            }



            /* ===== FILTER BUTTONS ===== */

            document.getElementById('filterBar').querySelectorAll('.bldg-filter-btn').forEach(btn => {

                btn.addEventListener('click', () => {

                    document.querySelectorAll('.bldg-filter-btn').forEach(b => b.classList.remove('active'));

                    btn.classList.add('active');

                    renderGrid(btn.dataset.filter, currentQuery);

                });

            });



            /* ===== SEARCH ===== */

            const searchInput = document.getElementById('bldgSearch');

            const searchClear = document.getElementById('bldgSearchClear');



            searchInput.addEventListener('input', () => {

                const q = searchInput.value;

                searchClear.classList.toggle('visible', q.length > 0);

                renderGrid(currentFilter, q);

            });



            searchClear.addEventListener('click', () => {

                searchInput.value = '';

                searchClear.classList.remove('visible');

                renderGrid(currentFilter, '');

                searchInput.focus();

            });



            /* ===== MODAL ===== */

            let activeBuilding = null, activeFloor = 0;



            function openModal(id) {

                const b = BUILDINGS.find(x => x.id === id);

                if (!b) return;

                activeBuilding = b; activeFloor = 0;

                const participantDetails = b.participantDetails || {};
                const floors = Array.isArray(participantDetails.floors) ? participantDetails.floors : [];

                document.getElementById('modalTitle').textContent = b.name;

                const tag = document.getElementById('modalTag');

                tag.textContent = b.category; tag.style.cssText = TAG_STYLE[b.category] + ';padding:.2rem .65rem;border-radius:999px;font-size:.7rem;font-weight:700;text-transform:uppercase;';

                // Floors

                const sel = document.getElementById('floorSelector');

                if (floors.length > 0) {

                    sel.innerHTML = floors.map((f, i) => `<button class="floor-btn ${i === 0 ? 'active' : ''}" data-fi="${i}">${escapeHtml(f.label)}</button>`).join('');

                    sel.querySelectorAll('.floor-btn').forEach(btn => btn.addEventListener('click', () => {

                        sel.querySelectorAll('.floor-btn').forEach(b => b.classList.remove('active'));

                        btn.classList.add('active'); renderFloor(+btn.dataset.fi);

                    }));

                    renderFloor(0);

                } else {

                    sel.innerHTML = '';

                    document.getElementById('floorPlanHeader').textContent = 'Floor Plan';

                    document.getElementById('floorPlanRooms').innerHTML = '<p style="color:var(--gray-500);font-size:.85rem;padding:.5rem 0">No floor plan available.</p>';

                }

                // Entrances

                const entrances = Array.isArray(participantDetails.entrances) ? participantDetails.entrances : [];

                document.getElementById('modalEntrances').innerHTML = entrances.length

                    ? entrances.map(e => `<li>${escapeHtml(e)}</li>`).join('')

                    : '<li style="color:var(--gray-500)">No entrance data available.</li>';

                // Info

                const info = Array.isArray(participantDetails.keyInformation) ? participantDetails.keyInformation : [];

                document.getElementById('modalInfo').innerHTML = info.length

                    ? info.map(i => `<li>${i.label ? `<strong>${escapeHtml(i.label)}:</strong> ` : ''}${escapeHtml(i.value)}</li>`).join('')

                    : '<li style="color:var(--gray-500)">No additional info.</li>';

                // Room/facility schedules (Milestone 11, Section 11.6)

                loadBuildingSchedules(b.id);

                document.getElementById('modalOverlay').classList.add('open');

                document.body.style.overflow = 'hidden';

            }



            function loadBuildingSchedules(buildingId) {
                if (window.CampuSphereBuildingSchedules) {
                    window.CampuSphereBuildingSchedules.load(buildingId);
                }
            }



            function renderFloor(fi) {

                const details = activeBuilding && activeBuilding.participantDetails;
                const floors = details && Array.isArray(details.floors) ? details.floors : [];
                const floor = floors[fi];
                if (!floor) return;

                document.getElementById('floorPlanHeader').textContent = floor.label + ' — Room Layout';

                document.getElementById('floorPlanRooms').innerHTML = floor.rooms.map(r =>

                    `<div class="room-block"><span class="room-block__num">${escapeHtml(r.heading)}</span><span class="room-block__use">${escapeHtml(r.use)}</span></div>`).join('');

            }



            function closeModal() {

                document.getElementById('modalOverlay').classList.remove('open');

                document.body.style.overflow = '';

            }



            document.getElementById('modalClose').addEventListener('click', closeModal);

            document.getElementById('modalOverlay').addEventListener('click', e => { if (e.target === e.currentTarget) closeModal(); });

            document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeModal(); closeRouteModal(); } });



            /* ===== ROUTE MODAL ===== */

            function openRouteModal(id) {

                const b = BUILDINGS.find(x => x.id === id);

                if (!b) return;

                const role = window.__SESSION_USER && window.__SESSION_USER.role ? window.__SESSION_USER.role : 'anonymous';

                const isLimitedVisitor = role === 'guest' || role === 'anonymous';

                const restricted = isLimitedVisitor && !b.guestAccess;

                document.getElementById('routeModalTitle').textContent = 'Routes to ' + b.name;

                document.getElementById('routeModalSubtitle').textContent = 'Walking directions from Main Gate • ' + (b.walkTime || '~5 min');

                let html = '';

                if (restricted) {

                    html += `<div class="route-restricted-warning">

                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>

                    <div class="route-restricted-warning__text">

                        <strong>Restricted Access — Guests Cannot Enter</strong>

                        This building is restricted to authorized personnel (students, faculty, or staff) only. You may view the exterior and surroundings but entry is not permitted for guests.

                    </div>

                </div>`;

                }

                html += '<div class="route-info-label">Walking Directions</div>';

                html += '<div class="route-time"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>' + escapeHtml(b.walkTime || '~5 min') + '</div>';

                html += '<ol class="route-steps">';

                (b.routes || []).forEach((step, i) => {

                    html += `<li class="route-step"><span class="route-step__num">${i + 1}</span><span class="route-step__text">${escapeHtml(step)}</span></li>`;

                });

                html += '</ol>';

                if (b.landmarks && b.landmarks.length) {

                    html += '<div class="route-landmarks"><div class="route-info-label">Nearby Landmarks</div><ul class="route-landmark-list">';

                    b.landmarks.forEach(l => { html += `<li>${escapeHtml(l)}</li>`; });

                    html += '</ul></div>';

                }

                // BE.3: the guided-VR action depends on a real campus route. When the
                // server says this building has no usable route, the modal stays open
                // with all its campus information but the action is withdrawn and the
                // sanitized reason is shown instead of an link that would only fail.
                const vrId = safeIntId(b.vr_route_id);
                const routeAvailable = (b.route_available === true);

                if (!routeAvailable) {

                    html += `<div class="route-modal__vr"><span class="route-info-label route-info-label--unavailable">${escapeHtml(routeUnavailableLabel(b))}</span></div>`;

                } else if (vrId) {

                    html += `<div class="route-modal__vr"><a class="btn btn--primary btn--sm" href="/vr/routes/${vrId}">Start VR Route</a><p class="route-vr-offline-hint" id="routeVrOfflineHint" hidden style="margin-top:.5rem;font-size:.8rem;line-height:1.35;color:var(--gray-500);"></p></div>`;

                } else {

                    html += '<div class="route-modal__vr"><span class="route-info-label">VR route not available yet.</span></div>';

                }

                document.getElementById('routeModalBody').innerHTML = html;

                document.getElementById('routeModalOverlay').classList.add('open');

                document.body.style.overflow = 'hidden';

                if (vrId) { showVrOfflineHint(vrId); }

            }

            /* When offline, the guided VR route needs an internet connection.
               Authenticated page HTML is never cached (R2: Authenticated PWA Privacy),
               so the route page is not available offline — show a clear, session-neutral
               hint and read no user/session data. */
            function showVrOfflineHint() {
                if (navigator.onLine !== false) return; // online: the live link just works
                var el = document.getElementById('routeVrOfflineHint');
                if (!el) return;
                el.textContent = 'This VR route needs an internet connection.';
                el.hidden = false;
            }



            function closeRouteModal() {

                document.getElementById('routeModalOverlay').classList.remove('open');

                document.body.style.overflow = '';

            }



            document.getElementById('routeModalClose').addEventListener('click', closeRouteModal);

            document.getElementById('routeModalOverlay').addEventListener('click', e => { if (e.target === e.currentTarget) closeRouteModal(); });



            /* ===== NAVBAR ===== */

            const dashNav = document.getElementById('dashNav');

            window.addEventListener('scroll', () => dashNav.classList.toggle('scrolled', scrollY > 10));

            /* Mobile hamburger: owned by the shared /js/authenticated-nav.js
               client (M12.P1-D2) */



            /* ===== USERNAME — rendered server-side via EJS ===== */



            /* ===== THEME ===== */

            (function () {

                const toggle = document.getElementById('themeToggle');

                if (localStorage.getItem('campussphere-theme') === 'dark') document.documentElement.setAttribute('data-theme', 'dark');

                toggle.addEventListener('click', () => {

                    const dark = document.documentElement.getAttribute('data-theme') === 'dark';

                    dark ? document.documentElement.removeAttribute('data-theme') : document.documentElement.setAttribute('data-theme', 'dark');

                    localStorage.setItem('campussphere-theme', dark ? 'light' : 'dark');

                });

            })();



            /* ===== INIT ===== */

            renderGrid();

        </script>

        <%- include('partials/room-schedule-viewer') %>

        <script src="/js/room-schedule-viewer.js"></script>
        <script src="/js/building-room-schedules.js"></script>

        <!-- Edit Profile Script -->

        <script src="/js/profile-script.js"></script>

        <script src="/js/nav-role.js"></script>

</body>



</html>
