    <!-- =========================================================


       DATA + EJS TEMPLATE ENGINE


       ========================================================= -->


    <script src="/js/data.js"></script>


    <script id="dbNewsData" type="application/json" nonce="<%= cspNonce %>">
      <%- safeJson(typeof news !== 'undefined' ? news : []) %>
    </script>
    <script id="dbStudentProfile" type="application/json" nonce="<%= cspNonce %>">
      <%- safeJson(typeof studentProfile !== 'undefined' && studentProfile ? studentProfile : null) %>
    </script>
    <script id="dbInstructorProfile" type="application/json" nonce="<%= cspNonce %>">
      <%- safeJson(typeof instructorProfile !== 'undefined' && instructorProfile ? instructorProfile : null) %>
    </script>
    <script nonce="<%= cspNonce %>">
      // ======= SHARED OUTPUT-ENCODING HELPERS (R1: Stored-XSS Removal) =======
      // Database- and session-derived values must never be interpreted as HTML.
      // escapeHtml() is the single context-appropriate encoder for text AND
      // quoted-attribute contexts; safeUrl() validates dynamic image/navigation
      // URLs and rejects javascript:, unsafe data:, and attribute-breakout input.
      function escapeHtml(value) {
        if (value === null || value === undefined) return '';
        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }
      function safeUrl(value, opts) {
        if (value === null || value === undefined) return '';
        var s = String(value).trim();
        if (s === '') return '';
        // Collapse control/space chars before scheme inspection so tricks like
        // "java\tscript:" cannot smuggle a dangerous scheme past the check.
        var scheme = s.replace(/\s+/g, '').toLowerCase();
        if (scheme.indexOf('javascript:') === 0 || scheme.indexOf('vbscript:') === 0) return '';
        if (scheme.indexOf('data:') === 0) {
          if (opts && opts.allowDataImage &&
            /^data:image\/(png|jpe?g|gif|webp|bmp);base64,[a-z0-9+/=\s]+$/i.test(s)) return s;
          return '';
        }
        // Root-relative, hash, or explicitly-relative paths are safe.
        if (s.charAt(0) === '/' || s.charAt(0) === '#' || s.charAt(0) === '.') return s;
        // Absolute http(s) only.
        if (/^https?:\/\//i.test(s)) return s;
        // Bare relative path with no scheme (no ':' before the first '/').
        var colon = s.indexOf(':');
        if (colon === -1) return s;
        var slash = s.indexOf('/');
        if (slash !== -1 && slash < colon) return s;
        return '';
      }

      // Override data.js with database data
      const dbNews = JSON.parse(document.getElementById('dbNewsData').textContent);
      // Server-filtered announcements are authoritative; an empty result must
      // NOT fall back to static mock news (Milestone 4, Phase 2 Section 5).
      if (Array.isArray(dbNews)) {
        CampuSphereData.news = dbNews.map(n => ({
          id: n.id,
          title: n.title,
          category: n.category,
          date: new Date(n.published_date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }),
          excerpt: n.excerpt
        }));
      }

      // Sanitize any DB-derived profile image URL so a hostile stored value
      // (javascript:, data:text/html, attribute-breakout) can never reach an
      // <img src>. Valid http(s)/relative paths and image data URLs pass through.
      function sanitizeProfileImage(profile) {
        if (profile && profile.profileImage) {
          profile.profileImage = safeUrl(profile.profileImage, { allowDataImage: true });
        }
        return profile;
      }

      // Override student profile with server data
      const serverStudentProfile = JSON.parse(document.getElementById('dbStudentProfile').textContent);
      if (serverStudentProfile) {
        CampuSphereData.studentProfile = sanitizeProfileImage(serverStudentProfile);
      }

      // Override instructor profile with server data
      const serverInstructorProfile = JSON.parse(document.getElementById('dbInstructorProfile').textContent);
      if (serverInstructorProfile) {
        CampuSphereData.instructorProfile = sanitizeProfileImage(serverInstructorProfile);
      }

      // ======= CLIENT-SIDE EJS TEMPLATE ENGINE =======


      // CSP-safe template renderer (Milestone 8, Section 8.5). The dashboard
      // role/section templates use a small, fixed subset: escaped output tags
      // and if / else / for control-flow tags. They are tokenized, parsed into a
      // small tree, and interpreted WITHOUT new Function / eval, so they run
      // under the nonce-based CSP (which omits 'unsafe-eval'). Output is
      // identical to the previous engine for the existing templates. Tag
      // delimiters are built by string concatenation so no literal template tag
      // appears in this server-rendered file.
      var TPL_OPEN = '<' + '%';
      var TPL_CLOSE = '%' + '>';

      function tplTokenize(tpl) {
        var re = new RegExp(TPL_OPEN + '([-=])?([\\s\\S]*?)' + TPL_CLOSE, 'g');
        var tokens = [];
        var cursor = 0;
        var m;
        while ((m = re.exec(tpl)) !== null) {
          if (m.index > cursor) tokens.push({ type: 'text', value: tpl.slice(cursor, m.index) });
          cursor = re.lastIndex;
          if (m[1] === '=') tokens.push({ type: 'out', expr: m[2].trim(), escaped: true });
          else if (m[1] === '-') tokens.push({ type: 'out', expr: m[2].trim(), escaped: false });
          else tokens.push({ type: 'code', code: m[2].trim() });
        }
        if (cursor < tpl.length) tokens.push({ type: 'text', value: tpl.slice(cursor) });
        return tokens;
      }

      // Parse the token stream into nodes, resolving nested if/for blocks.
      function tplParse(tokens, state) {
        var nodes = [];
        while (state.i < tokens.length) {
          var tok = tokens[state.i];
          if (tok.type !== 'code') { nodes.push(tok); state.i++; continue; }
          var code = tok.code;
          var ifm = code.match(/^if\s*\(([\s\S]+)\)\s*\{$/);
          var form = code.match(/^for\s*\(\s*var\s+([A-Za-z_$][\w$]*)\s*=\s*0\s*;\s*([\s\S]+?)\s*;\s*[A-Za-z_$][\w$]*\s*\+\+\s*\)\s*\{$/);
          if (ifm) {
            state.i++;
            var thenPart = tplParse(tokens, state);
            var elseNodes = [];
            if (thenPart.stopped === 'else') elseNodes = tplParse(tokens, state).nodes;
            nodes.push({ type: 'if', cond: ifm[1].trim(), then: thenPart.nodes, els: elseNodes });
          } else if (form) {
            state.i++;
            var body = tplParse(tokens, state);
            nodes.push({ type: 'for', varName: form[1], cond: form[2].trim(), body: body.nodes });
          } else if (/^\}\s*else\s*\{$/.test(code)) {
            state.i++;
            return { nodes: nodes, stopped: 'else' };
          } else if (/^\}$/.test(code)) {
            state.i++;
            return { nodes: nodes, stopped: 'end' };
          } else {
            // Unsupported code token: ignore safely (never eval'd).
            state.i++;
          }
        }
        return { nodes: nodes, stopped: null };
      }

      function tplLookup(name, data, locals) {
        if (locals && Object.prototype.hasOwnProperty.call(locals, name)) return locals[name];
        if (data && Object.prototype.hasOwnProperty.call(data, name)) return data[name];
        return undefined;
      }

      // Resolve a pure property/index path: a, a.b, a[i], a.b[i], a[i].b, ...
      function tplResolvePath(expr, data, locals) {
        expr = expr.trim();
        var head = /^([A-Za-z_$][\w$]*)/.exec(expr);
        if (!head) return undefined;
        var cur = tplLookup(head[1], data, locals);
        var rest = expr.slice(head[1].length);
        var partRe = /^\.([A-Za-z_$][\w$]*)|^\[\s*([^\]]+?)\s*\]/;
        while (rest.length) {
          var pm = partRe.exec(rest);
          if (!pm) break;
          if (pm[1] !== undefined) {
            cur = (cur == null) ? undefined : cur[pm[1]];
          } else {
            cur = (cur == null) ? undefined : cur[tplResolveValue(pm[2], data, locals)];
          }
          rest = rest.slice(pm[0].length);
        }
        return cur;
      }

      // Resolve a value: integer/boolean/null literal, else a property path.
      function tplResolveValue(expr, data, locals) {
        expr = String(expr).trim();
        if (/^-?\d+$/.test(expr)) return parseInt(expr, 10);
        if (expr === 'true') return true;
        if (expr === 'false') return false;
        if (expr === 'null') return null;
        return tplResolvePath(expr, data, locals);
      }

      // Conditions: `path === literal` / `path !== literal`, else path truthiness.
      function tplEvalCond(expr, data, locals) {
        var eq = expr.split('===');
        if (eq.length === 2) return tplResolveValue(eq[0], data, locals) === tplResolveValue(eq[1], data, locals);
        var ne = expr.split('!==');
        if (ne.length === 2) return tplResolveValue(ne[0], data, locals) !== tplResolveValue(ne[1], data, locals);
        return !!tplResolveValue(expr, data, locals);
      }

      // For-loop bound: `i < bound` clauses joined by optional `&&`.
      function tplEvalLoop(cond, data, locals) {
        var parts = cond.split('&&');
        for (var p = 0; p < parts.length; p++) {
          var cm = parts[p].trim().match(/^([A-Za-z_$][\w$]*)\s*<\s*([\s\S]+)$/);
          if (!cm) return false;
          if (!(tplResolveValue(cm[1], data, locals) < tplResolveValue(cm[2], data, locals))) return false;
        }
        return true;
      }

      function tplRenderNodes(nodes, data, locals, out) {
        for (var k = 0; k < nodes.length; k++) {
          var n = nodes[k];
          if (n.type === 'text') {
            out.push(n.value);
          } else if (n.type === 'out') {
            var v = tplResolveValue(n.expr, data, locals);
            out.push(n.escaped ? escapeHtml(v) : (v == null ? '' : String(v)));
          } else if (n.type === 'if') {
            tplRenderNodes(tplEvalCond(n.cond, data, locals) ? n.then : n.els, data, locals, out);
          } else if (n.type === 'for') {
            var loc = Object.assign({}, locals);
            loc[n.varName] = 0;
            var guard = 0;
            while (tplEvalLoop(n.cond, data, loc)) {
              tplRenderNodes(n.body, data, loc, out);
              loc[n.varName] = loc[n.varName] + 1;
              if (++guard > 100000) break; // defensive: never spin forever
            }
          }
        }
      }

      // Drop-in replacement for the former new Function-based engine.
      function ejsRender(templateStr, data) {
        try {
          var tokens = tplTokenize(templateStr);
          var tree = tplParse(tokens, { i: 0 });
          var out = [];
          tplRenderNodes(tree.nodes, data, {}, out);
          return out.join('');
        } catch (e) {
          console.error('Template render error.');
          return '<p style="color:red;">Template render error</p>';
        }
      }





      // ======= TEMPLATE MAPPING PER ROLE/SECTION =======


      const templateMap = {


        'student-cspc': {


          'overview': 'tmpl-student-cspc-overview',


          'profile': 'tmpl-student-cspc-profile',


          'news': 'tmpl-shared-news',




        },


        'student-non-cspc': {


          'overview': 'tmpl-student-non-cspc-overview',


          'offices': 'tmpl-student-non-cspc-offices',


          'admission': 'tmpl-student-non-cspc-admission',


          'map': 'tmpl-shared-map',


        },


        'instructor': {


          'overview': 'tmpl-instructor-overview',


          'profile': 'tmpl-instructor-profile',




          'announcements': 'tmpl-instructor-announcements',




        },


        'admin': {


          'overview': 'tmpl-admin-overview',


          'users': 'tmpl-admin-users',


          'map-data': 'tmpl-admin-map-data',


          'news-editor': 'tmpl-admin-news-editor',


          'logs': 'tmpl-admin-logs',


        },


        'guest': {


          'overview': 'tmpl-guest-overview',


          'offices': 'tmpl-student-non-cspc-offices',


          'admission': 'tmpl-student-non-cspc-admission',


          'corridors': 'tmpl-guest-corridors',


          'news-events': 'tmpl-guest-news-events',


          'achievements': 'tmpl-guest-achievements',


          'map': 'tmpl-shared-map',


        }


      };

      // Notification links may point at a role-specific dashboard section.
      // Accept only the section identifier; the role map below remains the
      // authority for what can actually be rendered.
      const requestedDashboardSection = (() => {
        try {
          const params = new URLSearchParams(window.location.search || '');
          const value = params.get('section');
          return typeof value === 'string' ? value.trim() : '';
        } catch (_error) {
          return '';
        }
      })();
      let initialDashboardSectionPending = true;





      // ======= STATE =======


      let currentRole = 'student-cspc';


      let currentSection = 'overview';





      // ======= DOM REFERENCES =======


      const roleTitle = document.getElementById('roleTitle');


      const roleBadge = document.getElementById('roleBadge');


      const sidebarNav = document.getElementById('sidebarNav');


      const contentContainer = document.getElementById('contentContainer');


      const panelGreeting = document.getElementById('panelGreeting');


      const panelRoleLabel = document.getElementById('panelRoleLabel');


      const sidebarName = document.getElementById('sidebarName');


      const sidebarEmail = document.getElementById('sidebarEmail');


      const navUsername = document.getElementById('navUsername');





      // ======= ICON SVGs =======


      const icons = {


        home: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>',


        user: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',


        book: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>',


        calendar: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>',


        bell: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>',


        map: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>',


        info: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>',


        megaphone: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',


        door: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/></svg>',


        check: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>',


        users: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',


        edit: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>',


        file: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>',


        phone: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',


      };





      // ======= RENDER SIDEBAR NAV =======


      function renderSidebar(role) {


        const items = CampuSphereData.sidebarNav[role] || [];


        sidebarNav.innerHTML = items.map(item =>


          `<button class="sidebar__nav-item ${item.id === currentSection ? 'sidebar__nav-item--active' : ''}" data-section="${escapeHtml(item.id)}">


          <span class="sidebar__nav-icon">${icons[item.icon] || ''}</span>


          ${escapeHtml(item.label)}


        </button>`


        ).join('');





        // Add click handlers


        sidebarNav.querySelectorAll('.sidebar__nav-item').forEach(btn => {


          btn.addEventListener('click', () => switchSection(btn.dataset.section));


        });


      }





      // ======= RENDER CONTENT SECTION =======


      function renderContent(role, section) {


        const map = templateMap[role];


        if (!map) return;





        const templateId = map[section];


        if (!templateId) return;





        const tmplEl = document.getElementById(templateId);


        if (!tmplEl) return;





        const html = ejsRender(tmplEl.textContent, CampuSphereData);


        contentContainer.innerHTML = html;





        // Post-render hooks

        // A provider image may be valid when rendered but unavailable by the
        // time the browser fetches it. Keep the same SVG fallback used for an
        // absent/rejected image without relying on an inline event handler.
        contentContainer.querySelectorAll('[data-profile-image]').forEach((img) => {
          img.addEventListener('error', () => {
            const avatar = img.closest('[data-profile-avatar]');
            if (!avatar || img.parentElement !== avatar) return;
            img.remove();
            const fallback = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            fallback.setAttribute('width', '48');
            fallback.setAttribute('height', '48');
            fallback.setAttribute('viewBox', '0 0 24 24');
            fallback.setAttribute('fill', 'none');
            fallback.setAttribute('stroke', '#9ca3af');
            fallback.setAttribute('stroke-width', '1.5');
            fallback.setAttribute('stroke-linecap', 'round');
            fallback.setAttribute('stroke-linejoin', 'round');
            fallback.setAttribute('aria-hidden', 'true');
            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('d', 'M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2');
            const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            circle.setAttribute('cx', '12');
            circle.setAttribute('cy', '7');
            circle.setAttribute('r', '4');
            fallback.append(path, circle);
            avatar.appendChild(fallback);
          }, { once: true });
        });









        // If the template contains a Leaflet map container, initialize it


        const mapEl = document.getElementById('dashLeafletMap');


        if (mapEl) initDashLeaflet(mapEl);


      }





      // ======= (All Rooms accordion removed — out of scope) =======





      // ======= SWITCH SECTION =======


      function switchSection(sectionId) {


        currentSection = sectionId;


        renderSidebar(currentRole);


        renderContent(currentRole, currentSection);





        // Close sidebar on mobile


        document.getElementById('sidebar').classList.remove('open');


      }





      // Expose to window for profile-script.js re-render


      window.switchSection = switchSection;

      // CSP (8.5): former inline onclick handlers in role templates and other
      // dynamic dashboard content now route through one delegated listener.
      // Delegation on document handles dynamically-injected template content too.
      document.addEventListener('click', function (e) {
        var t = e.target.closest('[data-action]');
        if (!t) return;
        var action = t.getAttribute('data-action');
        if (action === 'section') {
          switchSection(t.getAttribute('data-section'));
        } else if (action === 'view-all-users') {
          e.preventDefault();
          var rs = document.getElementById('roleSelector');
          if (rs) rs.value = 'admin';
          switchSection('users');
        } else if (action === 'sim') {
          alert(t.getAttribute('data-sim'));
        }
      });


      window.switchRole = switchRole;


      Object.defineProperty(window, 'currentRole', { get() { return currentRole; }, set(v) { currentRole = v; } });


      Object.defineProperty(window, 'currentSection', { get() { return currentSection; }, set(v) { currentSection = v; } });





      // ======= SWITCH ROLE =======


      function switchRole(role) {


        currentRole = role;


        currentSection = initialDashboardSectionPending
          && templateMap[role]
          && Object.prototype.hasOwnProperty.call(templateMap[role], requestedDashboardSection)
          ? requestedDashboardSection
          : 'overview';
        initialDashboardSectionPending = false;


        const roleInfo = CampuSphereData.roles[role];





        // Update role title and badge


        roleTitle.textContent = roleInfo.label;


        roleBadge.textContent = roleInfo.sidebarBadge || roleInfo.badge;


        roleBadge.style.background = roleInfo.color;





        // Update panel header — read from CampuSphereData profiles (already merged with localStorage)


        let displayName = 'User';


        let displayFullName = 'User';


        let displayEmail = '';





        // Use server session data as the primary source
        const sessionUser = window.__SESSION_USER;

        if (sessionUser) {
          displayFullName = (sessionUser.first_name + ' ' + sessionUser.last_name).trim() || 'User';
          displayName = sessionUser.first_name || displayFullName.split(' ')[0];
          displayEmail = sessionUser.email || '';
        } else if (role === 'student-cspc' && CampuSphereData.studentProfile) {
          displayFullName = CampuSphereData.studentProfile.name || 'Student';
          displayName = displayFullName.split(' ')[0];
          displayEmail = CampuSphereData.studentProfile.email || '';
        } else if (role === 'instructor' && CampuSphereData.instructorProfile) {
          displayFullName = CampuSphereData.instructorProfile.name || 'Instructor';
          displayName = displayFullName.split(' ')[0];
          displayEmail = CampuSphereData.instructorProfile.email || '';
        } else if (role === 'admin') {
          displayName = 'Admin';
          displayFullName = 'System Administrator';
          displayEmail = 'admin@cspc.edu.ph';
        } else {
          displayName = 'Guest';
          displayFullName = 'Guest User';
          displayEmail = '';
        }





        panelGreeting.textContent = `Welcome, ${displayName} !`;


        panelRoleLabel.textContent = `${roleInfo.label} — ${roleInfo.badge}`;


        navUsername.textContent = displayName;





        // Update sidebar user


        sidebarName.textContent = displayFullName;


        sidebarEmail.textContent = displayEmail;





        renderSidebar(role);


        renderContent(role, 'overview');


      }





      // ======= DASHBOARD LEAFLET MAP =======


      function initDashLeaflet(container) {


        // M12.P1-R6: fail truthfully if the self-hosted Leaflet bundle is
        // unavailable. Without this, L.map() threw a ReferenceError and the
        // container was left as a silent blank panel that looked like an empty
        // campus map.
        if (typeof L === 'undefined') {
          if (container) {
            container.textContent = 'Live map engine is unavailable.';
            container.setAttribute('role', 'status');
          }
          return;
        }


        const map = L.map(container).setView([13.40591, 123.37362], 17);


        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {


          attribution: '&copy; OpenStreetMap contributors'


        }).addTo(map);





        fetch('/api/buildings')


          .then(res => res.ok ? res.json() : Promise.reject(new Error('HTTP ' + res.status)))


          .then(data => {


            const buildings = (data && data.success && Array.isArray(data.buildings)) ? data.buildings : [];


            buildings.forEach(b => {


              if (b.lat && b.lng) {


                L.marker([b.lat, b.lng]).addTo(map).bindTooltip(b.name);


              }


            });


          })


          .catch(err => {


            console.warn('Dashboard map: failed to load buildings', err);


          });





        // Fix Leaflet tile rendering in dynamically injected containers


        setTimeout(() => map.invalidateSize(), 200);


      }





      // ======= EVENT LISTENERS =======





      // Navbar scroll


      const dashNav = document.getElementById('dashNav');


      window.addEventListener('scroll', () => dashNav.classList.toggle('scrolled', window.scrollY > 10));





      // Mobile hamburger: owned by the shared /js/authenticated-nav.js
      // client (M12.P1-D2)





      // Sidebar mobile toggle


      const sidebarToggle = document.getElementById('sidebarToggle');


      const sidebar = document.getElementById('sidebar');


      sidebarToggle.addEventListener('click', () => sidebar.classList.toggle('open'));





      // Close sidebar on outside click (mobile)


      document.addEventListener('click', (e) => {


        if (window.innerWidth <= 900 && !sidebar.contains(e.target) && e.target !== sidebarToggle && !sidebarToggle.contains(e.target)) {


          sidebar.classList.remove('open');


        }


      });





      // ======= INIT =======


      // Use server session role first, fall back to localStorage
      const sessionRole = window.__SESSION_USER ? window.__SESSION_USER.role : null;
      const savedRole = sessionRole || localStorage.getItem('campusphere-role') || 'guest';
      switchRole(savedRole);





      // ======= THEME TOGGLE =======


      (function () {


        const toggle = document.getElementById('themeToggle');


        const saved = localStorage.getItem('campussphere-theme');


        if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');


        toggle.addEventListener('click', () => {


          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';


          if (isDark) { document.documentElement.removeAttribute('data-theme'); localStorage.setItem('campussphere-theme', 'light'); }


          else { document.documentElement.setAttribute('data-theme', 'dark'); localStorage.setItem('campussphere-theme', 'dark'); }


        });


      })();


    </script>


