<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
    <!-- Leaflet 1.9.4 CSS & JS — both self-hosted (M12.P1-R6). leaflet.css
         resolves its control/marker images from /vendor/leaflet/images/. -->
    <link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
    <script src="/vendor/leaflet/leaflet.js"></script>
    <!-- Iconify Icon 1.0.7 component — self-hosted (M12.P1-R6). The component
         still fetches icon DATA from the approved api.iconify.design origin. -->
    <script src="/vendor/iconify-icon/iconify-icon.min.js"></script>
</head>





<body>





  <!-- ===== DASHBOARD NAVBAR ===== -->
  <%- include('partials/dash-navbar') %>








    <!-- Main Dashboard Layout -->


    <div class="dashboard" id="dashboardLayout">





      <!-- ===== SIDEBAR ===== -->


      <aside class="sidebar" id="sidebar">


        <div class="sidebar__header">


          <div class="sidebar__role-title" id="roleTitle">Student (CSPC Email)</div>


          <span class="sidebar__role-badge" id="roleBadge">CSPC Verified</span>


        </div>





        <nav class="sidebar__nav" id="sidebarNav">


          <!-- Dynamically rendered by JS -->


        </nav>





        <div class="sidebar__footer">


          <div class="sidebar__user">


            <div class="sidebar__avatar"
              style="width:36px;height:36px;border-radius:50%;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;">


              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">


                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />


                <circle cx="12" cy="7" r="4" />


              </svg>


            </div>


            <div class="sidebar__user-info">


              <div class="sidebar__user-name" id="sidebarName">
                <%= user ? (user.first_name + ' ' + user.last_name) : 'Guest User' %>
              </div>


              <div class="sidebar__user-email" id="sidebarEmail">
                <%= user ? user.email : 'Not signed in' %>
              </div>


            </div>


          </div>


        </div>





      </aside>





      <!-- ===== MAIN CONTENT PANEL ===== -->


      <main class="dash-panel" id="dashPanel">


        <div class="dash-panel__header">


          <h1 class="dash-panel__greeting" id="panelGreeting">Welcome, <%= user ? (user.first_name + ' ' +
              user.last_name) : 'Guest' %>!</h1>


          <% var roleLabels={ 'student-cspc' : 'Student (CSPC) — CSPC Verified' , 'instructor' : 'Instructor — Faculty'
            , 'admin' : 'Administrator — Full Access' , 'guest' : 'Guest — View Only' }; var roleLabel=user ?
            (roleLabels[user.role] || user.role) : 'Guest' ; %>
            <p class="dash-panel__role-label" id="panelRoleLabel">
              <%= roleLabel %>
            </p>


        </div>





        <!-- ===== CONTENT CONTAINER ===== -->


        <div id="contentContainer">


          <!-- All sections rendered here by EJS-style templating engine -->


        </div>


      </main>


    </div>





    <!-- Mobile Sidebar Toggle -->


    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">


      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
        stroke-linecap="round" stroke-linejoin="round">


        <line x1="3" y1="12" x2="21" y2="12" />


        <line x1="3" y1="6" x2="21" y2="6" />


        <line x1="3" y1="18" x2="21" y2="18" />


      </svg>


    </button>





    <!-- Theme Toggle -->


    <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">


      <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">


        <circle cx="12" cy="12" r="5" />


        <line x1="12" y1="1" x2="12" y2="3" />


        <line x1="12" y1="21" x2="12" y2="23" />


        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />


        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />


        <line x1="1" y1="12" x2="3" y2="12" />


        <line x1="21" y1="12" x2="23" y2="12" />


        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />


        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />


      </svg>


      <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">


        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />


      </svg>


    </button>





    <!-- =========================================================


       EJS-STYLE TEMPLATES (rendered by client-side JS engine)


       ========================================================= -->





    <!-- OVERVIEW: Student CSPC -->


    <script type="text/ejs-template" nonce="<%= cspNonce %>" id="tmpl-student-cspc-overview">


    <div class="stat-cards">


      <div class="stat-card">


        <div class="stat-card__icon stat-card__icon--blue">📚</div>


        <div class="stat-card__label">Course</div>


        <div class="stat-card__value stat-card__value--sm"><%%= studentProfile.course %%></div>


      </div>


      <div class="stat-card">


        <div class="stat-card__icon stat-card__icon--green">📅</div>


        <div class="stat-card__label">Year Level</div>


        <div class="stat-card__value stat-card__value--sm"><%%= studentProfile.yearLevel %%></div>


      </div>


    </div>


    <div class="info-grid">


      <div class="panel-card">


        <div class="panel-card__header"><h3 class="panel-card__title">Quick Links</h3></div>


        <div class="panel-card__body">


          <div style="display:flex;flex-direction:column;gap:8px;">




            <a href="/map" class="btn btn--outline btn--sm" style="justify-content:flex-start;text-transform:none;">🗺️ Campus Map</a>


          </div>


        </div>


      </div>


      <div class="panel-card">


        <div class="panel-card__header"><h3 class="panel-card__title">Quick Actions</h3></div>


        <div class="panel-card__body">


          <div style="display:flex;flex-direction:column;gap:8px;">


            <button class="btn btn--primary btn--sm" style="justify-content:flex-start;" data-action="section" data-section="news">📰 News &amp; Announcements</button>


            <a href="/events" class="btn btn--outline btn--sm" style="justify-content:flex-start;text-transform:none;">📅 Upcoming Events</a>


            <button class="btn btn--outline btn--sm" style="justify-content:flex-start;text-transform:none;" data-action="section" data-section="profile">👤 Update Profile</button>


          </div>


        </div>


      </div>


    </div>


    <div class="panel-card">


      <div class="panel-card__header"><h3 class="panel-card__title">Latest News</h3></div>


      <div class="panel-card__body">


        <%% if (news.length === 0) { %%>


          <p style="color:var(--gray-500);font-size:0.88rem;margin:0;">No announcements at this time.</p>


        <%% } %%>


        <%% for(var i=0; i<news.length && i<2; i++) { %%>


          <div class="news-item">


            <span class="news-item__category"><%%= news[i].category %%></span>


            <div class="news-item__title"><%%= news[i].title %%></div>


            <div class="news-item__date"><%%= news[i].date %%></div>


            <p class="news-item__excerpt"><%%= news[i].excerpt %%></p>


          </div>


        <%% } %%>


      </div>


    </div>


  </script>





    <!-- PROFILE: Student CSPC -->


    <script type="text/ejs-template" nonce="<%= cspNonce %>" id="tmpl-student-cspc-profile">


    <div class="panel-card">


      <div class="panel-card__header"><h3 class="panel-card__title">Personal Information</h3></div>


      <div class="panel-card__body">


        <div style="display:flex;flex-direction:column;align-items:center;margin-bottom:1.5rem;">


          <div class="student-profile__avatar" data-profile-avatar="student" style="width:100px;height:100px;border-radius:50%;overflow:hidden;background:var(--gray-100);border:3px solid var(--navy-200);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 15px rgba(0,0,0,0.1);">


            <%% if(studentProfile.profileImage) { %%>


              <img src="<%%= studentProfile.profileImage %%>" alt="Profile Picture" referrerpolicy="no-referrer" decoding="async" data-profile-image="student" style="width:100%;height:100%;object-fit:cover;">


            <%% } else { %%>


              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>


            <%% } %%>


          </div>


          <div style="margin-top:0.75rem;font-weight:700;font-size:1.05rem;color:var(--navy-900);"><%%= studentProfile.name %%></div>


          <div style="font-size:0.82rem;color:var(--gray-500);margin-top:2px;"><%%= studentProfile.email %%></div>


        </div>


        <div class="profile-info">


          <div class="profile-info__item"><span class="profile-info__label">Full Name</span><span class="profile-info__value"><%%= studentProfile.name %%></span></div>


          <div class="profile-info__item"><span class="profile-info__label">Student ID</span><span class="profile-info__value"><%%= studentProfile.studentId %%></span></div>


          <div class="profile-info__item"><span class="profile-info__label">Email</span><span class="profile-info__value"><%%= studentProfile.email %%></span></div>


          <div class="profile-info__item"><span class="profile-info__label">Course</span><span class="profile-info__value"><%%= studentProfile.course %%></span></div>


          <div class="profile-info__item"><span class="profile-info__label">Year Level</span><span class="profile-info__value"><%%= studentProfile.yearLevel %%></span></div>


        </div>


      </div>


    </div>


  </script>







    <!-- NEWS (shared) -->


    <script type="text/ejs-template" nonce="<%= cspNonce %>" id="tmpl-shared-news">


    <div class="panel-card">


      <div class="panel-card__header"><h3 class="panel-card__title">News & Announcements</h3></div>


      <div class="panel-card__body">


        <%% if (news.length === 0) { %%>


          <p style="color:var(--gray-500);font-size:0.88rem;margin:0;">No announcements at this time.</p>


        <%% } %%>


        <%% for(var i=0; i<news.length; i++) { %%>


          <div class="news-item">


            <span class="news-item__category"><%%= news[i].category %%></span>


            <div class="news-item__title"><%%= news[i].title %%></div>


            <div class="news-item__date"><%%= news[i].date %%></div>


            <p class="news-item__excerpt"><%%= news[i].excerpt %%></p>


          </div>


        <%% } %%>


      </div>


    </div>


  </script>





    <!-- MAP (shared) -->


    <script type="text/ejs-template" nonce="<%= cspNonce %>" id="tmpl-shared-map">


    <div class="panel-card">


      <div class="panel-card__header"><h3 class="panel-card__title">Campus Map — CSPC Nabua</h3><a href="/map" class="btn btn--primary btn--sm">Open Full Map</a></div>


      <div class="panel-card__body">


        <div id="dashLeafletMap" style="width:100%;height:350px;border-radius:12px;"></div>


      </div>


    </div>


  </script>





    <!-- OVERVIEW: Student Non-CSPC -->


    <script type="text/ejs-template" nonce="<%= cspNonce %>" id="tmpl-student-non-cspc-overview">


    <div class="stat-cards">


      <div class="stat-card"><div class="stat-card__icon stat-card__icon--blue">🏛️</div><div class="stat-card__label">Campus Offices</div><div class="stat-card__value stat-card__value--sm"><%%= campusOffices.length %%></div></div>


      <div class="stat-card"><div class="stat-card__icon stat-card__icon--green">📋</div><div class="stat-card__label">Admission</div><div class="stat-card__value stat-card__value--sm">Open</div></div>


      <div class="stat-card"><div class="stat-card__icon stat-card__icon--gold">🗺️</div><div class="stat-card__label">Campus Map</div><div class="stat-card__value stat-card__value--sm">Available</div></div>


    </div>


    <div class="panel-card" style="margin-bottom:var(--space-xl);">


      <div class="panel-card__header"><h3 class="panel-card__title">Welcome, Future Cavalier!</h3></div>


      <div class="panel-card__body"><p style="color:var(--gray-600);font-size:0.9rem;line-height:1.7;">Welcome to CampuSphere! As a prospective student, you can explore important campus offices, learn about the admission process, and navigate the campus map. For full features, enroll and sign in with your <strong>@cspc.edu.ph</strong> email.</p></div>


    </div>


  </script>





    <!-- OFFICES: Student Non-CSPC -->


    <script type="text/ejs-template" nonce="<%= cspNonce %>" id="tmpl-student-non-cspc-offices">


    <div class="panel-card">


      <div class="panel-card__header"><h3 class="panel-card__title">Important Campus Offices & Entry Points</h3></div>


      <div class="panel-card__body">


        <%% for(var i=0; i<campusOffices.length; i++) { %%>


          <div class="news-item">


            <div class="news-item__title"><%%= campusOffices[i].name %%></div>


            <div class="news-item__date">📍 <%%= campusOffices[i].location %%></div>


            <p class="news-item__excerpt"><%%= campusOffices[i].description %%></p>


            <%% if(campusOffices[i].hours) { %%><p style="font-size:0.8rem;color:var(--green-accent);font-weight:600;margin-top:4px;">🕐 <%%= campusOffices[i].hours %%></p><%% } %%>


          </div>


        <%% } %%>


      </div>


    </div>


  </script>





    <!-- ADMISSION: Student Non-CSPC -->


    <script type="text/ejs-template" nonce="<%= cspNonce %>" id="tmpl-student-non-cspc-admission">


    <div class="info-grid">


      <div class="panel-card">


        <div class="panel-card__header"><h3 class="panel-card__title">Admission Requirements</h3></div>


        <div class="panel-card__body">


          <div style="display:flex;flex-direction:column;gap:8px;">


            <%% for(var i=0; i<admissionInfo.requirements.length; i++) { %%>


              <div style="display:flex;align-items:center;gap:8px;font-size:0.88rem;color:var(--gray-700);">


                <span style="color:var(--navy-600);font-weight:700;">✔</span> <%%= admissionInfo.requirements[i] %%>


              </div>


            <%% } %%>


          </div>


        </div>


      </div>


      <div class="panel-card">


        <div class="panel-card__header"><h3 class="panel-card__title">How to Apply</h3></div>


        <div class="panel-card__body">


          <div style="display:flex;flex-direction:column;gap:10px;">


            <%% for(var i=0; i<admissionInfo.steps.length; i++) { %%>


              <p style="font-size:0.88rem;color:var(--gray-700);margin:0;"><%%= admissionInfo.steps[i] %%></p>


            <%% } %%>


          </div>


          <div style="margin-top:var(--space-lg);padding:var(--space-md);background:rgba(30,77,140,0.06);border-radius:var(--radius-md);">


            <p style="font-size:0.85rem;color:var(--navy-700);font-weight:600;margin:0 0 4px;">📅 Deadline: <%%= admissionInfo.deadline %%></p>


            <p style="font-size:0.82rem;color:var(--gray-600);margin:0;">📧 Contact: <%%= admissionInfo.contactEmail %%></p>


          </div>


        </div>


      </div>


    </div>


  </script>





    <!-- OVERVIEW: Instructor -->


    <script type="text/ejs-template" nonce="<%= cspNonce %>" id="tmpl-instructor-overview">


    <div class="instructor-status-summary" role="status" aria-label="Instructor account status">
      <span class="instructor-status-summary__label">Account status</span>
      <span class="status-badge status-badge--active"><%%= instructorProfile.status %%></span>
    </div>


    <div class="info-grid">


      <div class="panel-card">


        <div class="panel-card__header"><h3 class="panel-card__title">Quick Links</h3></div>


        <div class="panel-card__body">


          <div style="display:flex;flex-direction:column;gap:8px;">




            <a href="/map" class="btn btn--outline btn--sm" style="justify-content:flex-start;text-transform:none;">🗺️ Campus Map</a>


          </div>


        </div>


      </div>


      <div class="panel-card">


        <div class="panel-card__header"><h3 class="panel-card__title">Quick Actions</h3></div>


        <div class="panel-card__body">


          <div style="display:flex;flex-direction:column;gap:8px;">


            <button class="btn btn--primary btn--sm" style="justify-content:flex-start;" data-action="section" data-section="announcements">📰 News &amp; Announcements</button>


            <a href="/events" class="btn btn--outline btn--sm" style="justify-content:flex-start;text-transform:none;">📅 Upcoming Events</a>


            <button class="btn btn--outline btn--sm" style="justify-content:flex-start;text-transform:none;" data-action="section" data-section="profile">👤 Update Profile</button>


          </div>


        </div>


      </div>


    </div>


    <div class="panel-card">


      <div class="panel-card__header"><h3 class="panel-card__title">Latest Announcements</h3></div>


      <div class="panel-card__body">


        <%% if (news.length === 0) { %%>


          <p style="color:var(--gray-500);font-size:0.88rem;margin:0;">No announcements at this time.</p>


        <%% } %%>


        <%% for(var i=0; i<news.length && i<2; i++) { %%>


          <div class="news-item">


            <span class="news-item__category"><%%= news[i].category %%></span>


            <div class="news-item__title"><%%= news[i].title %%></div>


            <div class="news-item__date"><%%= news[i].date %%></div>


            <p class="news-item__excerpt"><%%= news[i].excerpt %%></p>


          </div>


        <%% } %%>


      </div>


    </div>


  </script>





    <!-- PROFILE: Instructor -->


    <script type="text/ejs-template" nonce="<%= cspNonce %>" id="tmpl-instructor-profile">


    <div class="panel-card">


      <div class="panel-card__header"><h3 class="panel-card__title">Instructor Profile</h3></div>


      <div class="panel-card__body">


        <div style="display:flex;flex-direction:column;align-items:center;margin-bottom:1.5rem;">


          <div style="width:100px;height:100px;border-radius:50%;overflow:hidden;background:var(--gray-100);border:3px solid var(--navy-200);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 15px rgba(0,0,0,0.1);">


            <%% if(instructorProfile.profileImage) { %%>


              <img src="<%%= instructorProfile.profileImage %%>" alt="Profile Picture" style="width:100%;height:100%;object-fit:cover;">


            <%% } else { %%>


              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>


            <%% } %%>


          </div>


          <div style="margin-top:0.75rem;font-weight:700;font-size:1.05rem;color:var(--navy-900);"><%%= instructorProfile.name %%></div>


          <div style="font-size:0.82rem;color:var(--gray-500);margin-top:2px;"><%%= instructorProfile.email %%></div>


        </div>


        <div class="profile-info">


          <div class="profile-info__item"><span class="profile-info__label">Full Name</span><span class="profile-info__value"><%%= instructorProfile.name %%></span></div>


          <div class="profile-info__item"><span class="profile-info__label">Email</span><span class="profile-info__value"><%%= instructorProfile.email %%></span></div>


          <div class="profile-info__item"><span class="profile-info__label">Status</span><span class="profile-info__value"><span class="status-badge status-badge--active"><%%= instructorProfile.status %%></span></span></div>


        </div>


      </div>


    </div>


  </script>





    <!-- ANNOUNCEMENTS: Instructor -->


    <script type="text/ejs-template" nonce="<%= cspNonce %>" id="tmpl-instructor-announcements">


    <div class="panel-card" style="margin-bottom:var(--space-xl);">


      <div class="panel-card__header"><h3 class="panel-card__title">News &amp; Announcements</h3></div>


      <div class="panel-card__body">


        <%% if (news.length === 0) { %%>


          <p style="color:var(--gray-500);font-size:0.88rem;margin:0;">No announcements at this time.</p>


        <%% } %%>


        <%% for(var i=0; i<news.length; i++) { %%>


          <div class="news-item">


            <span class="news-item__category"><%%= news[i].category %%></span>


            <div class="news-item__title"><%%= news[i].title %%></div>


            <div class="news-item__date"><%%= news[i].date %%></div>


            <p class="news-item__excerpt"><%%= news[i].excerpt %%></p>


          </div>


        <%% } %%>


      </div>


    </div>


  </script>


























    <!-- OVERVIEW: Admin -->


    <script type="text/ejs-template" nonce="<%= cspNonce %>" id="tmpl-admin-overview">


    <div class="stat-cards">


      <div class="stat-card"><div class="stat-card__icon stat-card__icon--blue">👥</div><div class="stat-card__label">Total Users</div><div class="stat-card__value"><%%= adminUsers.length %%></div></div>


      <div class="stat-card"><div class="stat-card__icon stat-card__icon--green">📰</div><div class="stat-card__label">Published News</div><div class="stat-card__value"><%%= news.length %%></div></div>


      <div class="stat-card"><div class="stat-card__icon stat-card__icon--gold">🗺️</div><div class="stat-card__label">Map Locations</div><div class="stat-card__value">20+</div></div>


      <div class="stat-card"><div class="stat-card__icon stat-card__icon--red">📋</div><div class="stat-card__label">System Logs</div><div class="stat-card__value"><%%= logs.length %%></div></div>


    </div>


    <div class="info-grid">


      <div class="panel-card">


        <div class="panel-card__header"><h3 class="panel-card__title">Recent Users</h3><a href="#" class="btn btn--primary btn--sm" data-action="view-all-users" href="#">View All</a></div>


        <div class="panel-card__body">


          <table class="data-table"><thead><tr><th>Name</th><th>Role</th><th>Status</th></tr></thead><tbody>


          <%% for(var i=0; i<adminUsers.length && i<3; i++) { %%>


            <tr><td><%%= adminUsers[i].name %%></td><td><%%= adminUsers[i].role %%></td><td><span class="status-badge status-badge--active"><%%= adminUsers[i].status %%></span></td></tr>


          <%% } %%>


          </tbody></table>


        </div>


      </div>


      <div class="panel-card">


        <div class="panel-card__header"><h3 class="panel-card__title">Recent Logs</h3></div>


        <div class="panel-card__body">


          <table class="data-table"><thead><tr><th>Time</th><th>Action</th></tr></thead><tbody>


          <%% for(var i=0; i<logs.length && i<3; i++) { %%>


            <tr><td><%%= logs[i].time %%></td><td><%%= logs[i].action %%></td></tr>


          <%% } %%>


          </tbody></table>


        </div>


      </div>


    </div>


  </script>





    <!-- USERS: Admin -->


