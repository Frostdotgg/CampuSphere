<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <!-- The home preview uses the same self-hosted MapLibre + PMTiles
             renderer and content-addressed campus archive as /map and the
             downloaded offline guide. No public tile server is required. -->
        <link rel="stylesheet" href="/vendor/maplibre/maplibre-gl.css" />
        <script src="/vendor/maplibre/maplibre-gl.js"></script>
        <script src="/vendor/pmtiles/pmtiles.js"></script>
        <!-- Iconify Icon 1.0.7 component — self-hosted (M12.P1-R6). The component
             still fetches icon DATA from the approved api.iconify.design origin. -->
        <script src="/vendor/iconify-icon/iconify-icon.min.js"></script>
</head>

<body>

    <!-- ===== DASHBOARD NAVBAR ===== -->
    <%- include('partials/dash-navbar') %>

        <!-- ===== HERO BANNER ===== -->
        <section class="dash-hero" id="dashHero">
            <div class="dash-hero__bg">
                <img src="/img/campus-hero.jpg" alt="CSPC Campus">
                <div class="dash-hero__overlay"></div>
            </div>
            <div class="dash-hero__content">
                <h1 class="dash-hero__title">Welcome to CampuSphere</h1>
                <p class="dash-hero__subtitle">Explore the campus easily using the interactive map.</p>
                <div class="dash-hero__actions">
                    <a href="/map" class="btn btn--primary btn--hero">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" />
                            <line x1="8" y1="2" x2="8" y2="18" />
                            <line x1="16" y1="6" x2="16" y2="22" />
                        </svg>
                        Open Campus Map
                    </a>
                    <a href="/buildings" class="btn btn--white btn--hero">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="4" y="2" width="16" height="20" rx="2" ry="2" />
                            <path d="M9 22v-4h6v4" />
                            <path d="M8 6h.01" />
                            <path d="M16 6h.01" />
                            <path d="M12 6h.01" />
                            <path d="M12 10h.01" />
                        </svg>
                        View Buildings
                    </a>
                </div>
            </div>
        </section>

        <!-- ===== MAIN CONTENT ===== -->
        <main class="dash-main">
            <div class="dash-main__inner">
                <!-- LEFT COLUMN -->
                <div class="dash-main__left">
                    <!-- Quick Access Cards -->
                    <div class="dash-quick" id="quickAccess">
                        <a href="/map" class="dash-quick__card">
                            <div class="dash-quick__card-icon dash-quick__card-icon--map">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                    <circle cx="12" cy="10" r="3" />
                                </svg>
                            </div>
                            <div class="dash-quick__card-info">
                                <strong>Campus Map</strong>
                                <small>Navigate Campus Location</small>
                            </div>
                        </a>
                        <a href="/buildings" class="dash-quick__card">
                            <div class="dash-quick__card-icon dash-quick__card-icon--building">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="4" y="2" width="16" height="20" rx="2" ry="2" />
                                    <path d="M9 22v-4h6v4" />
                                    <path d="M8 6h.01" />
                                    <path d="M16 6h.01" />
                                    <path d="M12 6h.01" />
                                    <path d="M12 10h.01" />
                                </svg>
                            </div>
                            <div class="dash-quick__card-info">
                                <strong>Buildings</strong>
                                <small>View all campus facilities</small>
                            </div>
                        </a>
                        <a href="/events" class="dash-quick__card">
                            <div class="dash-quick__card-icon dash-quick__card-icon--event">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                                    <line x1="16" y1="2" x2="16" y2="6" />
                                    <line x1="8" y1="2" x2="8" y2="6" />
                                    <line x1="3" y1="10" x2="21" y2="10" />
                                </svg>
                            </div>
                            <div class="dash-quick__card-info">
                                <strong>Events</strong>
                                <small>Check out upcoming events</small>
                            </div>
                        </a>
                    </div>

                    <!-- Campus Map Preview -->
                    <div class="dash-map-preview" id="mapPreview">
                        <div class="dash-map-preview__header">
                            <h3 class="dash-map-preview__title">Campus Map</h3>
                            <a href="/map" class="btn btn--primary btn--sm">Open Full Map</a>
                        </div>
                        <div class="dash-map-preview__container">
                            <div id="homeMap" class="dash-map-preview__map" role="region"
                                aria-label="Campus map preview" aria-busy="true"></div>
                            <p id="homeMapStatus" class="dash-map-preview__status" role="status" hidden></p>
                        </div>
                    </div>
                </div>

                <!-- RIGHT COLUMN (Sidebar) -->
                <%
                    const homeFeaturedLocations = typeof featuredLocations !== 'undefined' && Array.isArray(featuredLocations)
                        ? featuredLocations : [];
                    const homeFeaturedLocationsState = typeof featuredLocationsState !== 'undefined'
                        ? featuredLocationsState : (homeFeaturedLocations.length ? 'ready' : 'empty');
                    const homeLatestEvents = typeof latestEvents !== 'undefined' && Array.isArray(latestEvents)
                        ? latestEvents : [];
                    const homeLatestEventsState = typeof latestEventsState !== 'undefined'
                        ? latestEventsState : (homeLatestEvents.length ? 'ready' : 'empty');
                %>
                <div class="dash-main__right">
                    <!-- Featured Locations -->
                    <div class="dash-sidebar-card" id="featuredLocations">
                        <div class="dash-sidebar-card__header">
                            <h3 class="dash-sidebar-card__title">Featured Locations</h3>
                            <a href="/buildings" class="dash-sidebar-card__link">View All</a>
                        </div>
                        <div class="dash-sidebar-card__body">
                            <% if (homeFeaturedLocationsState === 'unavailable') { %>
                                <p class="home-sidebar-state" role="status">Featured locations are temporarily unavailable.</p>
                            <% } else if (homeFeaturedLocations.length === 0) { %>
                                <p class="home-sidebar-state" role="status">No featured locations are available yet.</p>
                            <% } else { %>
                                <% homeFeaturedLocations.forEach((location) => { %>
                                    <div class="location-item">
                                        <div class="location-item__img">
                                            <img src="<%= location.img %>" alt="<%= location.name %>">
                                        </div>
                                        <div class="location-item__info">
                                            <strong class="location-item__name"><%= location.name %></strong>
                                            <small class="text-xs text-muted-foreground"
                                                style="display:block; margin-bottom:6px;"><%= location.category %></small>
                                            <div class="location-item__actions">
                                                <a href="/map" class="btn--tag btn--tag-primary">View on Map</a>
                                                <a href="/buildings" class="btn--tag btn--tag-outline">Details</a>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } %>
                        </div>
                    </div>

                    <!-- Latest Events -->
                    <div class="dash-sidebar-card" id="upcomingEvents">
                        <div class="dash-sidebar-card__header">
                            <h3 class="dash-sidebar-card__title">Latest Events</h3>
                            <a href="/events" class="dash-sidebar-card__link">View All</a>
                        </div>
                        <div class="dash-sidebar-card__body">
                            <% if (homeLatestEventsState === 'unavailable') { %>
                                <p class="home-sidebar-state" role="status">Latest events are temporarily unavailable.</p>
                            <% } else if (homeLatestEvents.length === 0) { %>
                                <p class="home-sidebar-state" role="status">No events are available yet.</p>
                            <% } else { %>
                                <% homeLatestEvents.forEach((event) => { %>
                                    <div class="event-item">
                                        <div class="event-item__date">
                                            <time datetime="<%= event.date %>" aria-label="<%= event.dateLabel %>">
                                                <span class="event-item__day"><%= event.day %></span>
                                                <span class="event-item__month"><%= event.monthLabel %> <%= event.year %></span>
                                            </time>
                                        </div>
                                        <div class="event-item__info">
                                            <strong class="event-item__name"><%= event.title %></strong>
                                            <small class="event-item__time"><%= event.time %></small>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- ===== FOOTER ===== -->
        <%- include('partials/dash-footer') %>

            <!-- ===== SCRIPTS ===== -->
            <script nonce="<%= cspNonce %>">
                // ---- Dashboard Navbar scroll ----
                const dashNav = document.getElementById('dashNav');
                window.addEventListener('scroll', () => {
                    dashNav.classList.toggle('scrolled', window.scrollY > 10);
                });

                // ---- Mobile hamburger: owned by the shared
                // /js/authenticated-nav.js client (M12.P1-D2) ----

            </script>

            <%- include('partials/theme-toggle') %>

                <!-- Edit Profile Script -->
                <script src="/js/profile-script.js"></script>
                <script src="/js/nav-role.js"></script>
                <script id="homeMapConfig" type="application/json" nonce="<%= cspNonce %>"><%- safeJson({
                    basemap: (typeof mapBasemap !== 'undefined' ? mapBasemap : null),
                    startNode: (typeof mapStartNode !== 'undefined' ? mapStartNode : null)
                }) %></script>
                <script nonce="<%= cspNonce %>">
                    // The home preview intentionally shares the public MapLibre
                    // basemap contract with /map. Building data remains a
                    // session-bound API read; no personalized data is embedded
                    // in the HTML or cached by the service worker.
                    document.addEventListener('DOMContentLoaded', () => {
                        const mapHost = document.getElementById('homeMap');
                        const status = document.getElementById('homeMapStatus');
                        const configNode = document.getElementById('homeMapConfig');
                        let config = {};
                        try { config = JSON.parse(configNode ? configNode.textContent : '{}') || {}; } catch (e) { config = {}; }

                        const showUnavailable = (message) => {
                            if (mapHost) {
                                mapHost.replaceChildren();
                                mapHost.setAttribute('aria-busy', 'false');
                                mapHost.setAttribute('aria-label', 'Campus map preview unavailable');
                            }
                            if (status) {
                                status.textContent = message || 'Live map engine is unavailable.';
                                status.hidden = false;
                            }
                        };

                        if (!mapHost || typeof maplibregl === 'undefined' || typeof pmtiles === 'undefined') {
                            showUnavailable('Live map engine is unavailable.');
                            return;
                        }

                        const basemap = config.basemap && typeof config.basemap === 'object' ? config.basemap : null;
                        const asset = basemap && typeof basemap.asset === 'string' ? basemap.asset : '';
                        if (!/^\/maps\/cspc-campus-[a-f0-9]{64}\.pmtiles$/i.test(asset)) {
                            showUnavailable('Campus basemap is temporarily unavailable.');
                            return;
                        }

                        const style = {
                            version: 8,
                            sources: {
                                campus: {
                                    type: 'vector',
                                    url: 'pmtiles://' + asset,
                                    attribution: (typeof basemap.attribution === 'string' && basemap.attribution.trim())
                                        ? basemap.attribution : 'Protomaps © OpenStreetMap contributors'
                                }
                            },
                            layers: [
                                { id: 'background', type: 'background', paint: { 'background-color': '#edf1e8' } },
                                { id: 'earth', type: 'fill', source: 'campus', 'source-layer': 'earth', paint: { 'fill-color': '#f5f2e8' } },
                                { id: 'landuse', type: 'fill', source: 'campus', 'source-layer': 'landuse', paint: { 'fill-color': '#dfead9', 'fill-opacity': 0.7 } },
                                { id: 'water', type: 'fill', source: 'campus', 'source-layer': 'water', paint: { 'fill-color': '#b8dbe8' } },
                                { id: 'roads-casing', type: 'line', source: 'campus', 'source-layer': 'roads', paint: { 'line-color': '#c4c1b8', 'line-width': ['interpolate', ['linear'], ['zoom'], 13, 2, 18, 8] } },
                                { id: 'roads', type: 'line', source: 'campus', 'source-layer': 'roads', paint: { 'line-color': '#ffffff', 'line-width': ['interpolate', ['linear'], ['zoom'], 13, 1, 18, 5] } },
                                { id: 'buildings', type: 'fill', source: 'campus', 'source-layer': 'buildings', paint: { 'fill-color': '#c9c5b8', 'fill-outline-color': '#9d998f', 'fill-opacity': 0.88 } }
                            ]
                        };

                        let map;
                        try {
                            const archive = new pmtiles.PMTiles(new pmtiles.FetchSource(asset));
                            const protocol = new pmtiles.Protocol();
                            protocol.add(archive);
                            maplibregl.addProtocol('pmtiles', protocol.tile);
                            map = new maplibregl.Map({
                                container: mapHost,
                                style,
                                center: Array.isArray(basemap.center) ? basemap.center : [123.375604, 13.405885],
                                zoom: 16.5,
                                minZoom: 12,
                                maxZoom: 19,
                                maxBounds: Array.isArray(basemap.bounds) && basemap.bounds.length === 4
                                    ? [[basemap.bounds[0], basemap.bounds[1]], [basemap.bounds[2], basemap.bounds[3]]]
                                    : undefined
                            });
                            map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-left');
                        } catch (e) {
                            showUnavailable('Campus basemap is temporarily unavailable.');
                            return;
                        }

                        let sourceLoaded = false;
                        let tileErrors = 0;
                        map.on('sourcedata', (event) => {
                            if (event && event.sourceId === 'campus' && event.isSourceLoaded) sourceLoaded = true;
                        });
                        map.on('error', (event) => {
                            if (sourceLoaded || !event || !event.error) return;
                            tileErrors += 1;
                            if (tileErrors >= 2) showUnavailable('Campus basemap is temporarily unavailable.');
                        });
                        window.setTimeout(() => {
                            if (!sourceLoaded && mapHost.getAttribute('aria-busy') === 'true') {
                                showUnavailable('Campus basemap is temporarily unavailable.');
                            }
                        }, 6000);

                        const validPoint = (value) => {
                            const lat = Number(value && value.lat);
                            const lng = Number(value && value.lng);
                            return Number.isFinite(lat) && Number.isFinite(lng) && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180;
                        };
                        const addStartMarker = () => {
                            const node = config.startNode;
                            if (!validPoint(node)) return;
                            const element = document.createElement('div');
                            element.className = 'map-start-marker home-map-start-marker';
                            element.setAttribute('aria-label', 'Start: Guard House / Main Gate');
                            const label = document.createElement('span');
                            label.className = 'campus-map-label map-start-label';
                            label.textContent = 'Start · Guard House';
                            element.appendChild(label);
                            new maplibregl.Marker({ element, anchor: 'center' })
                                .setLngLat([Number(node.lng), Number(node.lat)])
                                .addTo(map);
                        };
                        const addBuildingMarkers = (buildings) => {
                            buildings.forEach((building) => {
                                if (!validPoint(building)) return;
                                const marker = new maplibregl.Marker({ scale: 0.7, offset: [0, -9.8] })
                                    .setLngLat([Number(building.lng), Number(building.lat)])
                                    .addTo(map);
                                const element = marker.getElement();
                                element.classList.add('map-building-marker', 'map-building-marker--maplibre');
                                element.setAttribute('role', 'button');
                                element.setAttribute('tabindex', '0');
                                element.setAttribute('aria-label', String(building.name || 'Campus building'));
                                element.title = String(building.name || 'Campus building');
                                const openPopup = () => {
                                    const content = document.createElement('div');
                                    content.className = 'home-map-popup';
                                    const name = document.createElement('strong');
                                    name.textContent = String(building.name || 'Campus building');
                                    const category = document.createElement('span');
                                    category.textContent = String(building.category || 'Campus location');
                                    content.append(name, category);
                                    new maplibregl.Popup({ closeButton: true, closeOnClick: true, offset: 14 })
                                        .setLngLat([Number(building.lng), Number(building.lat)])
                                        .setDOMContent(content)
                                        .addTo(map);
                                };
                                element.addEventListener('click', (event) => {
                                    // MapLibre's map-level closeOnClick handler
                                    // would otherwise close the popup immediately
                                    // after the marker opens it.
                                    event.stopPropagation();
                                    openPopup();
                                });
                                element.addEventListener('keydown', (event) => {
                                    if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openPopup(); }
                                });
                            });
                        };

                        map.once('load', () => {
                            sourceLoaded = true;
                            mapHost.setAttribute('aria-busy', 'false');
                            addStartMarker();
                            if (!window.__SESSION_USER) return;
                            fetch('/api/buildings', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
                                .then((response) => response.ok ? response.json() : Promise.reject(new Error('HTTP ' + response.status)))
                                .then((data) => {
                                    const buildings = data && data.success && Array.isArray(data.buildings) ? data.buildings : [];
                                    addBuildingMarkers(buildings);
                                })
                                .catch(() => {
                                    if (status) {
                                        status.textContent = 'Building markers are temporarily unavailable.';
                                        status.hidden = false;
                                    }
                                });
                        });
                        window.addEventListener('resize', () => { if (map) map.resize(); });
                    });
                </script>
</body>

</html>
