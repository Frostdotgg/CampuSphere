<!DOCTYPE html>
<html lang="en">

<head>
    <script nonce="<%= cspNonce %>">
        (function () {
            var savedTheme = localStorage.getItem('adminTheme') || localStorage.getItem('theme');
            if (savedTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampuSphere Admin - System Logs</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-styles.css">
    <%# M12.P1-R6: Lucide is self-hosted at the exact reviewed 1.25.0 (see
        public/vendor/manifest.json). The former unpkg "lucide@latest" reference
        executed whatever build the CDN served at request time. %>
    <script src="/vendor/lucide/lucide.min.js"></script>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <script src="/js/user-presence.js" defer></script>
    <script src="/js/admin/main.js" defer></script>
    <script src="/js/admin/admin-logs.js" defer></script>
    <style nonce="<%= cspNonce %>">
        /* Shared toast pattern (same classes as the other admin pages) */
        .admin-toast{position:fixed;bottom:1.5rem;right:1.5rem;z-index:2000;padding:0.75rem 1.25rem;border-radius:0.5rem;font-size:0.875rem;font-weight:500;color:#fff;transform:translateY(120%);opacity:0;transition:all 0.3s ease;pointer-events:none;}
        .admin-toast--success{background:hsl(142 71% 45%);}
        .admin-toast--error{background:var(--destructive);}
        .admin-toast--show{transform:translateY(0);opacity:1;pointer-events:auto;}
        @keyframes spin{to{transform:rotate(360deg);}}
        .animate-spin{animation:spin 1s linear infinite;}
    </style>
</head>

<body class="admin-surface font-sans antialiased">
    <div class="admin-shell flex h-screen bg-background text-foreground overflow-hidden">
        <aside id="sidebar"
            class="relative flex h-screen flex-col bg-sidebar text-sidebar-foreground border-r border-sidebar-border transition-all duration-300 w-64 shrink-0">
            <div class="flex items-center gap-3 px-4 py-5 border-b border-sidebar-border h-16">
                <img src="/img/cspc-logo.png" alt="CSPC Logo" class="sidebar-logo shrink-0">
                <div id="sidebar-header-full" class="flex flex-col"><span
                        class="sidebar-brand-title">Campu<span>Sphere</span></span><span class="sidebar-brand-sub">Admin
                        Portal</span></div>
            </div>
            <nav class="flex-1 px-2 py-4 overflow-y-auto" style="display:flex;flex-direction:column;gap:2px;">
                <a href="/admin"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="layout-dashboard" class="h-5 w-5 shrink-0"></i><span
                        class="sidebar-text">Dashboard</span></a>
                <a href="/admin/users"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="users" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">Users</span></a>
                <a href="/admin/news"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="newspaper" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">News</span></a>
                <a href="/admin/faqs"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="help-circle" class="h-5 w-5 shrink-0"></i><span
                        class="sidebar-text">FAQs</span></a>
                <a href="/admin/logs"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors bg-sidebar-accent text-sidebar-accent-foreground mt-1"><i
                        data-lucide="file-text" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">System
                        Logs</span></a>
                <a href="/admin/campus-map"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="map" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">Campus Map</span></a>
                <a href="/admin/vr"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="globe" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">VR Tour</span></a>
                <a href="/admin/settings"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="settings" class="h-5 w-5 shrink-0"></i><span
                        class="sidebar-text">Settings</span></a>
            </nav>
            <div class="border-t border-sidebar-border p-4">
                <div class="flex items-center gap-3">
                    <div class="ui-avatar h-9 w-9 shrink-0">
                        <div class="ui-avatar-fallback text-xs font-semibold"><%= user ? (user.first_name || '')[0].toUpperCase() + (user.last_name || '')[0].toUpperCase() : 'AD' %></div>
                    </div>
                    <div id="sidebar-user-full" class="flex flex-col flex-1 min-w-0">
                        <span class="text-sm font-medium truncate"><%= user ? user.first_name + ' ' + user.last_name : 'Admin User' %></span>
                        <span class="text-xs text-sidebar-foreground/60 truncate"><%= user ? user.email : 'admin@cspc.edu.ph' %></span>
                    </div>
                    <form method="POST" action="/logout" class="logout-form" style="display:contents;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="ui-button ui-button-ghost ui-button-size-icon h-8 w-8 text-sidebar-foreground/70 shrink-0" title="Logout" style="cursor:pointer;"><i data-lucide="log-out" class="h-4 w-4"></i></button>
                    </form>
                </div>
            </div>
            <button id="sidebar-toggle"
                class="ui-button ui-button-ghost ui-button-size-icon absolute -right-3 top-7 h-6 w-6 rounded-full border border-sidebar-border bg-sidebar text-sidebar-foreground hover:bg-sidebar-accent"
                style="width:1.5rem;height:1.5rem;padding:0;"><i id="sidebar-icon-left" data-lucide="chevron-left"
                    class="h-3 w-3"></i><i id="sidebar-icon-right" data-lucide="chevron-right"
                    class="h-3 w-3 hidden"></i></button>
        </aside>

        <div class="flex flex-1 flex-col overflow-hidden">
            <header class="admin-page-header flex h-16 items-center justify-between border-b border-border bg-card px-6 shrink-0">
                <div>
                    <h1 class="text-xl font-semibold text-foreground">System Logs</h1>
                    <p class="text-sm text-muted-foreground">Read-only application audit trail</p>
                </div>
            </header>

            <main class="admin-workspace flex-1 overflow-y-auto p-6" style="padding-bottom:2rem;">
                <div class="mx-auto max-w-7xl" style="display:flex;flex-direction:column;gap:1.5rem;">

                    <!-- Summary cards: truthful, unfiltered totals for the active backend -->
                    <div class="grid gap-4 logs-stats-grid">
                        <div class="ui-card border-border">
                            <div class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="rounded-lg bg-chart-2/10 p-2.5"><i data-lucide="list" class="h-5 w-5 text-chart-2"></i></div>
                                    <div>
                                        <p class="text-sm text-muted-foreground">Total</p>
                                        <p class="text-2xl font-bold text-foreground" id="logs-stat-total">—</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="ui-card border-border">
                            <div class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="rounded-lg bg-chart-1/10 p-2.5"><i data-lucide="check-circle" class="h-5 w-5 text-chart-1"></i></div>
                                    <div>
                                        <p class="text-sm text-muted-foreground">Success</p>
                                        <p class="text-2xl font-bold text-foreground" id="logs-stat-success">—</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="ui-card border-border">
                            <div class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="rounded-lg bg-chart-4/10 p-2.5"><i data-lucide="alert-triangle" class="h-5 w-5 text-chart-4"></i></div>
                                    <div>
                                        <p class="text-sm text-muted-foreground">Failure</p>
                                        <p class="text-2xl font-bold text-foreground" id="logs-stat-failure">—</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="ui-card border-border">
                            <div class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="rounded-lg bg-destructive/10 p-2.5"><i data-lucide="shield-alert" class="h-5 w-5 text-destructive"></i></div>
                                    <div>
                                        <p class="text-sm text-muted-foreground">Denied</p>
                                        <p class="text-2xl font-bold text-foreground" id="logs-stat-denied">—</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Filters -->
                    <div class="ui-card border-border">
                        <div class="p-4">
                            <form id="logs-filters" class="logs-filters" novalidate autocomplete="off">
                                <div class="logs-filter-field logs-filter-search">
                                    <label for="logs-search-input">Search message</label>
                                    <input id="logs-search-input" name="text" type="search" class="ui-input" maxlength="200"
                                        placeholder="Search log messages…" aria-describedby="logs-search-hint">
                                </div>
                                <div class="logs-filter-field">
                                    <label for="logs-event-type">Event type</label>
                                    <select id="logs-event-type" name="event_type" class="ui-input">
                                        <option value="">All types</option>
                                        <option value="authentication">Authentication</option>
                                        <option value="profile">Profile</option>
                                        <option value="authorization">Authorization</option>
                                        <option value="admin_mutation">Admin mutation</option>
                                    </select>
                                </div>
                                <div class="logs-filter-field">
                                    <label for="logs-outcome">Outcome</label>
                                    <select id="logs-outcome" name="outcome" class="ui-input">
                                        <option value="">All outcomes</option>
                                        <option value="success">Success</option>
                                        <option value="failure">Failure</option>
                                        <option value="denied">Denied</option>
                                    </select>
                                </div>
                                <div class="logs-filter-field">
                                    <label for="logs-from">From date</label>
                                    <input id="logs-from" name="from" type="date" class="ui-input">
                                </div>
                                <div class="logs-filter-field">
                                    <label for="logs-to">To date</label>
                                    <input id="logs-to" name="to" type="date" class="ui-input">
                                </div>
                                <div class="logs-filter-actions">
                                    <button type="submit" id="logs-apply-btn" class="ui-button ui-button-default ui-button-size-default">
                                        <i data-lucide="filter" class="h-4 w-4 mr-2"></i>Apply
                                    </button>
                                    <button type="button" id="logs-reset-btn" class="ui-button ui-button-outline ui-button-size-default">
                                        <i data-lucide="x" class="h-4 w-4 mr-2"></i>Reset
                                    </button>
                                    <button type="button" id="logs-refresh-btn" class="ui-button ui-button-outline ui-button-size-default">
                                        <i data-lucide="refresh-cw" class="h-4 w-4 mr-2"></i>Refresh
                                    </button>
                                </div>
                                <p id="logs-filter-error" class="logs-filter-error" role="alert" hidden></p>
                            </form>
                        </div>
                    </div>

                    <!-- Results -->
                    <div class="ui-card border-border">
                        <div class="logs-results-head">
                            <h3 class="text-lg font-semibold tracking-tight text-foreground">Activity</h3>
                            <span id="logs-range" class="text-sm text-muted-foreground" aria-live="polite"></span>
                        </div>

                        <div id="logs-loading" class="logs-state" role="status">
                            <i data-lucide="loader-2" class="h-6 w-6 animate-spin text-muted-foreground"></i>
                            <p class="text-sm text-muted-foreground">Loading logs…</p>
                        </div>

                        <div id="logs-error" class="logs-state" hidden>
                            <i data-lucide="alert-triangle" class="h-6 w-6 text-destructive"></i>
                            <p class="text-sm text-muted-foreground">Could not load system logs. Please try again.</p>
                            <button id="logs-retry-btn" type="button" class="ui-button ui-button-outline ui-button-size-sm">
                                <i data-lucide="refresh-cw" class="mr-2 h-4 w-4"></i>Retry
                            </button>
                        </div>

                        <div id="logs-empty" class="logs-state" hidden>
                            <i data-lucide="inbox" class="h-6 w-6 text-muted-foreground"></i>
                            <p class="text-sm text-muted-foreground">No audit activity has been recorded yet.</p>
                        </div>

                        <div id="logs-filtered-empty" class="logs-state" hidden>
                            <i data-lucide="search-x" class="h-6 w-6 text-muted-foreground"></i>
                            <p class="text-sm text-muted-foreground">No logs match the current filters.</p>
                            <button id="logs-filtered-reset-btn" type="button" class="ui-button ui-button-outline ui-button-size-sm">
                                <i data-lucide="x" class="mr-2 h-4 w-4"></i>Clear filters
                            </button>
                        </div>

                        <div id="logs-results" hidden>
                            <!-- Desktop table -->
                            <div class="logs-table-wrap">
                                <table class="ui-table logs-table">
                                    <thead>
                                        <tr>
                                            <th>Timestamp</th>
                                            <th>Event</th>
                                            <th>Action</th>
                                            <th>Outcome</th>
                                            <th>Actor</th>
                                            <th>Target</th>
                                            <th>Message</th>
                                        </tr>
                                    </thead>
                                    <tbody id="logs-table-body"></tbody>
                                </table>
                            </div>
                            <!-- Mobile card list -->
                            <div class="logs-card-list" id="logs-card-list"></div>
                        </div>

                        <div class="logs-pagination">
                            <button type="button" id="logs-prev-btn" class="ui-button ui-button-outline ui-button-size-default" disabled>
                                <i data-lucide="chevron-left" class="h-4 w-4 mr-1"></i>Previous
                            </button>
                            <span id="logs-page-info" class="text-sm text-muted-foreground" aria-live="polite"></span>
                            <button type="button" id="logs-next-btn" class="ui-button ui-button-outline ui-button-size-default" disabled>
                                Next<i data-lucide="chevron-right" class="h-4 w-4 ml-1"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </main>
        </div>
    </div>

    <div id="admin-toast" class="admin-toast" role="status" aria-live="polite"></div>

    <button id="admin-theme-toggle" class="admin-theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
    </button>
    <%# M12.P1-R6: guarded so a missing Lucide bundle cannot throw and abort the page. %>
    <script nonce="<%= cspNonce %>">if (window.lucide && typeof window.lucide.createIcons === 'function') { window.lucide.createIcons(); }</script>
</body>

</html>
