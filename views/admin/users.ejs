<!DOCTYPE html>
<html lang="en">

<head>
    <script nonce="<%= cspNonce %>">
        (function () {
            var savedTheme = localStorage.getItem('adminTheme') || localStorage.getItem('theme');
            if (savedTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-styles.css">
    <%# M12.P1-R6: Lucide is self-hosted at the exact reviewed 1.25.0 (see
        public/vendor/manifest.json). The former unpkg "lucide@latest" reference
        executed whatever build the CDN served at request time. %>
    <script src="/vendor/lucide/lucide.min.js"></script>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <script src="/js/admin/main.js" defer></script>
    <script src="/js/admin/admin-users.js" defer></script>
    <style nonce="<%= cspNonce %>">
        /* Modal Styles */
        .modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 1000;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(4px);
            align-items: center;
            justify-content: center;
        }
        .modal-backdrop.modal--open { display: flex; }
        .modal-box {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 0.75rem;
            width: 95%;
            max-width: 480px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
        }
        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid var(--border);
        }
        .modal-header h3 { font-size: 1.1rem; font-weight: 600; color: var(--foreground); margin: 0; }
        .modal-body { padding: 1.5rem; }
        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 0.75rem;
            padding: 1rem 1.5rem;
            border-top: 1px solid var(--border);
        }
        .form-group { margin-bottom: 1rem; }
        .form-group label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--foreground);
            margin-bottom: 0.375rem;
        }
        .form-group .ui-input, .form-group select {
            width: 100%;
            box-sizing: border-box;
        }
        .form-group select {
            height: 2.5rem;
            padding: 0 0.75rem;
            border-radius: 0.5rem;
            border: 1px solid var(--border);
            background: var(--background);
            color: var(--foreground);
            font-size: 0.875rem;
        }
        .form-error {
            display: none;
            padding: 0.625rem 0.875rem;
            border-radius: 0.5rem;
            background: hsl(0 84% 60% / 0.1);
            color: var(--destructive);
            font-size: 0.8125rem;
            margin-bottom: 1rem;
            border: 1px solid hsl(0 84% 60% / 0.2);
        }
        .form-hint {
            font-size: 0.75rem;
            color: var(--muted-foreground);
            margin-top: 0.25rem;
        }
        /* Toast */
        .admin-toast {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 2000;
            padding: 0.75rem 1.25rem;
            border-radius: 0.5rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: #fff;
            transform: translateY(120%);
            opacity: 0;
            transition: all 0.3s ease;
            pointer-events: none;
        }
        .admin-toast--success { background: hsl(142 71% 45%); }
        .admin-toast--error { background: var(--destructive); }
        .admin-toast--show { transform: translateY(0); opacity: 1; pointer-events: auto; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .animate-spin { animation: spin 1s linear infinite; }
        .modal-delete-warn {
            text-align: center;
            padding: 1rem 0;
        }
        .modal-delete-warn i { color: var(--destructive); margin-bottom: 0.75rem; }
        .modal-delete-warn p { color: var(--muted-foreground); font-size: 0.875rem; line-height: 1.5; }
        .modal-delete-warn strong { color: var(--foreground); }
    </style>
</head>

<body class="admin-surface font-sans antialiased">
    <div class="admin-shell flex h-screen bg-background text-foreground overflow-hidden">

        <!-- Sidebar -->
        <aside id="sidebar"
            class="relative flex h-screen flex-col bg-sidebar text-sidebar-foreground border-r border-sidebar-border transition-all duration-300 w-64 shrink-0">
            <div class="flex items-center gap-3 px-4 py-5 border-b border-sidebar-border h-16">
                <img src="/img/cspc-logo.png" alt="CSPC Logo" class="sidebar-logo shrink-0">
                <div id="sidebar-header-full" class="flex flex-col">
                    <span class="sidebar-brand-title">Campu<span>Sphere</span></span>
                    <span class="sidebar-brand-sub">Admin Portal</span>
                </div>
            </div>
            <nav class="flex-1 px-2 py-4 overflow-y-auto" style="display:flex; flex-direction:column; gap:2px;">
                <a href="/admin"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1">
                    <i data-lucide="layout-dashboard" class="h-5 w-5 shrink-0"></i><span
                        class="sidebar-text">Dashboard</span>
                </a>
                <a href="/admin/users"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors bg-sidebar-accent text-sidebar-accent-foreground mt-1">
                    <i data-lucide="users" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">Users</span>
                </a>
                <a href="/admin/news"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1">
                    <i data-lucide="newspaper" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">News</span>
                </a>
                <a href="/admin/faqs"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1">
                    <i data-lucide="help-circle" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">FAQs</span>
                </a>
                <a href="/admin/logs"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1">
                    <i data-lucide="file-text" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">System
                        Logs</span>
                </a>
                <a href="/admin/campus-map"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1">
                    <i data-lucide="map" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">Campus Map</span>
                </a>
                <a href="/admin/vr"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1">
                    <i data-lucide="globe" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">VR Tour</span>
                </a>
                <a href="/admin/settings"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1">
                    <i data-lucide="settings" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">Settings</span>
                </a>
            </nav>
            <div class="border-t border-sidebar-border p-4">
                <div class="flex items-center gap-3">
                    <div class="ui-avatar h-9 w-9 shrink-0">
                        <div class="ui-avatar-fallback text-xs font-semibold"><%= user ? (user.first_name || '')[0].toUpperCase() + (user.last_name || '')[0].toUpperCase() : 'AD' %></div>
                    </div>
                    <div id="sidebar-user-full" class="flex flex-col flex-1 min-w-0">
                        <span class="text-sm font-medium truncate"><%= user ? user.first_name + ' ' + user.last_name : 'Admin User' %></span>
                        <span class="text-xs text-sidebar-foreground/60 truncate"><%= user ? user.email : 'admin@cspc.edu.ph' %></span>
                    </div>
                    <form method="POST" action="/logout" class="logout-form" style="display:contents;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit"
                            class="ui-button ui-button-ghost ui-button-size-icon h-8 w-8 text-sidebar-foreground/70 shrink-0" title="Logout" style="cursor:pointer;"><i
                            data-lucide="log-out" class="h-4 w-4"></i></button>
                    </form>
                </div>
            </div>
            <button id="sidebar-toggle"
                class="ui-button ui-button-ghost ui-button-size-icon absolute -right-3 top-7 h-6 w-6 rounded-full border border-sidebar-border bg-sidebar text-sidebar-foreground hover:bg-sidebar-accent"
                style="width:1.5rem; height:1.5rem; padding:0;">
                <i id="sidebar-icon-left" data-lucide="chevron-left" class="h-3 w-3"></i>
                <i id="sidebar-icon-right" data-lucide="chevron-right" class="h-3 w-3 hidden"></i>
            </button>
        </aside>

        <!-- Main Content -->
        <div class="flex flex-1 flex-col overflow-hidden">
            <header class="admin-page-header flex h-16 items-center justify-between border-b border-border bg-card px-6 shrink-0">
                <div>
                    <h1 class="text-xl font-semibold text-foreground">User Management</h1>
                    <p class="text-sm text-muted-foreground">Manage student, instructor, and admin accounts</p>
                </div>
            </header>

            <main class="admin-workspace flex-1 overflow-y-auto p-6" style="padding-bottom: 2rem;">
                <div class="mx-auto max-w-7xl" style="display:flex; flex-direction:column; gap:1.5rem;">

                    <!-- Stats -->
                    <div class="grid gap-4 md:grid-cols-4">
                        <div class="ui-card border-border">
                            <div class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="rounded-lg bg-primary/10 p-2.5"><i data-lucide="users" class="h-5 w-5 text-primary"></i></div>
                                    <div>
                                        <p class="text-sm text-muted-foreground">Total Users</p>
                                        <p id="stat-total" class="text-2xl font-bold text-foreground"><%= stats.total %></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="ui-card border-border">
                            <div class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="rounded-lg bg-chart-1/10 p-2.5"><i data-lucide="user-check" class="h-5 w-5 text-chart-1"></i></div>
                                    <div>
                                        <p class="text-sm text-muted-foreground">Active</p>
                                        <p id="stat-active" class="text-2xl font-bold text-foreground"><%= stats.active %></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="ui-card border-border">
                            <div class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="rounded-lg bg-chart-4/10 p-2.5"><i data-lucide="user-x" class="h-5 w-5 text-chart-4"></i></div>
                                    <div>
                                        <p class="text-sm text-muted-foreground">Inactive</p>
                                        <p id="stat-inactive" class="text-2xl font-bold text-foreground"><%= stats.inactive %></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="ui-card border-border">
                            <div class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="rounded-lg bg-chart-2/10 p-2.5"><i data-lucide="user-plus" class="h-5 w-5 text-chart-2"></i></div>
                                    <div>
                                        <p class="text-sm text-muted-foreground">New This Month</p>
                                        <p id="stat-new" class="text-2xl font-bold text-foreground"><%= stats.newThisMonth %></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions Bar -->
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
                        style="display:flex; justify-content:space-between; align-items:center;">
                        <div class="flex flex-1 items-center gap-3">
                            <div class="relative flex-1 max-w-md w-full">
                                <i data-lucide="search"
                                    class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"></i>
                                <input id="user-search-input" type="text" placeholder="Search users..." class="ui-input pl-9"
                                    style="width:100%;">
                            </div>
                            <div class="admin-filter-dropdown relative inline-block text-left">
                                <button id="role-filter-btn"
                                    class="ui-button ui-button-outline ui-button-size-default dropdown-trigger flex items-center justify-between"
                                    style="width:140px;" data-dropdown-target="role-filter-menu"
                                    aria-controls="role-filter-menu" aria-haspopup="menu" aria-expanded="false">
                                    <span>All Roles</span>
                                    <i data-lucide="chevron-down" class="h-4 w-4 opacity-50 ml-2"></i>
                                </button>
                                <div id="role-filter-menu" class="dropdown-menu-content p-1" data-dropdown-placement="anchor" role="menu" style="width:140px;">
                                    <button type="button" class="dropdown-menu-item bg-accent text-accent-foreground" data-value="all" role="menuitemradio" aria-checked="true">All Roles</button>
                                    <button type="button" class="dropdown-menu-item" data-value="student-cspc" role="menuitemradio" aria-checked="false">Student</button>
                                    <button type="button" class="dropdown-menu-item" data-value="instructor" role="menuitemradio" aria-checked="false">Instructor</button>
                                    <button type="button" class="dropdown-menu-item" data-value="admin" role="menuitemradio" aria-checked="false">Admin</button>
                                    <button type="button" class="dropdown-menu-item" data-value="guest" role="menuitemradio" aria-checked="false">Guest</button>
                                </div>
                            </div>
                            <div class="admin-filter-dropdown relative inline-block text-left">
                                <button id="status-filter-btn"
                                    class="ui-button ui-button-outline ui-button-size-default dropdown-trigger flex items-center justify-between"
                                    style="width:140px;" data-dropdown-target="status-filter-menu"
                                    aria-controls="status-filter-menu" aria-haspopup="menu" aria-expanded="false">
                                    <span>All Status</span>
                                    <i data-lucide="chevron-down" class="h-4 w-4 opacity-50 ml-2"></i>
                                </button>
                                <div id="status-filter-menu" class="dropdown-menu-content p-1" data-dropdown-placement="anchor" role="menu" style="width:140px;">
                                    <button type="button" class="dropdown-menu-item bg-accent text-accent-foreground" data-value="all" role="menuitemradio" aria-checked="true">All Status</button>
                                    <button type="button" class="dropdown-menu-item" data-value="active" role="menuitemradio" aria-checked="false">Active</button>
                                    <button type="button" class="dropdown-menu-item" data-value="inactive" role="menuitemradio" aria-checked="false">Inactive</button>
                                </div>
                            </div>
                        </div>
                        <button id="add-user-btn" class="ui-button ui-button-default ui-button-size-default">
                            <i data-lucide="plus" class="mr-2 h-4 w-4"></i>Add User
                        </button>
                    </div>

                    <!-- Users Table -->
                    <div class="ui-card border-border">
                        <div class="p-6 pb-3" style="border-bottom:none;">
                            <h3 id="user-count-label" class="text-lg font-semibold tracking-tight text-foreground">All Users (<%= users.length %>)</h3>
                        </div>
                        <div class="p-0">
                            <table class="ui-table">
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Status</th>
                                        <th>Last Active</th>
                                        <th style="width:60px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="user-table-body">
                                    <!-- Rendered by admin-users.js -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </main>
        </div>
    </div>

    <!-- ======== CREATE USER MODAL ======== -->
    <div id="create-user-modal" class="modal-backdrop">
        <div class="modal-box">
            <div class="modal-header">
                <h3><i data-lucide="user-plus" class="h-5 w-5 mr-2" style="display:inline;vertical-align:middle;"></i> Create New User</h3>
                <button class="modal-close-btn ui-button ui-button-ghost ui-button-size-icon h-8 w-8"><i data-lucide="x" class="h-4 w-4"></i></button>
            </div>
            <form id="create-user-form">
                <div class="modal-body">
                    <div class="form-error"></div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
                        <div class="form-group">
                            <label for="create-fn">First Name</label>
                            <input type="text" name="first_name" id="create-fn" class="ui-input" placeholder="Juan" required>
                        </div>
                        <div class="form-group">
                            <label for="create-ln">Last Name</label>
                            <input type="text" name="last_name" id="create-ln" class="ui-input" placeholder="Dela Cruz" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="create-email">Email</label>
                        <input type="email" name="email" id="create-email" class="ui-input" placeholder="juan.delacruz@cspc.edu.ph" required>
                    </div>
                    <div class="form-group">
                        <label for="create-password">Password</label>
                        <input type="password" name="password" id="create-password" class="ui-input" placeholder="••••••••" required minlength="6">
                    </div>
                    <div class="form-group">
                        <label for="create-role">Role</label>
                        <select name="role" id="create-role" required>
                            <option value="">Select role...</option>
                            <option value="student-cspc">Student (CSPC)</option>
                            <option value="instructor">Instructor</option>
                            <option value="admin">Admin</option>
                            <option value="guest">Guest</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="modal-close-btn ui-button ui-button-outline ui-button-size-default">Cancel</button>
                    <button type="submit" class="ui-button ui-button-default ui-button-size-default">
                        <i data-lucide="plus" class="h-4 w-4 mr-2"></i>Create User
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ======== EDIT USER MODAL ======== -->
    <div id="edit-user-modal" class="modal-backdrop">
        <div class="modal-box">
            <div class="modal-header">
                <h3><i data-lucide="edit" class="h-5 w-5 mr-2" style="display:inline;vertical-align:middle;"></i> Edit User</h3>
                <button class="modal-close-btn ui-button ui-button-ghost ui-button-size-icon h-8 w-8"><i data-lucide="x" class="h-4 w-4"></i></button>
            </div>
            <form id="edit-user-form">
                <div class="modal-body">
                    <div class="form-error"></div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
                        <div class="form-group">
                            <label for="edit-fn">First Name</label>
                            <input type="text" name="first_name" id="edit-fn" class="ui-input" required>
                        </div>
                        <div class="form-group">
                            <label for="edit-ln">Last Name</label>
                            <input type="text" name="last_name" id="edit-ln" class="ui-input" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="edit-email">Email</label>
                        <input type="email" name="email" id="edit-email" class="ui-input" required>
                    </div>
                    <div class="form-group">
                        <label for="edit-password">New Password</label>
                        <input type="password" name="password" id="edit-password" class="ui-input" placeholder="Leave blank to keep current" minlength="6">
                        <p class="form-hint">Leave empty to keep the existing password.</p>
                    </div>
                    <div class="form-group">
                        <label for="edit-role">Role</label>
                        <select name="role" id="edit-role" required>
                            <option value="student-cspc">Student (CSPC)</option>
                            <option value="instructor">Instructor</option>
                            <option value="admin">Admin</option>
                            <option value="guest">Guest</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="modal-close-btn ui-button ui-button-outline ui-button-size-default">Cancel</button>
                    <button type="submit" class="ui-button ui-button-default ui-button-size-default">
                        <i data-lucide="check" class="h-4 w-4 mr-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ======== DELETE CONFIRMATION MODAL ======== -->
    <div id="delete-user-modal" class="modal-backdrop">
        <div class="modal-box" style="max-width:400px;">
            <div class="modal-header">
                <h3>Confirm Deletion</h3>
                <button class="modal-close-btn ui-button ui-button-ghost ui-button-size-icon h-8 w-8"><i data-lucide="x" class="h-4 w-4"></i></button>
            </div>
            <div class="modal-body">
                <div class="modal-delete-warn">
                    <i data-lucide="alert-triangle" style="width:2.5rem;height:2.5rem;display:inline-block;"></i>
                    <p>Are you sure you want to delete <strong id="delete-user-name"></strong>?</p>
                    <p style="margin-top:0.5rem;">This action cannot be undone.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="cancel-delete-btn" type="button" class="ui-button ui-button-outline ui-button-size-default">Cancel</button>
                <button id="confirm-delete-btn" type="button" class="ui-button ui-button-size-default" style="background:var(--destructive);color:#fff;">
                    <i data-lucide="trash-2" class="h-4 w-4 mr-2"></i>Delete
                </button>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="admin-toast" class="admin-toast"></div>

    <!-- Inject server-side user data as JSON for client-side JS -->
    <script id="users-data-json" type="application/json" nonce="<%= cspNonce %>"><%- safeJson(users.map(u => ({ id: u.id, username: u.username, email: u.email, role: u.role, first_name: u.first_name, last_name: u.last_name, created_at: u.created_at, updated_at: u.updated_at }))) %></script>

    <!-- Dark Mode Toggle -->
    <button id="admin-theme-toggle" class="admin-theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
