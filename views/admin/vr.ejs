<!DOCTYPE html>
<html lang="en">

<head>
    <script nonce="<%= cspNonce %>">
        (function () {
            var savedTheme = localStorage.getItem('adminTheme') || localStorage.getItem('theme');
            if (savedTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampuSphere Admin - VR Tour</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-styles.css">
    <%# M12.P1-R6: Lucide is self-hosted at the exact reviewed 1.25.0 (see
        public/vendor/manifest.json). The former unpkg "lucide@latest" reference
        executed whatever build the CDN served at request time. %>
    <script src="/vendor/lucide/lucide.min.js"></script>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <script src="/js/user-presence.js" defer></script>
    <script src="/js/admin/main.js" defer></script>
    <script src="/js/admin/admin-vr.js" defer></script>
    <style nonce="<%= cspNonce %>">
        /* Modal / toast styles (same classes as the other admin pages) */
        .modal-backdrop{display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);align-items:center;justify-content:center;}
        .modal-backdrop.modal--open{display:flex;}
        .modal-box{background:var(--card);border:1px solid var(--border);border-radius:0.75rem;width:95%;max-width:560px;max-height:90vh;overflow-y:auto;box-shadow:0 25px 50px -12px rgba(0,0,0,0.25);}
        .modal-header{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.5rem;border-bottom:1px solid var(--border);}
        .modal-header h3{font-size:1.1rem;font-weight:600;color:var(--foreground);margin:0;}
        .modal-body{padding:1.5rem;}
        .modal-footer{display:flex;justify-content:flex-end;gap:0.75rem;padding:1rem 1.5rem;border-top:1px solid var(--border);}
        .form-group{margin-bottom:1rem;}
        .form-group label{display:block;font-size:0.875rem;font-weight:500;color:var(--foreground);margin-bottom:0.375rem;}
        .form-group .ui-input,.form-group select,.form-group textarea{width:100%;box-sizing:border-box;}
        .form-group select{height:2.5rem;padding:0 0.75rem;border-radius:0.5rem;border:1px solid var(--border);background:var(--background);color:var(--foreground);font-size:0.875rem;}
        .form-group textarea.ui-input{height:auto;min-height:6rem;padding:0.625rem 0.75rem;resize:vertical;font-family:inherit;line-height:1.5;}
        .form-row{display:flex;gap:0.75rem;flex-wrap:wrap;}
        .form-row .form-group{flex:1 1 8rem;margin-bottom:1rem;}
        .form-error{display:none;padding:0.625rem 0.875rem;border-radius:0.5rem;background:hsl(0 84% 60% / 0.1);color:var(--destructive);font-size:0.8125rem;margin-bottom:1rem;border:1px solid hsl(0 84% 60% / 0.2);}
        .form-hint{font-size:0.75rem;color:var(--muted-foreground);margin-top:0.25rem;}
        .vr-target-search{margin-bottom:0.375rem;}
        .vr-target-status{margin:0 0 0.625rem;min-height:1rem;}
        .admin-toast{position:fixed;bottom:1.5rem;right:1.5rem;z-index:2000;padding:0.75rem 1.25rem;border-radius:0.5rem;font-size:0.875rem;font-weight:500;color:#fff;transform:translateY(120%);opacity:0;transition:all 0.3s ease;pointer-events:none;max-width:90vw;}
        .admin-toast--success{background:hsl(142 71% 45%);}
        .admin-toast--error{background:var(--destructive);}
        .admin-toast--show{transform:translateY(0);opacity:1;pointer-events:auto;}
        @keyframes spin{to{transform:rotate(360deg);}}
        .animate-spin{animation:spin 1s linear infinite;}
        .modal-delete-warn{text-align:center;padding:1rem 0;}
        .modal-delete-warn i{color:var(--destructive);margin-bottom:0.75rem;}
        .modal-delete-warn p{color:var(--muted-foreground);font-size:0.875rem;line-height:1.5;}
        .modal-delete-warn strong{color:var(--foreground);}
    </style>
</head>

<body class="admin-surface font-sans antialiased">
    <div class="admin-shell flex h-screen bg-background text-foreground overflow-hidden">
        <aside id="sidebar"
            class="relative flex h-screen flex-col bg-sidebar text-sidebar-foreground border-r border-sidebar-border transition-all duration-300 w-64 shrink-0">
            <div class="flex items-center gap-3 px-4 py-5 border-b border-sidebar-border h-16">
                <img src="/img/cspc-logo.png" alt="CSPC Logo" class="sidebar-logo shrink-0">
                <div id="sidebar-header-full" class="flex flex-col"><span
                        class="sidebar-brand-title">Campu<span>Sphere</span></span><span class="sidebar-brand-sub">Admin
                        Portal</span></div>
            </div>
            <nav class="flex-1 px-2 py-4 overflow-y-auto" style="display:flex;flex-direction:column;gap:2px;">
                <a href="/admin"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="layout-dashboard" class="h-5 w-5 shrink-0"></i><span
                        class="sidebar-text">Dashboard</span></a>
                <a href="/admin/users"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="users" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">Users</span></a>
                <a href="/admin/news"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="newspaper" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">News</span></a>
                <a href="/admin/faqs"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="help-circle" class="h-5 w-5 shrink-0"></i><span
                        class="sidebar-text">FAQs</span></a>
                <a href="/admin/logs"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="file-text" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">System
                        Logs</span></a>
                <a href="/admin/campus-map"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="map" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">Campus Map</span></a>
                <a href="/admin/vr"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors bg-sidebar-accent text-sidebar-accent-foreground mt-1"><i
                        data-lucide="globe" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">VR Tour</span></a>
                <a href="/admin/settings"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="settings" class="h-5 w-5 shrink-0"></i><span
                        class="sidebar-text">Settings</span></a>
            </nav>
            <div class="border-t border-sidebar-border p-4">
                <div class="flex items-center gap-3">
                    <div class="ui-avatar h-9 w-9 shrink-0">
                        <div class="ui-avatar-fallback text-xs font-semibold"><%= user ? (user.first_name || '')[0].toUpperCase() + (user.last_name || '')[0].toUpperCase() : 'AD' %></div>
                    </div>
                    <div id="sidebar-user-full" class="flex flex-col flex-1 min-w-0">
                        <span class="text-sm font-medium truncate"><%= user ? user.first_name + ' ' + user.last_name : 'Admin User' %></span>
                        <span class="text-xs text-sidebar-foreground/60 truncate"><%= user ? user.email : 'admin@cspc.edu.ph' %></span>
                    </div>
                    <form method="POST" action="/logout" class="logout-form" style="display:contents;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="ui-button ui-button-ghost ui-button-size-icon h-8 w-8 text-sidebar-foreground/70 shrink-0" title="Logout" style="cursor:pointer;"><i data-lucide="log-out" class="h-4 w-4"></i></button>
                    </form>
                </div>
            </div>
            <button id="sidebar-toggle"
                class="ui-button ui-button-ghost ui-button-size-icon absolute -right-3 top-7 h-6 w-6 rounded-full border border-sidebar-border bg-sidebar text-sidebar-foreground hover:bg-sidebar-accent"
                style="width:1.5rem;height:1.5rem;padding:0;"><i id="sidebar-icon-left" data-lucide="chevron-left"
                    class="h-3 w-3"></i><i id="sidebar-icon-right" data-lucide="chevron-right"
                    class="h-3 w-3 hidden"></i></button>
        </aside>

        <div class="flex flex-1 flex-col overflow-hidden">
            <header class="admin-page-header flex h-16 items-center justify-between border-b border-border bg-card px-6 shrink-0">
                <div>
                    <h1 class="text-xl font-semibold text-foreground">VR Tour Management</h1>
                    <p class="text-sm text-muted-foreground">Manage 360° scenes and their hotspots</p>
                </div>
            </header>

            <main class="admin-workspace flex-1 overflow-y-auto p-6" style="padding-bottom:2rem;">
                <div class="mx-auto max-w-4xl" style="display:flex;flex-direction:column;gap:1.5rem;">

                    <!-- Action bar -->
                    <div class="vr-actions-bar">
                        <div class="vr-actions-controls">
                            <div class="relative flex-1 vr-search-wrap"><i data-lucide="search"
                                    class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"></i><input
                                    type="text" id="vr-search-input" placeholder="Search scenes…"
                                    aria-label="Search scenes" class="ui-input pl-9" style="width:100%;">
                            </div>
                        </div>
                        <button id="add-scene-btn" class="ui-button ui-button-default ui-button-size-default"><i
                                data-lucide="plus" class="mr-2 h-4 w-4"></i>Add Scene</button>
                    </div>

                    <!-- Truthful stats -->
                    <div class="grid gap-4 md:grid-cols-2">
                        <div class="ui-card border-border">
                            <div class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="rounded-lg bg-primary/10 p-2.5"><i data-lucide="globe"
                                            class="h-5 w-5 text-primary"></i></div>
                                    <div>
                                        <p class="text-sm text-muted-foreground">Total Scenes</p>
                                        <p class="text-2xl font-bold text-foreground" id="vr-stat-total">–</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="ui-card border-border">
                            <div class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="rounded-lg bg-chart-1/10 p-2.5"><i data-lucide="list-filter"
                                            class="h-5 w-5 text-chart-1"></i></div>
                                    <div>
                                        <p class="text-sm text-muted-foreground">Showing</p>
                                        <p class="text-2xl font-bold text-foreground" id="vr-stat-showing">–</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Scene list -->
                    <div class="ui-card border-border">
                        <div class="p-6 pb-3" style="border-bottom:none;">
                            <h3 class="text-lg font-semibold tracking-tight text-foreground" id="vr-list-label">All Scenes</h3>
                        </div>
                        <div class="p-6 pt-0">
                            <div id="vr-loading" class="vr-state" role="status">
                                <i data-lucide="loader-2" class="h-6 w-6 animate-spin text-muted-foreground"></i>
                                <p class="text-sm text-muted-foreground">Loading scenes…</p>
                            </div>
                            <div id="vr-error" class="vr-state" hidden>
                                <i data-lucide="alert-triangle" class="h-6 w-6 text-destructive"></i>
                                <p class="text-sm text-muted-foreground">Could not load VR scenes. Please try again.</p>
                                <button id="vr-retry-btn" class="ui-button ui-button-outline ui-button-size-sm" type="button">
                                    <i data-lucide="refresh-cw" class="mr-2 h-4 w-4"></i>Retry
                                </button>
                            </div>
                            <div id="vr-empty" class="vr-state" hidden>
                                <i data-lucide="inbox" class="h-6 w-6 text-muted-foreground"></i>
                                <p class="text-sm text-muted-foreground">No VR scenes in the database yet. Use “Add Scene” to create the first one.</p>
                            </div>
                            <div id="vr-filtered-empty" class="vr-state" hidden>
                                <i data-lucide="search-x" class="h-6 w-6 text-muted-foreground"></i>
                                <p class="text-sm text-muted-foreground">No scenes match your search.</p>
                            </div>
                            <div id="vr-list" class="w-full" hidden></div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- ======== CREATE / EDIT SCENE MODAL ======== -->
    <div id="vr-scene-modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="vr-scene-modal-title">
        <div class="modal-box">
            <div class="modal-header">
                <h3 id="vr-scene-modal-title">Add Scene</h3>
                <button class="modal-close-btn ui-button ui-button-ghost ui-button-size-icon h-8 w-8" type="button" aria-label="Close"><i data-lucide="x" class="h-4 w-4"></i></button>
            </div>
            <form id="vr-scene-form">
                <div class="modal-body">
                    <div class="form-error"></div>
                    <div class="form-group">
                        <label for="vr-scene-key">Scene key</label>
                        <input type="text" name="scene_key" id="vr-scene-key" class="ui-input" maxlength="60" required placeholder="e.g. scene-library">
                        <p class="form-hint">Lowercase letters, numbers, and hyphens. Must be unique.</p>
                    </div>
                    <div class="form-group">
                        <label for="vr-scene-title">Title</label>
                        <input type="text" name="title" id="vr-scene-title" class="ui-input" maxlength="150" required placeholder="Scene title shown to users">
                    </div>
                    <div class="form-group">
                        <label for="vr-scene-description">Description <span class="text-muted-foreground" style="font-weight:400;">(optional)</span></label>
                        <textarea name="description" id="vr-scene-description" class="ui-input" maxlength="5000" rows="3" placeholder="Short description of this 360° scene"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="vr-scene-image">Image URL <span class="text-muted-foreground" style="font-weight:400;">(optional)</span></label>
                        <input type="text" name="image_url" id="vr-scene-image" class="ui-input" maxlength="255" placeholder="/img/vr/scene-library.jpg or https://res.cloudinary.com/...">
                        <p class="form-hint">Local <code>/img/</code> path or an <code>https://res.cloudinary.com/...</code> URL.</p>
                    </div>
                    <div class="form-group">
                        <label for="vr-scene-cloudinary-id">Cloudinary Public ID <span class="text-muted-foreground" style="font-weight:400;">(optional)</span></label>
                        <input type="text" name="cloudinary_public_id" id="vr-scene-cloudinary-id" class="ui-input" maxlength="255" placeholder="e.g. campus/vr/library">
                        <p class="form-hint">Letters, numbers, <code>/ . _ - ~</code> only. Leave blank if unused.</p>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="vr-scene-node">Route node id <span class="text-muted-foreground" style="font-weight:400;">(optional)</span></label>
                            <input type="number" name="node_id" id="vr-scene-node" class="ui-input" min="1" step="1" placeholder="—">
                        </div>
                        <div class="form-group">
                            <label for="vr-scene-building">Building id <span class="text-muted-foreground" style="font-weight:400;">(optional)</span></label>
                            <input type="number" name="building_id" id="vr-scene-building" class="ui-input" min="1" step="1" placeholder="—">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="vr-scene-yaw">Initial yaw</label>
                            <input type="number" name="initial_yaw" id="vr-scene-yaw" class="ui-input" min="-180" max="180" step="0.01" placeholder="0">
                        </div>
                        <div class="form-group">
                            <label for="vr-scene-pitch">Initial pitch</label>
                            <input type="number" name="initial_pitch" id="vr-scene-pitch" class="ui-input" min="-90" max="90" step="0.01" placeholder="0">
                        </div>
                        <div class="form-group">
                            <label for="vr-scene-order">Display order</label>
                            <input type="number" name="display_order" id="vr-scene-order" class="ui-input" min="0" max="2147483647" step="1" placeholder="0">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="modal-close-btn ui-button ui-button-outline ui-button-size-default">Cancel</button>
                    <button type="submit" id="vr-scene-submit-btn" class="ui-button ui-button-default ui-button-size-default">
                        <i data-lucide="plus" class="h-4 w-4 mr-2"></i><span id="vr-scene-submit-label">Create Scene</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ======== CREATE / EDIT HOTSPOT MODAL ======== -->
    <div id="vr-hotspot-modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="vr-hotspot-modal-title">
        <div class="modal-box">
            <div class="modal-header">
                <h3 id="vr-hotspot-modal-title">Add Hotspot</h3>
                <button class="modal-close-btn ui-button ui-button-ghost ui-button-size-icon h-8 w-8" type="button" aria-label="Close"><i data-lucide="x" class="h-4 w-4"></i></button>
            </div>
            <form id="vr-hotspot-form">
                <div class="modal-body">
                    <div class="form-error"></div>
                    <p class="form-hint" id="vr-hotspot-scene-label" style="margin-bottom:1rem;"></p>
                    <div class="form-group">
                        <label for="vr-hotspot-type">Type</label>
                        <select name="hotspot_type" id="vr-hotspot-type" required>
                            <option value="scene">scene — jump to another scene</option>
                            <option value="info">info — show text</option>
                            <option value="exit">exit — arrival / close</option>
                            <option value="schedule">schedule - show room/facility schedule</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="vr-hotspot-label">Label</label>
                        <input type="text" name="label" id="vr-hotspot-label" class="ui-input" maxlength="150" required placeholder="e.g. Go to Library">
                    </div>
                    <div class="form-group" id="vr-hotspot-target-group">
                        <label for="vr-hotspot-target-search">Search target scenes</label>
                        <input type="search" id="vr-hotspot-target-search" class="ui-input vr-target-search" autocomplete="off" placeholder="Search by scene key or title…" aria-controls="vr-hotspot-target">
                        <p class="form-hint vr-target-status" id="vr-hotspot-target-status" role="status" aria-live="polite"></p>
                        <label for="vr-hotspot-target">Target scene</label>
                        <select name="target_scene_id" id="vr-hotspot-target">
                            <option value="">Select a target scene…</option>
                        </select>
                        <p class="form-hint">Required for a “scene” hotspot. Ignored for info/exit.</p>
                    </div>
                    <div id="vr-hotspot-schedule-group" style="display:none;">
                        <div class="form-group">
                            <label for="vr-hotspot-schedule-search">Search room schedules</label>
                            <input type="search" id="vr-hotspot-schedule-search" class="ui-input" autocomplete="off"
                                placeholder="Building, room, semester, or school year…" aria-controls="vr-hotspot-schedule-document"
                                aria-describedby="vr-hotspot-schedule-status">
                            <p id="vr-hotspot-schedule-status" class="form-hint" role="status" aria-live="polite">Loading room schedules…</p>
                        </div>
                        <div class="form-group">
                            <label for="vr-hotspot-schedule-document">Room schedule</label>
                            <select name="schedule_document_id" id="vr-hotspot-schedule-document">
                                <option value="">Select a room schedule…</option>
                            </select>
                            <p class="form-hint">The hotspot stays linked when the semester, school year, or image is replaced.</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="vr-hotspot-text">Text <span class="text-muted-foreground" style="font-weight:400;">(optional)</span></label>
                        <textarea name="text" id="vr-hotspot-text" class="ui-input" maxlength="5000" rows="3" placeholder="Information shown when the hotspot is opened"></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="vr-hotspot-yaw">Yaw</label>
                            <input type="number" name="yaw" id="vr-hotspot-yaw" class="ui-input" min="-180" max="180" step="0.01" placeholder="0">
                        </div>
                        <div class="form-group">
                            <label for="vr-hotspot-pitch">Pitch</label>
                            <input type="number" name="pitch" id="vr-hotspot-pitch" class="ui-input" min="-90" max="90" step="0.01" placeholder="0">
                        </div>
                        <div class="form-group">
                            <label for="vr-hotspot-order">Display order</label>
                            <input type="number" name="display_order" id="vr-hotspot-order" class="ui-input" min="0" max="2147483647" step="1" placeholder="0">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="modal-close-btn ui-button ui-button-outline ui-button-size-default">Cancel</button>
                    <button type="submit" id="vr-hotspot-submit-btn" class="ui-button ui-button-default ui-button-size-default">
                        <i data-lucide="plus" class="h-4 w-4 mr-2"></i><span id="vr-hotspot-submit-label">Create Hotspot</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ======== DELETE CONFIRMATION MODAL ======== -->
    <div id="vr-delete-modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="vr-delete-title">
        <div class="modal-box" style="max-width:420px;">
            <div class="modal-header">
                <h3 id="vr-delete-title">Confirm Deletion</h3>
                <button class="modal-close-btn ui-button ui-button-ghost ui-button-size-icon h-8 w-8" type="button" aria-label="Close"><i data-lucide="x" class="h-4 w-4"></i></button>
            </div>
            <div class="modal-body">
                <div class="modal-delete-warn">
                    <i data-lucide="alert-triangle" style="width:2.5rem;height:2.5rem;display:inline-block;"></i>
                    <p id="vr-delete-text">Are you sure you want to delete this item?</p>
                    <p style="margin-top:0.5rem;">This action cannot be undone.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="vr-cancel-delete-btn" type="button" class="ui-button ui-button-outline ui-button-size-default">Cancel</button>
                <button id="vr-confirm-delete-btn" type="button" class="ui-button ui-button-size-default" style="background:var(--destructive);color:#fff;">
                    <i data-lucide="trash-2" class="h-4 w-4 mr-2"></i>Delete
                </button>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
