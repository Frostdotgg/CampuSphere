<!DOCTYPE html>
<html lang="en">

<head>
    <script nonce="<%= cspNonce %>">
        (function () {
            var savedTheme = localStorage.getItem('adminTheme') || localStorage.getItem('theme');
            if (savedTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampuSphere Admin - Settings</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-styles.css">
    <%# M12.P1-R6: Lucide is self-hosted at the exact reviewed 1.25.0 (see
        public/vendor/manifest.json). The former unpkg "lucide@latest" reference
        executed whatever build the CDN served at request time. %>
    <script src="/vendor/lucide/lucide.min.js"></script>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <script src="/js/admin/main.js" defer></script>
    <script src="/js/admin/admin-settings.js" defer></script>
    <style nonce="<%= cspNonce %>">
        /* Shared toast + form-error patterns (same classes as the other admin pages) */
        .admin-toast{position:fixed;bottom:1.5rem;right:1.5rem;z-index:2000;padding:0.75rem 1.25rem;border-radius:0.5rem;font-size:0.875rem;font-weight:500;color:#fff;transform:translateY(120%);opacity:0;transition:all 0.3s ease;pointer-events:none;}
        .admin-toast--success{background:hsl(142 71% 45%);}
        .admin-toast--error{background:var(--destructive);}
        .admin-toast--show{transform:translateY(0);opacity:1;pointer-events:auto;}
        .form-error{display:none;padding:0.625rem 0.875rem;border-radius:0.5rem;background:hsl(0 84% 60% / 0.1);color:var(--destructive);font-size:0.8125rem;border:1px solid hsl(0 84% 60% / 0.2);}
        @keyframes spin{to{transform:rotate(360deg);}}
        .animate-spin{animation:spin 1s linear infinite;}
    </style>
</head>

<body class="admin-surface font-sans antialiased">
    <div class="admin-shell flex h-screen bg-background text-foreground overflow-hidden">
        <aside id="sidebar"
            class="relative flex h-screen flex-col bg-sidebar text-sidebar-foreground border-r border-sidebar-border transition-all duration-300 w-64 shrink-0">
            <div class="flex items-center gap-3 px-4 py-5 border-b border-sidebar-border h-16">
                <img src="/img/cspc-logo.png" alt="CSPC Logo" class="sidebar-logo shrink-0">
                <div id="sidebar-header-full" class="flex flex-col"><span
                        class="sidebar-brand-title">Campu<span>Sphere</span></span><span class="sidebar-brand-sub">Admin
                        Portal</span></div>
            </div>
            <nav class="flex-1 px-2 py-4 overflow-y-auto" style="display:flex;flex-direction:column;gap:2px;">
                <a href="/admin"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="layout-dashboard" class="h-5 w-5 shrink-0"></i><span
                        class="sidebar-text">Dashboard</span></a>
                <a href="/admin/users"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="users" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">Users</span></a>
                <a href="/admin/news"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="newspaper" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">News</span></a>
                <a href="/admin/faqs"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="help-circle" class="h-5 w-5 shrink-0"></i><span
                        class="sidebar-text">FAQs</span></a>
                <a href="/admin/logs"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="file-text" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">System
                        Logs</span></a>
                <a href="/admin/campus-map"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="map" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">Campus Map</span></a>
                <a href="/admin/vr"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground mt-1"><i
                        data-lucide="globe" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">VR Tour</span></a>
                <a href="/admin/settings"
                    class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors bg-sidebar-accent text-sidebar-accent-foreground mt-1"><i
                        data-lucide="settings" class="h-5 w-5 shrink-0"></i><span
                        class="sidebar-text">Settings</span></a>
            </nav>
            <div class="border-t border-sidebar-border p-4">
                <div class="flex items-center gap-3">
                    <div class="ui-avatar h-9 w-9 shrink-0">
                        <div class="ui-avatar-fallback text-xs font-semibold"><%= user ? (user.first_name || '')[0].toUpperCase() + (user.last_name || '')[0].toUpperCase() : 'AD' %></div>
                    </div>
                    <div id="sidebar-user-full" class="flex flex-col flex-1 min-w-0">
                        <span class="text-sm font-medium truncate"><%= user ? user.first_name + ' ' + user.last_name : 'Admin User' %></span>
                        <span class="text-xs text-sidebar-foreground/60 truncate"><%= user ? user.email : 'admin@cspc.edu.ph' %></span>
                    </div>
                    <form method="POST" action="/logout" class="logout-form" style="display:contents;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="ui-button ui-button-ghost ui-button-size-icon h-8 w-8 text-sidebar-foreground/70 shrink-0" title="Logout" style="cursor:pointer;"><i data-lucide="log-out" class="h-4 w-4"></i></button>
                    </form>
                </div>
            </div>
            <button id="sidebar-toggle"
                class="ui-button ui-button-ghost ui-button-size-icon absolute -right-3 top-7 h-6 w-6 rounded-full border border-sidebar-border bg-sidebar text-sidebar-foreground hover:bg-sidebar-accent"
                style="width:1.5rem;height:1.5rem;padding:0;"><i id="sidebar-icon-left" data-lucide="chevron-left"
                    class="h-3 w-3"></i><i id="sidebar-icon-right" data-lucide="chevron-right"
                    class="h-3 w-3 hidden"></i></button>
        </aside>

        <div class="flex flex-1 flex-col overflow-hidden">
            <header class="admin-page-header flex h-16 items-center justify-between border-b border-border bg-card px-6 shrink-0">
                <div>
                    <h1 class="text-xl font-semibold text-foreground">Settings</h1>
                    <p class="text-sm text-muted-foreground">Manage your institution's public information. Changes appear on the <a href="/about" class="settings-preview-link">About page</a> and shared footers.</p>
                </div>
            </header>

            <main class="admin-workspace flex-1 overflow-y-auto p-6" style="padding-bottom:2rem;">
                <div class="mx-auto max-w-3xl" style="display:flex;flex-direction:column;gap:1.5rem;">

                    <div id="settings-loading" class="settings-state" role="status">
                        <i data-lucide="loader-2" class="h-6 w-6 animate-spin text-muted-foreground"></i>
                        <p class="text-sm text-muted-foreground">Loading settings…</p>
                    </div>

                    <div id="settings-error" class="settings-state" hidden>
                        <i data-lucide="alert-triangle" class="h-6 w-6 text-destructive"></i>
                        <p class="text-sm text-muted-foreground">Could not load settings. Please try again.</p>
                        <button id="settings-retry-btn" type="button" class="ui-button ui-button-outline ui-button-size-sm">
                            <i data-lucide="refresh-cw" class="mr-2 h-4 w-4"></i>Retry
                        </button>
                    </div>

                    <form id="settings-form" novalidate hidden autocomplete="off"
                        style="display:flex;flex-direction:column;gap:1.5rem;">
                        <div class="form-error" id="settings-form-error" role="alert"></div>

                        <!-- Institution -->
                        <div class="ui-card border-border">
                            <div class="p-6 pb-3" style="border-bottom:none;">
                                <div class="flex items-center gap-3"><i data-lucide="building-2" class="h-5 w-5 text-primary"></i>
                                    <div>
                                        <h3 class="text-lg font-semibold tracking-tight text-foreground">Institution</h3>
                                        <p class="text-sm text-muted-foreground">Name, identity, and description</p>
                                    </div>
                                </div>
                            </div>
                            <div class="p-6 pt-3 settings-card-body">
                                <div class="settings-field">
                                    <label for="set-school_name">School name</label>
                                    <input id="set-school_name" name="school_name" type="text" class="ui-input" maxlength="150" autocomplete="organization" aria-describedby="err-school_name">
                                    <p class="field-error" id="err-school_name" role="alert" hidden></p>
                                </div>
                                <div class="settings-row two">
                                    <div class="settings-field">
                                        <label for="set-school_acronym">Acronym</label>
                                        <input id="set-school_acronym" name="school_acronym" type="text" class="ui-input" maxlength="20" aria-describedby="err-school_acronym">
                                        <p class="field-error" id="err-school_acronym" role="alert" hidden></p>
                                    </div>
                                    <div class="settings-field">
                                        <label for="set-school_founded">Founded year</label>
                                        <input id="set-school_founded" name="school_founded" type="number" class="ui-input" min="1900" step="1" inputmode="numeric" aria-describedby="err-school_founded">
                                        <p class="field-error" id="err-school_founded" role="alert" hidden></p>
                                    </div>
                                </div>
                                <div class="settings-field">
                                    <label for="set-school_address">School address</label>
                                    <input id="set-school_address" name="school_address" type="text" class="ui-input" maxlength="255" autocomplete="off" aria-describedby="err-school_address">
                                    <p class="field-error" id="err-school_address" role="alert" hidden></p>
                                </div>
                                <div class="settings-field">
                                    <label for="set-school_description">Description</label>
                                    <textarea id="set-school_description" name="school_description" class="ui-input" maxlength="2000" rows="7"
                                        data-legacy-description="<%= legacySchoolDescription || '' %>"
                                        data-default-context="<%= defaultSchoolContext || '' %>"
                                        aria-describedby="hint-school_description err-school_description"></textarea>
                                    <p class="field-hint" id="hint-school_description">Use one blank line to separate the institution overview from the campus context shown in the second About paragraph.</p>
                                    <p class="field-error" id="err-school_description" role="alert" hidden></p>
                                </div>
                            </div>
                        </div>

                        <!-- Contact -->
                        <div class="ui-card border-border">
                            <div class="p-6 pb-3" style="border-bottom:none;">
                                <div class="flex items-center gap-3"><i data-lucide="phone" class="h-5 w-5 text-primary"></i>
                                    <div>
                                        <h3 class="text-lg font-semibold tracking-tight text-foreground">Contact</h3>
                                        <p class="text-sm text-muted-foreground">How visitors can reach the institution</p>
                                    </div>
                                </div>
                            </div>
                            <div class="p-6 pt-3 settings-card-body">
                                <div class="settings-field">
                                    <label for="set-contact_address">Contact address</label>
                                    <input id="set-contact_address" name="contact_address" type="text" class="ui-input" maxlength="255" autocomplete="off" aria-describedby="err-contact_address">
                                    <p class="field-error" id="err-contact_address" role="alert" hidden></p>
                                </div>
                                <div class="settings-row two">
                                    <div class="settings-field">
                                        <label for="set-contact_phone">Phone</label>
                                        <input id="set-contact_phone" name="contact_phone" type="text" class="ui-input" maxlength="50" autocomplete="tel" aria-describedby="err-contact_phone">
                                        <p class="field-error" id="err-contact_phone" role="alert" hidden></p>
                                    </div>
                                    <div class="settings-field">
                                        <label for="set-contact_email">Email</label>
                                        <input id="set-contact_email" name="contact_email" type="email" class="ui-input" maxlength="254" autocomplete="email" aria-describedby="err-contact_email">
                                        <p class="field-error" id="err-contact_email" role="alert" hidden></p>
                                    </div>
                                </div>
                                <div class="settings-field">
                                    <label for="set-contact_website">Website</label>
                                    <input id="set-contact_website" name="contact_website" type="url" class="ui-input" maxlength="2048" autocomplete="url" placeholder="https://example.edu.ph" aria-describedby="err-contact_website">
                                    <p class="field-error" id="err-contact_website" role="alert" hidden></p>
                                </div>
                                <div class="settings-field">
                                    <label for="set-contact_hours">Office hours</label>
                                    <input id="set-contact_hours" name="contact_hours" type="text" class="ui-input" maxlength="255" autocomplete="off" aria-describedby="err-contact_hours">
                                    <p class="field-error" id="err-contact_hours" role="alert" hidden></p>
                                </div>
                            </div>
                        </div>

                        <div class="settings-actions">
                            <button type="button" id="settings-reset-btn" class="ui-button ui-button-outline ui-button-size-default">Reset</button>
                            <button type="submit" id="settings-save-btn" class="ui-button ui-button-default ui-button-size-default">
                                <i data-lucide="save" class="h-4 w-4 mr-2"></i><span id="settings-save-label">Save Changes</span>
                            </button>
                        </div>
                    </form>
                </div>
            </main>
        </div>
    </div>

    <div id="admin-toast" class="admin-toast" role="status" aria-live="polite"></div>

    <button id="admin-theme-toggle" class="admin-theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
    </button>
    <%# M12.P1-R6: guarded so a missing Lucide bundle cannot throw and abort the page. %>
    <script nonce="<%= cspNonce %>">if (window.lucide && typeof window.lucide.createIcons === 'function') { window.lucide.createIcons(); }</script>
</body>

</html>
