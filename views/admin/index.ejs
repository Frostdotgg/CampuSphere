<!DOCTYPE html>
<html lang="en">

<head>
    <script>
        (function () {
            var savedTheme = localStorage.getItem('adminTheme') || localStorage.getItem('theme');
            if (savedTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
                document.write('<style>html[data-theme="dark"], html[data-theme="dark"] body { background-color: #111827 !important; color: #e5e7eb !important; }</style>');
            }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampuSphere Admin Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-styles.css">

    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="/js/admin/main.js" defer></script>

    <style>
        .admin-console {
            background:
                linear-gradient(90deg, rgba(10, 22, 40, 0.035) 1px, transparent 1px),
                linear-gradient(180deg, #f3f6fa 0%, #eef3f8 100%);
            background-size: 34px 34px, auto;
        }

        .admin-sidebar-shell {
            background:
                linear-gradient(180deg, rgba(212, 168, 67, 0.12) 0%, transparent 16rem),
                #071528;
            box-shadow: inset -1px 0 0 rgba(255, 255, 255, 0.08);
        }

        .admin-sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .admin-sidebar-link {
            min-height: 2.75rem;
            border-radius: 0.625rem;
            color: color-mix(in srgb, var(--sidebar-foreground) 72%, transparent);
        }

        .admin-sidebar-link:hover,
        .admin-sidebar-link.is-active {
            color: var(--sidebar-accent-foreground);
            background: rgba(255, 255, 255, 0.09);
        }

        .admin-sidebar-link.is-active {
            box-shadow: inset 3px 0 0 var(--gold);
        }

        .admin-topbar {
            position: relative;
            min-height: 7.5rem;
            height: auto !important;
            align-items: stretch !important;
            padding: 0 !important;
            border-bottom: 0 !important;
            background:
                linear-gradient(135deg, #0a1628 0%, #10294d 68%, #17345e 100%);
            color: #ffffff;
            overflow: visible;
        }

        .admin-topbar::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--gold) 0%, #58b7c8 46%, #1e4d8c 100%);
        }

        .admin-commandbar {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            padding: 1.25rem 1.75rem 1.35rem;
        }

        .admin-commandbar-left {
            min-width: 0;
        }

        .admin-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            color: rgba(255, 255, 255, 0.72);
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .admin-eyebrow::before {
            content: "";
            width: 0.45rem;
            height: 0.45rem;
            border-radius: 999px;
            background: var(--gold);
            box-shadow: 0 0 0 4px rgba(212, 168, 67, 0.18);
        }

        .admin-command-title {
            margin-top: 0.25rem;
            font-size: clamp(1.55rem, 2.4vw, 2.2rem);
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 0;
        }

        .admin-command-copy {
            margin-top: 0.25rem;
            max-width: 42rem;
            color: rgba(255, 255, 255, 0.72);
            font-size: 0.9rem;
            line-height: 1.55;
        }

        .admin-commandbar-right {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-shrink: 0;
        }

        .admin-command-input {
            width: min(19rem, 28vw);
            border-color: rgba(255, 255, 255, 0.16) !important;
            background: rgba(255, 255, 255, 0.09) !important;
            color: #ffffff !important;
        }

        .admin-command-input::placeholder {
            color: rgba(255, 255, 255, 0.55);
        }

        .admin-command-search-icon {
            color: rgba(255, 255, 255, 0.62) !important;
        }

        .admin-icon-button {
            width: 2.75rem !important;
            height: 2.75rem !important;
            border: 1px solid rgba(255, 255, 255, 0.18) !important;
            background: rgba(255, 255, 255, 0.08) !important;
            color: #ffffff !important;
        }

        .admin-icon-button:hover {
            background: rgba(255, 255, 255, 0.14) !important;
        }

        .admin-header-shortcuts {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
            flex-wrap: wrap;
        }

        .admin-header-link {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            min-height: 2rem;
            padding: 0 0.75rem;
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.08);
            color: rgba(255, 255, 255, 0.84);
            font-size: 0.78rem;
            font-weight: 700;
        }

        .admin-header-link:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.13);
        }

        .admin-page {
            max-width: 1500px;
            margin: 0 auto;
            padding: 1.25rem 1.5rem 2rem;
        }

        .admin-section {
            border: 1px solid var(--border);
            background: color-mix(in srgb, var(--card) 96%, transparent);
            border-radius: 8px;
            overflow: hidden;
            transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
        }

        .admin-section:hover {
            border-color: color-mix(in srgb, var(--primary) 22%, var(--border));
            box-shadow: 0 18px 38px rgba(10, 22, 40, 0.1);
        }

        .admin-section-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.25rem 1.25rem 0.75rem;
            border-bottom: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
        }

        .admin-section-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--foreground);
            letter-spacing: 0;
        }

        .admin-section-subtitle {
            margin-top: 0.25rem;
            color: var(--muted-foreground);
            font-size: 0.78rem;
            line-height: 1.5;
        }

        .admin-kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 0.85rem;
            border: 0;
            border-radius: 0;
            overflow: visible;
            background: transparent;
        }

        .admin-kpi {
            position: relative;
            background: var(--card);
            padding: 1rem;
            min-height: 8rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border: 1px solid color-mix(in srgb, var(--border) 86%, transparent);
            border-top: 4px solid var(--primary);
            border-radius: 8px;
            box-shadow: 0 12px 28px rgba(10, 22, 40, 0.08);
            overflow: hidden;
        }

        .admin-kpi::after {
            content: "";
            position: absolute;
            right: -1.8rem;
            top: -2rem;
            width: 6rem;
            height: 6rem;
            border: 1px solid color-mix(in srgb, var(--primary) 10%, transparent);
            border-radius: 999px;
        }

        .admin-kpi-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .admin-kpi-label {
            color: var(--muted-foreground);
            font-size: 0.78rem;
            font-weight: 600;
        }

        .admin-kpi-icon {
            width: 2.25rem;
            height: 2.25rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: color-mix(in srgb, var(--primary) 12%, transparent);
            color: var(--primary);
        }

        .admin-kpi-value {
            margin-top: 0.85rem;
            font-family: var(--font-heading);
            font-size: clamp(1.7rem, 2.8vw, 2.35rem);
            font-weight: 800;
            color: var(--foreground);
            line-height: 1;
        }

        .admin-kpi-note {
            color: var(--muted-foreground);
            font-size: 0.75rem;
        }

        .admin-main-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.55fr) minmax(340px, 0.95fr);
            gap: 1rem;
        }

        .admin-lower-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 1rem;
        }

        .admin-body-pad {
            padding: 1.25rem;
        }

        .admin-action-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.75rem;
        }

        .admin-action {
            display: flex;
            gap: 0.75rem;
            align-items: flex-start;
            padding: 0.95rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--background);
            min-height: 5.25rem;
            transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
        }

        .admin-action:hover {
            transform: translateY(-2px);
            border-color: color-mix(in srgb, var(--primary) 28%, var(--border));
            background: color-mix(in srgb, var(--primary) 4%, var(--background));
        }

        .admin-action-icon {
            width: 2rem;
            height: 2rem;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            background: color-mix(in srgb, var(--primary) 10%, transparent);
            flex-shrink: 0;
        }

        .admin-action-title {
            color: var(--foreground);
            font-weight: 700;
            font-size: 0.86rem;
            line-height: 1.2;
        }

        .admin-action-copy {
            margin-top: 0.25rem;
            color: var(--muted-foreground);
            font-size: 0.74rem;
            line-height: 1.4;
        }

        .admin-row-list {
            display: flex;
            flex-direction: column;
        }

        .admin-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.95rem 1.25rem;
            border-bottom: 1px solid color-mix(in srgb, var(--border) 68%, transparent);
        }

        .admin-row:last-child {
            border-bottom: 0;
        }

        .admin-row-main {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 0;
        }

        .admin-row-text {
            min-width: 0;
        }

        .admin-row-title {
            color: var(--foreground);
            font-size: 0.86rem;
            font-weight: 700;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .admin-row-meta {
            margin-top: 0.15rem;
            color: var(--muted-foreground);
            font-size: 0.74rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .admin-log-row {
            display: grid;
            grid-template-columns: 1.5rem minmax(0, 1fr) auto;
            gap: 0.75rem;
            align-items: start;
            padding: 0.9rem 1.25rem;
            border-bottom: 1px solid color-mix(in srgb, var(--border) 68%, transparent);
        }

        .admin-log-row:last-child {
            border-bottom: 0;
        }

        .admin-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.25rem 0.55rem;
            border-radius: 999px;
            border: 1px solid var(--border);
            color: var(--muted-foreground);
            background: var(--background);
            font-size: 0.72rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .admin-status-dot {
            width: 0.45rem;
            height: 0.45rem;
            border-radius: 999px;
            background: var(--chart-1);
        }

        .admin-mini-legend {
            display: flex;
            flex-direction: column;
            gap: 0.7rem;
        }

        .admin-legend-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            color: var(--muted-foreground);
            font-size: 0.8rem;
        }

        .admin-legend-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            min-width: 0;
        }

        .admin-legend-swatch {
            width: 0.55rem;
            height: 0.55rem;
            border-radius: 999px;
            flex-shrink: 0;
        }

        .admin-chart-wrap {
            min-height: 320px;
        }

        .admin-command-link {
            color: var(--primary);
            font-size: 0.78rem;
            font-weight: 700;
        }

        .admin-command-link:hover {
            color: var(--gold);
        }

        [data-theme="dark"] .admin-console {
            background:
                linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
                linear-gradient(180deg, #101827 0%, #0b1220 100%);
            background-size: 34px 34px, auto;
        }

        [data-theme="dark"] .admin-section,
        [data-theme="dark"] .admin-kpi {
            background: color-mix(in srgb, var(--card) 95%, #000 5%);
        }

        [data-theme="dark"] .admin-action {
            background: color-mix(in srgb, var(--background) 84%, var(--card) 16%);
        }

        @media (max-width: 1180px) {
            .admin-kpi-grid,
            .admin-action-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .admin-main-grid,
            .admin-lower-grid {
                grid-template-columns: 1fr;
            }

            .admin-commandbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .admin-commandbar-right {
                width: 100%;
                justify-content: space-between;
            }

            .admin-command-input {
                width: min(26rem, 66vw);
            }
        }

        @media (max-width: 720px) {
            .admin-page {
                padding: 1rem;
            }

            .admin-kpi-grid,
            .admin-action-grid {
                grid-template-columns: 1fr;
            }

            .admin-topbar {
                align-items: flex-start;
                height: auto;
                min-height: 8rem;
            }

            .admin-commandbar {
                padding: 1rem;
            }

            .admin-commandbar-right {
                align-items: stretch;
                flex-direction: column;
            }

            .admin-command-input {
                width: 100%;
            }
        }
    </style>
</head>

<body class="admin-surface font-sans antialiased">
    <div class="admin-shell admin-console flex h-screen bg-background text-foreground overflow-hidden">
        <aside id="sidebar"
            class="admin-sidebar-shell relative flex h-screen flex-col bg-sidebar text-sidebar-foreground border-r border-sidebar-border transition-all duration-300 w-64 shrink-0">
            <div class="flex items-center gap-3 px-4 py-5 border-b border-sidebar-border h-16">
                <img src="/img/cspc-logo.png" alt="CSPC Logo" class="sidebar-logo shrink-0">
                <div id="sidebar-header-full" class="flex flex-col">
                    <span class="sidebar-brand-title">Campu<span>Sphere</span></span>
                    <span class="sidebar-brand-sub">Admin Portal</span>
                </div>
            </div>

            <nav class="admin-sidebar-nav flex-1 px-2 py-4 overflow-y-auto">
                <a href="/admin" class="admin-sidebar-link is-active flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="layout-dashboard" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">Dashboard</span>
                </a>
                <a href="/admin/users" class="admin-sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="users" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">Users</span>
                </a>
                <a href="/admin/news" class="admin-sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="newspaper" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">News</span>
                </a>
                <a href="/admin/faqs" class="admin-sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="help-circle" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">FAQs</span>
                </a>
                <a href="/admin/logs" class="admin-sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="file-text" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">System Logs</span>
                </a>
                <a href="/admin/campus-map" class="admin-sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="map" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">Campus Map</span>
                </a>
                <a href="/admin/settings" class="admin-sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="settings" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">Settings</span>
                </a>
            </nav>

            <div class="border-t border-sidebar-border p-4">
                <div class="flex items-center gap-3">
                    <div class="ui-avatar h-9 w-9 shrink-0">
                        <div class="ui-avatar-fallback text-xs font-semibold">
                            <%= user ? ((user.first_name || '')[0] || '').toUpperCase() + ((user.last_name || '')[0] || '').toUpperCase() : 'AD' %>
                        </div>
                    </div>
                    <div id="sidebar-user-full" class="flex flex-col flex-1 min-w-0">
                        <span class="text-sm font-medium truncate"><%= user ? user.first_name + ' ' + user.last_name : 'Admin User' %></span>
                        <span class="text-xs text-sidebar-foreground/60 truncate"><%= user ? user.email : 'admin@cspc.edu.ph' %></span>
                    </div>
                    <a href="/logout"
                        class="ui-button ui-button-ghost ui-button-size-icon h-8 w-8 text-sidebar-foreground/70 shrink-0" title="Logout" style="cursor:pointer;">
                        <i data-lucide="log-out" class="h-4 w-4"></i>
                    </a>
                </div>
            </div>

            <button id="sidebar-toggle"
                class="ui-button ui-button-ghost ui-button-size-icon absolute -right-3 top-7 h-6 w-6 rounded-full border border-sidebar-border bg-sidebar text-sidebar-foreground hover:bg-sidebar-accent"
                style="width:1.5rem; height:1.5rem; padding:0;">
                <i id="sidebar-icon-left" data-lucide="chevron-left" class="h-3 w-3"></i>
                <i id="sidebar-icon-right" data-lucide="chevron-right" class="h-3 w-3 hidden"></i>
            </button>
        </aside>

        <div class="flex flex-1 flex-col overflow-hidden">
            <header class="admin-topbar flex h-16 items-center justify-between border-b border-border px-6 shrink-0">
                <div class="admin-commandbar">
                    <div class="admin-commandbar-left">
                        <span class="admin-eyebrow">CampusSphere Admin</span>
                        <h1 class="admin-command-title">Operations Command Center</h1>
                        <p class="admin-command-copy">Monitor accounts, content, campus map records, and platform activity from one control surface.</p>
                        <div class="admin-header-shortcuts">
                            <a class="admin-header-link" href="/admin/users"><i data-lucide="users" class="h-3.5 w-3.5"></i>Users</a>
                            <a class="admin-header-link" href="/admin/news"><i data-lucide="newspaper" class="h-3.5 w-3.5"></i>News</a>
                            <a class="admin-header-link" href="/admin/campus-map"><i data-lucide="map-pin" class="h-3.5 w-3.5"></i>Map</a>
                            <a class="admin-header-link" href="/admin/logs"><i data-lucide="terminal-square" class="h-3.5 w-3.5"></i>Logs</a>
                        </div>
                    </div>

                    <div class="admin-commandbar-right">
                        <div class="relative hidden md:block">
                            <i data-lucide="search"
                                class="admin-command-search-icon absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"></i>
                            <input type="search" placeholder="Search admin data..."
                                class="admin-command-input ui-input w-64 pl-9 bg-secondary/50 border-border">
                        </div>

                        <button class="admin-icon-button ui-button ui-button-ghost ui-button-size-icon relative dropdown-trigger"
                            data-dropdown-target="notifications-menu">
                            <i data-lucide="bell" class="h-5 w-5"></i>
                            <span
                                class="ui-badge ui-badge-default absolute -right-1 -top-1 h-5 w-5 rounded-full p-0 flex items-center justify-center text-xs"
                                style="padding:0; min-width:1.25rem;">3</span>
                        </button>

                        <div id="notifications-menu" class="dropdown-menu-content w-80 p-1"
                            style="min-width: 20rem; right: 1.5rem;">
                            <div class="px-2 py-1.5 text-sm font-semibold">Notifications</div>
                            <div class="h-px bg-border my-1" style="margin:0.25rem 0;"></div>
                            <div class="dropdown-menu-item flex flex-col items-start gap-1 p-3">
                                <span class="font-medium text-foreground">New user registration</span>
                                <span class="text-xs text-muted-foreground">John Doe registered as a student</span>
                                <span class="text-xs text-muted-foreground">2 min ago</span>
                            </div>
                            <div class="dropdown-menu-item flex flex-col items-start gap-1 p-3">
                                <span class="font-medium text-foreground">System update available</span>
                                <span class="text-xs text-muted-foreground">Version 1.2.0 is ready to install</span>
                                <span class="text-xs text-muted-foreground">1 hour ago</span>
                            </div>
                            <div class="dropdown-menu-item flex flex-col items-start gap-1 p-3">
                                <span class="font-medium text-foreground">New FAQ submission</span>
                                <span class="text-xs text-muted-foreground">A user submitted a new question</span>
                                <span class="text-xs text-muted-foreground">3 hours ago</span>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <main class="admin-workspace flex-1 overflow-y-auto">
                <div class="admin-page" style="display:flex; flex-direction:column; gap:1rem;">
                    <section class="admin-kpi-grid" aria-label="Key metrics">
                        <div class="admin-kpi">
                            <div class="admin-kpi-top">
                                <span class="admin-kpi-label">Total Users</span>
                                <span class="admin-kpi-icon"><i data-lucide="users" class="h-5 w-5"></i></span>
                            </div>
                            <div>
                                <div class="admin-kpi-value"><%= stats.totalUsers || 0 %></div>
                                <p class="admin-kpi-note">All registered accounts</p>
                            </div>
                        </div>
                        <div class="admin-kpi">
                            <div class="admin-kpi-top">
                                <span class="admin-kpi-label">Students</span>
                                <span class="admin-kpi-icon"><i data-lucide="graduation-cap" class="h-5 w-5"></i></span>
                            </div>
                            <div>
                                <div class="admin-kpi-value"><%= stats.totalStudents || 0 %></div>
                                <p class="admin-kpi-note">CSPC student role count</p>
                            </div>
                        </div>
                        <div class="admin-kpi">
                            <div class="admin-kpi-top">
                                <span class="admin-kpi-label">News Articles</span>
                                <span class="admin-kpi-icon"><i data-lucide="newspaper" class="h-5 w-5"></i></span>
                            </div>
                            <div>
                                <div class="admin-kpi-value"><%= stats.totalNews || 0 %></div>
                                <p class="admin-kpi-note">Published and draft content</p>
                            </div>
                        </div>
                        <div class="admin-kpi">
                            <div class="admin-kpi-top">
                                <span class="admin-kpi-label">Buildings</span>
                                <span class="admin-kpi-icon"><i data-lucide="map" class="h-5 w-5"></i></span>
                            </div>
                            <div>
                                <div class="admin-kpi-value"><%= stats.totalMapViews || 0 %></div>
                                <p class="admin-kpi-note">Campus map records</p>
                            </div>
                        </div>
                    </section>

                    <section class="admin-main-grid">
                        <div class="admin-section">
                            <div class="admin-section-header">
                                <div>
                                    <h2 class="admin-section-title">Activity Overview</h2>
                                    <p class="admin-section-subtitle">Monthly account activity and map interactions.</p>
                                </div>
                                <span class="admin-pill"><span class="admin-status-dot"></span>Live preview</span>
                            </div>
                            <div class="admin-body-pad admin-chart-wrap">
                                <canvas id="activityChart" style="width:100%; height:300px;"></canvas>
                                <div class="mt-4 flex items-center justify-center gap-6">
                                    <div class="flex items-center gap-2">
                                        <div class="h-3 w-3 rounded-full" style="background:var(--navy-600);"></div>
                                        <span class="text-sm text-muted-foreground">Users</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <div class="h-3 w-3 rounded-full" style="background:var(--gold);"></div>
                                        <span class="text-sm text-muted-foreground">Map Views</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="admin-section">
                            <div class="admin-section-header">
                                <div>
                                    <h2 class="admin-section-title">Role Mix</h2>
                                    <p class="admin-section-subtitle">Account distribution by access level.</p>
                                </div>
                            </div>
                            <div class="admin-body-pad">
                                <div class="flex items-center justify-center" style="height:200px;">
                                    <svg id="roleChart" viewBox="0 0 200 200" width="180" height="180"></svg>
                                </div>
                                <div class="admin-mini-legend">
                                    <div class="admin-legend-row">
                                        <span class="admin-legend-label"><span class="admin-legend-swatch" style="background:#1a3a6b;"></span>Students</span>
                                        <strong class="text-foreground"><%= stats.totalStudents || 0 %></strong>
                                    </div>
                                    <div class="admin-legend-row">
                                        <span class="admin-legend-label"><span class="admin-legend-swatch" style="background:#d4a843;"></span>Instructors</span>
                                        <strong class="text-foreground">Faculty</strong>
                                    </div>
                                    <div class="admin-legend-row">
                                        <span class="admin-legend-label"><span class="admin-legend-swatch" style="background:#7c3aed;"></span>Admins</span>
                                        <strong class="text-foreground">Full access</strong>
                                    </div>
                                    <div class="admin-legend-row">
                                        <span class="admin-legend-label"><span class="admin-legend-swatch" style="background:#6b7280;"></span>Guests</span>
                                        <strong class="text-foreground">View only</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="admin-section">
                        <div class="admin-section-header">
                            <div>
                                <h2 class="admin-section-title">Quick Actions</h2>
                                <p class="admin-section-subtitle">Jump to the most-used administration workspaces.</p>
                            </div>
                        </div>
                        <div class="admin-body-pad">
                            <div class="admin-action-grid">
                                <a href="/admin/users" class="admin-action">
                                    <span class="admin-action-icon"><i data-lucide="user-plus" class="h-4 w-4"></i></span>
                                    <span>
                                        <span class="admin-action-title">Manage Users</span>
                                        <span class="admin-action-copy">Create, update, or remove accounts.</span>
                                    </span>
                                </a>
                                <a href="/admin/news" class="admin-action">
                                    <span class="admin-action-icon"><i data-lucide="newspaper" class="h-4 w-4"></i></span>
                                    <span>
                                        <span class="admin-action-title">News and Events</span>
                                        <span class="admin-action-copy">Publish announcements and schedules.</span>
                                    </span>
                                </a>
                                <a href="/admin/campus-map" class="admin-action">
                                    <span class="admin-action-icon"><i data-lucide="map-pin" class="h-4 w-4"></i></span>
                                    <span>
                                        <span class="admin-action-title">Campus Map</span>
                                        <span class="admin-action-copy">Maintain buildings and coordinates.</span>
                                    </span>
                                </a>
                                <a href="/admin/faqs" class="admin-action">
                                    <span class="admin-action-icon"><i data-lucide="help-circle" class="h-4 w-4"></i></span>
                                    <span>
                                        <span class="admin-action-title">FAQs</span>
                                        <span class="admin-action-copy">Review public help content.</span>
                                    </span>
                                </a>
                                <a href="/admin/logs" class="admin-action">
                                    <span class="admin-action-icon"><i data-lucide="file-text" class="h-4 w-4"></i></span>
                                    <span>
                                        <span class="admin-action-title">System Logs</span>
                                        <span class="admin-action-copy">Inspect recent operational events.</span>
                                    </span>
                                </a>
                                <a href="/admin/settings" class="admin-action">
                                    <span class="admin-action-icon"><i data-lucide="settings" class="h-4 w-4"></i></span>
                                    <span>
                                        <span class="admin-action-title">Settings</span>
                                        <span class="admin-action-copy">Configure portal preferences.</span>
                                    </span>
                                </a>
                            </div>
                        </div>
                    </section>

                    <section class="admin-lower-grid">
                        <div class="admin-section">
                            <div class="admin-section-header">
                                <div>
                                    <h2 class="admin-section-title">Recent Users</h2>
                                    <p class="admin-section-subtitle">Latest account records from the database.</p>
                                </div>
                                <a href="/admin/users" class="admin-command-link">View all</a>
                            </div>
                            <div class="admin-row-list">
                                <% if (recentUsers && recentUsers.length > 0) { %>
                                    <% recentUsers.forEach(account => {
                                        const roleConfig = {
                                            'admin': { label: 'Admin', colorClass: 'bg-chart-4/10 text-chart-4 border-chart-4/20' },
                                            'instructor': { label: 'Instructor', colorClass: 'bg-chart-2/10 text-chart-2 border-chart-2/20' },
                                            'student-cspc': { label: 'Student', colorClass: 'bg-chart-1/10 text-chart-1 border-chart-1/20' },
                                            'student-guest': { label: 'Guest Student', colorClass: 'bg-chart-1/10 text-chart-1 border-chart-1/20' },
                                            'guest': { label: 'Guest', colorClass: 'bg-muted/20 text-muted-foreground border-border' }
                                        };
                                        const conf = roleConfig[account.role] || { label: 'Unknown', colorClass: 'bg-muted/20 text-muted-foreground border-border' };
                                        let initials = 'NA';
                                        if (account.first_name && account.last_name) {
                                            initials = account.first_name[0] + account.last_name[0];
                                        } else if (account.email) {
                                            initials = account.email.substring(0, 2).toUpperCase();
                                        }
                                    %>
                                        <div class="admin-row">
                                            <div class="admin-row-main">
                                                <div class="ui-avatar h-10 w-10">
                                                    <div class="ui-avatar-fallback text-xs font-medium" style="font-size:0.7rem;">
                                                        <%= initials.toUpperCase() %>
                                                    </div>
                                                </div>
                                                <div class="admin-row-text">
                                                    <div class="admin-row-title"><%= account.first_name %> <%= account.last_name %></div>
                                                    <div class="admin-row-meta"><%= account.email %></div>
                                                </div>
                                            </div>
                                            <span class="ui-badge ui-badge-outline <%= conf.colorClass %>"><%= conf.label %></span>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <div class="admin-row">
                                        <p class="text-sm text-muted-foreground">No recent users found.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <div class="admin-section">
                            <div class="admin-section-header">
                                <div>
                                    <h2 class="admin-section-title">Recent News</h2>
                                    <p class="admin-section-subtitle">Newest campus announcements and articles.</p>
                                </div>
                                <a href="/admin/news" class="admin-command-link">Manage</a>
                            </div>
                            <div class="admin-row-list">
                                <% if (recentNews && recentNews.length > 0) { %>
                                    <% recentNews.forEach(item => {
                                        const catConfig = {
                                            'Announcement': 'bg-chart-1/10 text-chart-1 border-chart-1/20',
                                            'Campus Update': 'bg-chart-2/10 text-chart-2 border-chart-2/20',
                                            'Events': 'bg-chart-4/10 text-chart-4 border-chart-4/20',
                                            'Academic': 'bg-primary/10 text-primary border-primary/20',
                                            'Facilities': 'bg-chart-2/10 text-chart-2 border-chart-2/20'
                                        };
                                        const colorClass = catConfig[item.category] || 'bg-muted/20 text-muted-foreground border-border';
                                        const d = new Date(item.published_date);
                                        const dateStr = !isNaN(d) ? d.toLocaleDateString() : 'Draft';
                                        const publishLabel = item.published_date ? 'Published' : 'Draft';
                                    %>
                                        <div class="admin-row">
                                            <div class="admin-row-main">
                                                <span class="admin-action-icon"><i data-lucide="newspaper" class="h-4 w-4"></i></span>
                                                <div class="admin-row-text">
                                                    <div class="admin-row-title"><%= item.title %></div>
                                                    <div class="admin-row-meta"><%= dateStr %></div>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <span class="ui-badge ui-badge-outline <%= colorClass %>"><%= item.category %></span>
                                                <span class="ui-badge <%= item.published_date ? 'ui-badge-default' : 'ui-badge-secondary' %>"><%= publishLabel %></span>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <div class="admin-row">
                                        <p class="text-sm text-muted-foreground">No recent news found.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </section>

                    <section class="admin-section">
                        <div class="admin-section-header">
                            <div>
                                <h2 class="admin-section-title">System Events</h2>
                                <p class="admin-section-subtitle">Recent platform activity shown for operator context.</p>
                            </div>
                            <a href="/admin/logs" class="admin-command-link">Open logs</a>
                        </div>
                        <div class="admin-row-list">
                            <div class="admin-log-row">
                                <i data-lucide="check-circle" class="h-5 w-5 shrink-0 text-chart-1"></i>
                                <div>
                                    <div class="admin-row-title">User authentication successful</div>
                                    <div class="admin-row-meta">2 min ago - admin@cspc.edu.ph</div>
                                </div>
                                <span class="ui-badge ui-badge-outline bg-chart-1/10 text-chart-1 border-chart-1/20">success</span>
                            </div>
                            <div class="admin-log-row">
                                <i data-lucide="info" class="h-5 w-5 shrink-0 text-chart-2"></i>
                                <div>
                                    <div class="admin-row-title">New student registration completed</div>
                                    <div class="admin-row-meta">15 min ago - system</div>
                                </div>
                                <span class="ui-badge ui-badge-outline bg-chart-2/10 text-chart-2 border-chart-2/20">info</span>
                            </div>
                            <div class="admin-log-row">
                                <i data-lucide="alert-triangle" class="h-5 w-5 shrink-0 text-chart-4"></i>
                                <div>
                                    <div class="admin-row-title">Failed login attempt detected</div>
                                    <div class="admin-row-meta">1 hour ago - unknown</div>
                                </div>
                                <span class="ui-badge ui-badge-outline bg-chart-4/10 text-chart-4 border-chart-4/20">warning</span>
                            </div>
                            <div class="admin-log-row">
                                <i data-lucide="check-circle" class="h-5 w-5 shrink-0 text-chart-1"></i>
                                <div>
                                    <div class="admin-row-title">Database backup completed successfully</div>
                                    <div class="admin-row-meta">3 hours ago - system</div>
                                </div>
                                <span class="ui-badge ui-badge-outline bg-chart-1/10 text-chart-1 border-chart-1/20">success</span>
                            </div>
                        </div>
                    </section>
                </div>
            </main>
        </div>
    </div>

    <button id="admin-theme-toggle" class="admin-theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
    </button>

    <script>
        lucide.createIcons();

        (function () {
            const canvas = document.getElementById('activityChart');
            if (!canvas) return;
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = 300 * dpr;
            canvas.style.height = '300px';
            const ctx = canvas.getContext('2d');
            ctx.scale(dpr, dpr);
            const W = rect.width, H = 300;
            const pad = { top: 20, right: 20, bottom: 30, left: 50 };
            const data = [
                { date: 'Jan', users: 400, mapViews: 2400 },
                { date: 'Feb', users: 300, mapViews: 1398 },
                { date: 'Mar', users: 520, mapViews: 3800 },
                { date: 'Apr', users: 478, mapViews: 3908 },
                { date: 'May', users: 589, mapViews: 4800 },
                { date: 'Jun', users: 639, mapViews: 3800 },
                { date: 'Jul', users: 780, mapViews: 4300 },
                { date: 'Aug', users: 890, mapViews: 5100 },
                { date: 'Sep', users: 720, mapViews: 4200 },
                { date: 'Oct', users: 850, mapViews: 5500 },
                { date: 'Nov', users: 920, mapViews: 6100 },
                { date: 'Dec', users: 1100, mapViews: 7200 }
            ];
            const maxVal = 7200;
            const cW = W - pad.left - pad.right;
            const cH = H - pad.top - pad.bottom;
            const xStep = cW / (data.length - 1);

            function yPos(v) { return pad.top + cH - (v / maxVal) * cH; }
            function xPos(i) { return pad.left + i * xStep; }

            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            ctx.strokeStyle = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
            ctx.lineWidth = 1;
            for (let i = 0; i <= 5; i++) {
                const y = pad.top + (cH / 5) * i;
                ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(W - pad.right, y); ctx.stroke();
            }

            ctx.fillStyle = isDark ? '#9ca3af' : '#6b7280';
            ctx.font = '12px Inter, system-ui, sans-serif';
            ctx.textAlign = 'right';
            for (let i = 0; i <= 5; i++) {
                const val = Math.round((maxVal / 5) * (5 - i));
                const y = pad.top + (cH / 5) * i;
                ctx.fillText(val.toLocaleString(), pad.left - 8, y + 4);
            }

            ctx.textAlign = 'center';
            data.forEach((d, i) => {
                ctx.fillText(d.date, xPos(i), H - 8);
            });

            function drawArea(key, strokeColor, fillColorTop, fillColorBot) {
                const grad = ctx.createLinearGradient(0, pad.top, 0, H - pad.bottom);
                grad.addColorStop(0, fillColorTop);
                grad.addColorStop(1, fillColorBot);
                ctx.beginPath();
                ctx.moveTo(xPos(0), yPos(data[0][key]));
                for (let i = 1; i < data.length; i++) {
                    const cx1 = xPos(i - 1) + xStep * 0.4;
                    const cx2 = xPos(i) - xStep * 0.4;
                    ctx.bezierCurveTo(cx1, yPos(data[i - 1][key]), cx2, yPos(data[i][key]), xPos(i), yPos(data[i][key]));
                }
                ctx.lineTo(xPos(data.length - 1), H - pad.bottom);
                ctx.lineTo(xPos(0), H - pad.bottom);
                ctx.closePath();
                ctx.fillStyle = grad;
                ctx.fill();
                ctx.beginPath();
                ctx.moveTo(xPos(0), yPos(data[0][key]));
                for (let i = 1; i < data.length; i++) {
                    const cx1 = xPos(i - 1) + xStep * 0.4;
                    const cx2 = xPos(i) - xStep * 0.4;
                    ctx.bezierCurveTo(cx1, yPos(data[i - 1][key]), cx2, yPos(data[i][key]), xPos(i), yPos(data[i][key]));
                }
                ctx.strokeStyle = strokeColor;
                ctx.lineWidth = 2;
                ctx.stroke();
            }

            drawArea('mapViews', '#d4a843', 'rgba(212,168,67,0.3)', 'rgba(212,168,67,0)');
            drawArea('users', '#1a3a6b', 'rgba(26,58,107,0.3)', 'rgba(26,58,107,0)');
        })();

        (function () {
            const svg = document.getElementById('roleChart');
            if (!svg) return;
            const roles = [
                { value: 1845, color: '#1a3a6b' },
                { value: 389, color: '#2563a8' },
                { value: 156, color: '#d4a843' },
                { value: 24, color: '#7c3aed' },
                { value: 433, color: '#6b7280' }
            ];
            const total = roles.reduce((s, r) => s + r.value, 0);
            const cx = 100, cy = 100, outerR = 80, innerR = 50, gap = 2;
            let startAngle = -Math.PI / 2;
            roles.forEach(r => {
                const sliceAngle = (r.value / total) * Math.PI * 2;
                const gapAngle = gap / outerR;
                const a1 = startAngle + gapAngle / 2;
                const a2 = startAngle + sliceAngle - gapAngle / 2;
                const x1o = cx + outerR * Math.cos(a1);
                const y1o = cy + outerR * Math.sin(a1);
                const x2o = cx + outerR * Math.cos(a2);
                const y2o = cy + outerR * Math.sin(a2);
                const x2i = cx + innerR * Math.cos(a2);
                const y2i = cy + innerR * Math.sin(a2);
                const x1i = cx + innerR * Math.cos(a1);
                const y1i = cy + innerR * Math.sin(a1);
                const large = sliceAngle > Math.PI ? 1 : 0;
                const d = `M ${x1o} ${y1o} A ${outerR} ${outerR} 0 ${large} 1 ${x2o} ${y2o} L ${x2i} ${y2i} A ${innerR} ${innerR} 0 ${large} 0 ${x1i} ${y1i} Z`;
                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('d', d);
                path.setAttribute('fill', r.color);
                svg.appendChild(path);
                startAngle += sliceAngle;
            });
        })();
    </script>
</body>

</html>
