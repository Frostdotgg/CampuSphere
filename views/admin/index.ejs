<!DOCTYPE html>
<html lang="en">

<head>
    <script nonce="<%= cspNonce %>">
        (function () {
            var savedTheme = localStorage.getItem('adminTheme') || localStorage.getItem('theme');
            if (savedTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampuSphere Admin Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-styles.css">

    <%# M12.P1-R6: Lucide is self-hosted at the exact reviewed 1.25.0 (see
        public/vendor/manifest.json). The former unpkg "lucide@latest" reference
        executed whatever build the CDN served at request time. %>
    <script src="/vendor/lucide/lucide.min.js"></script>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <script src="/js/user-presence.js" defer></script>
    <script src="/js/admin/main.js" defer></script>

    <style nonce="<%= cspNonce %>">
        .admin-console {
            background:
                linear-gradient(90deg, rgba(10, 22, 40, 0.035) 1px, transparent 1px),
                linear-gradient(180deg, #f3f6fa 0%, #eef3f8 100%);
            background-size: 34px 34px, auto;
        }

        .admin-sidebar-shell {
            background:
                linear-gradient(180deg, rgba(212, 168, 67, 0.12) 0%, transparent 16rem),
                #071528;
            box-shadow: inset -1px 0 0 rgba(255, 255, 255, 0.08);
        }

        .admin-sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .admin-sidebar-link {
            min-height: 2.75rem;
            border-radius: 0.625rem;
            color: color-mix(in srgb, var(--sidebar-foreground) 72%, transparent);
        }

        .admin-sidebar-link:hover,
        .admin-sidebar-link.is-active {
            color: var(--sidebar-accent-foreground);
            background: rgba(255, 255, 255, 0.09);
        }

        .admin-sidebar-link.is-active {
            box-shadow: inset 3px 0 0 var(--gold);
        }

        .admin-topbar {
            position: relative;
            min-height: 7.5rem;
            height: auto !important;
            align-items: stretch !important;
            padding: 0 !important;
            border-bottom: 0 !important;
            background:
                linear-gradient(135deg, #0a1628 0%, #10294d 68%, #17345e 100%);
            color: #ffffff;
            overflow: visible;
        }

        .admin-topbar::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--gold) 0%, #58b7c8 46%, #1e4d8c 100%);
        }

        .admin-commandbar {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            padding: 1.25rem 1.75rem 1.35rem;
        }

        .admin-commandbar-left {
            min-width: 0;
        }

        .admin-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            color: rgba(255, 255, 255, 0.72);
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .admin-eyebrow::before {
            content: "";
            width: 0.45rem;
            height: 0.45rem;
            border-radius: 999px;
            background: var(--gold);
            box-shadow: 0 0 0 4px rgba(212, 168, 67, 0.18);
        }

        .admin-command-title {
            margin-top: 0.25rem;
            font-size: clamp(1.55rem, 2.4vw, 2.2rem);
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 0;
        }

        .admin-command-copy {
            margin-top: 0.25rem;
            max-width: 42rem;
            color: rgba(255, 255, 255, 0.72);
            font-size: 0.9rem;
            line-height: 1.55;
        }

        .admin-commandbar-right {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-shrink: 0;
        }

        .admin-command-input {
            width: min(19rem, 28vw);
            border-color: rgba(255, 255, 255, 0.16) !important;
            background: rgba(255, 255, 255, 0.09) !important;
            color: #ffffff !important;
        }

        .admin-command-input::placeholder {
            color: rgba(255, 255, 255, 0.55);
        }

        .admin-command-search-icon {
            color: rgba(255, 255, 255, 0.62) !important;
        }

        .admin-icon-button {
            width: 2.75rem !important;
            height: 2.75rem !important;
            border: 1px solid rgba(255, 255, 255, 0.18) !important;
            background: rgba(255, 255, 255, 0.08) !important;
            color: #ffffff !important;
        }

        .admin-icon-button:hover {
            background: rgba(255, 255, 255, 0.14) !important;
        }

        .admin-header-shortcuts {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
            flex-wrap: wrap;
        }

        .admin-header-link {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            min-height: 2rem;
            padding: 0 0.75rem;
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.08);
            color: rgba(255, 255, 255, 0.84);
            font-size: 0.78rem;
            font-weight: 700;
        }

        .admin-header-link:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.13);
        }

        .admin-page {
            max-width: 1500px;
            margin: 0 auto;
            padding: 1.25rem 1.5rem 2rem;
        }

        .admin-section {
            border: 1px solid var(--border);
            background: color-mix(in srgb, var(--card) 96%, transparent);
            border-radius: 8px;
            overflow: hidden;
            transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
        }

        .admin-section:hover {
            border-color: color-mix(in srgb, var(--primary) 22%, var(--border));
            box-shadow: 0 18px 38px rgba(10, 22, 40, 0.1);
        }

        .admin-section-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.25rem 1.25rem 0.75rem;
            border-bottom: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
        }

        .admin-section-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--foreground);
            letter-spacing: 0;
        }

        .admin-section-subtitle {
            margin-top: 0.25rem;
            color: var(--muted-foreground);
            font-size: 0.78rem;
            line-height: 1.5;
        }

        .admin-kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 0.85rem;
            border: 0;
            border-radius: 0;
            overflow: visible;
            background: transparent;
        }

        .admin-kpi {
            position: relative;
            background: var(--card);
            padding: 1rem;
            min-height: 8rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border: 1px solid color-mix(in srgb, var(--border) 86%, transparent);
            border-top: 4px solid var(--primary);
            border-radius: 8px;
            box-shadow: 0 12px 28px rgba(10, 22, 40, 0.08);
            overflow: hidden;
        }

        .admin-kpi::after {
            content: "";
            position: absolute;
            right: -1.8rem;
            top: -2rem;
            width: 6rem;
            height: 6rem;
            border: 1px solid color-mix(in srgb, var(--primary) 10%, transparent);
            border-radius: 999px;
        }

        .admin-kpi-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .admin-kpi-label {
            color: var(--muted-foreground);
            font-size: 0.78rem;
            font-weight: 600;
        }

        .admin-kpi-icon {
            width: 2.25rem;
            height: 2.25rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: color-mix(in srgb, var(--primary) 12%, transparent);
            color: var(--primary);
        }

        .admin-kpi-value {
            margin-top: 0.85rem;
            font-family: var(--font-heading);
            font-size: clamp(1.7rem, 2.8vw, 2.35rem);
            font-weight: 800;
            color: var(--foreground);
            line-height: 1;
        }

        .admin-kpi-note {
            color: var(--muted-foreground);
            font-size: 0.75rem;
        }

        .admin-main-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.55fr) minmax(340px, 0.95fr);
            gap: 1rem;
        }

        .admin-lower-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 1rem;
        }

        .admin-body-pad {
            padding: 1.25rem;
        }

        .admin-action-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.75rem;
        }

        .admin-action {
            display: flex;
            gap: 0.75rem;
            align-items: flex-start;
            padding: 0.95rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--background);
            min-height: 5.25rem;
            transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
        }

        .admin-action:hover {
            transform: translateY(-2px);
            border-color: color-mix(in srgb, var(--primary) 28%, var(--border));
            background: color-mix(in srgb, var(--primary) 4%, var(--background));
        }

        .admin-action-icon {
            width: 2rem;
            height: 2rem;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            background: color-mix(in srgb, var(--primary) 10%, transparent);
            flex-shrink: 0;
        }

        .admin-action-title {
            color: var(--foreground);
            font-weight: 700;
            font-size: 0.86rem;
            line-height: 1.2;
        }

        .admin-action-copy {
            margin-top: 0.25rem;
            color: var(--muted-foreground);
            font-size: 0.74rem;
            line-height: 1.4;
        }

        .admin-row-list {
            display: flex;
            flex-direction: column;
        }

        .admin-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.95rem 1.25rem;
            border-bottom: 1px solid color-mix(in srgb, var(--border) 68%, transparent);
        }

        .admin-row:last-child {
            border-bottom: 0;
        }

        .admin-row-main {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 0;
        }

        .admin-row-text {
            min-width: 0;
        }

        .admin-row-title {
            color: var(--foreground);
            font-size: 0.86rem;
            font-weight: 700;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .admin-row-meta {
            margin-top: 0.15rem;
            color: var(--muted-foreground);
            font-size: 0.74rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .admin-log-row {
            display: grid;
            grid-template-columns: 1.5rem minmax(0, 1fr) auto;
            gap: 0.75rem;
            align-items: start;
            padding: 0.9rem 1.25rem;
            border-bottom: 1px solid color-mix(in srgb, var(--border) 68%, transparent);
        }

        .admin-log-row:last-child {
            border-bottom: 0;
        }

        .admin-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.25rem 0.55rem;
            border-radius: 999px;
            border: 1px solid var(--border);
            color: var(--muted-foreground);
            background: var(--background);
            font-size: 0.72rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .admin-status-dot {
            width: 0.45rem;
            height: 0.45rem;
            border-radius: 999px;
            background: var(--chart-1);
        }

        .admin-mini-legend {
            display: flex;
            flex-direction: column;
            gap: 0.7rem;
        }

        .admin-legend-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            color: var(--muted-foreground);
            font-size: 0.8rem;
        }

        .admin-legend-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            min-width: 0;
        }

        .admin-legend-swatch {
            width: 0.55rem;
            height: 0.55rem;
            border-radius: 999px;
            flex-shrink: 0;
        }

        .admin-chart-wrap {
            min-height: 320px;
        }

        /* M12.P1-D6 analytics presentation. The tables are not a fallback —
           they are the authoritative rendering and are always visible, so the
           exact figures are readable with or without JavaScript, and by a
           screen reader without depending on the canvas. Every size clears the
           D5 minimum readable threshold. */
        .admin-analytics-note {
            margin: 0 0 0.75rem;
            color: var(--muted-foreground);
            font-size: 0.8125rem;
            line-height: 1.45;
        }

        .admin-analytics-unavailable {
            margin: 0 0 0.75rem;
            padding: 0.6rem 0.75rem;
            border: 1px solid var(--border);
            border-left: 3px solid var(--gold);
            border-radius: 0.375rem;
            background: rgba(212, 168, 67, 0.08);
            color: var(--foreground);
            font-size: 0.8125rem;
            font-weight: 600;
            line-height: 1.45;
        }

        .admin-analytics-canvas {
            display: block;
            width: 100%;
            height: 300px;
        }

        .admin-analytics-donutwrap {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 200px;
        }

        .admin-analytics-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 1.25rem;
            justify-content: center;
            margin: 1rem 0 0;
            padding: 0;
            list-style: none;
        }

        .admin-analytics-legend-item {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            color: var(--muted-foreground);
            font-size: 0.8125rem;
        }

        .admin-analytics-legend-value {
            color: var(--foreground);
        }

        /* M12.P1-D6 analytics colour tokens.

           These are the SINGLE source of the data colours: the legend swatches
           below consume them directly, and public/js/admin/dashboard-analytics.js
           reads the same custom properties off the document element before it
           draws, falling back to the identical built-in palette. Verified
           contrast against each surface: light 11.28 / 6.12 / 5.93 / 7.56 on
           #ffffff; dark 8.88 / 12.66 / 11.16 / 12.71 on #0b1220. All are far
           above the 3:1 minimum for graphical objects. */
        :root {
            --analytics-surface: #ffffff;
            --analytics-users: #1a3a6b;
            --analytics-buildings: #8a5a00;
            --analytics-role-1: #1a3a6b;
            --analytics-role-2: #2563a8;
            --analytics-role-3: #8a5a00;
            --analytics-role-4: #4b5563;
        }

        [data-theme="dark"] {
            --analytics-surface: #0b1220;
            --analytics-users: #8ab4f8;
            --analytics-buildings: #f2c14e;
            --analytics-role-1: #8ab4f8;
            --analytics-role-2: #5eead4;
            --analytics-role-3: #f2c14e;
            --analytics-role-4: #d1d5db;
        }

        /* A patterned swatch accompanies every colour so no series or segment
           is identified by colour alone. The swatch carries the colour; the
           LABEL text stays neutral foreground text at a readable size, rather
           than small text tinted with a data colour. */
        .admin-analytics-swatch {
            width: 0.9rem;
            height: 0.9rem;
            flex-shrink: 0;
            display: inline-block;
            vertical-align: middle;
        }

        .admin-analytics-linekey {
            width: 1.6rem;
            height: 0.75rem;
            flex-shrink: 0;
            display: inline-block;
            vertical-align: middle;
        }

        .admin-mini-legend .admin-analytics-swatch {
            margin-right: 0.5rem;
        }

        .admin-analytics-legend-text,
        .admin-mini-legend .admin-legend-label {
            color: var(--foreground);
        }

        .admin-analytics-tablewrap {
            margin-top: 1rem;
            max-height: 20rem;
            overflow: auto;
        }

        .admin-analytics-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.8125rem;
        }

        .admin-analytics-table caption {
            padding-bottom: 0.5rem;
            color: var(--muted-foreground);
            font-size: 0.78rem;
            line-height: 1.45;
            text-align: left;
        }

        .admin-analytics-table th,
        .admin-analytics-table td {
            padding: 0.4rem 0.6rem;
            border-bottom: 1px solid color-mix(in srgb, var(--border) 68%, transparent);
            text-align: right;
            white-space: nowrap;
        }

        .admin-analytics-table thead th,
        .admin-analytics-table tbody th {
            color: var(--foreground);
            font-weight: 700;
        }

        .admin-analytics-table thead th:first-child,
        .admin-analytics-table tbody th[scope="row"] {
            text-align: left;
        }

        .admin-analytics-table tbody td {
            color: var(--muted-foreground);
            font-variant-numeric: tabular-nums;
        }

        .admin-command-link {
            color: var(--primary);
            font-size: 0.78rem;
            font-weight: 700;
        }

        .admin-command-link:hover {
            color: var(--gold);
        }

        [data-theme="dark"] .admin-console {
            background:
                linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
                linear-gradient(180deg, #101827 0%, #0b1220 100%);
            background-size: 34px 34px, auto;
        }

        [data-theme="dark"] .admin-section,
        [data-theme="dark"] .admin-kpi {
            background: color-mix(in srgb, var(--card) 95%, #000 5%);
        }

        [data-theme="dark"] .admin-action {
            background: color-mix(in srgb, var(--background) 84%, var(--card) 16%);
        }

        @media (max-width: 1180px) {
            .admin-kpi-grid,
            .admin-action-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .admin-main-grid,
            .admin-lower-grid {
                grid-template-columns: 1fr;
            }

            .admin-commandbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .admin-commandbar-right {
                width: 100%;
                justify-content: space-between;
            }

            .admin-command-input {
                width: min(26rem, 66vw);
            }
        }

        @media (max-width: 720px) {
            .admin-page {
                padding: 1rem;
            }

            .admin-kpi-grid,
            .admin-action-grid {
                grid-template-columns: 1fr;
            }

            .admin-topbar {
                align-items: flex-start;
                height: auto;
                min-height: 8rem;
            }

            .admin-commandbar {
                padding: 1rem;
            }

            .admin-commandbar-right {
                align-items: stretch;
                flex-direction: column;
            }

            .admin-command-input {
                width: 100%;
            }
        }
    </style>
</head>

<body class="admin-surface font-sans antialiased">
    <div class="admin-shell admin-console flex h-screen bg-background text-foreground overflow-hidden">
        <aside id="sidebar"
            class="admin-sidebar-shell relative flex h-screen flex-col bg-sidebar text-sidebar-foreground border-r border-sidebar-border transition-all duration-300 w-64 shrink-0">
            <div class="flex items-center gap-3 px-4 py-5 border-b border-sidebar-border h-16">
                <img src="/img/cspc-logo.png" alt="CSPC Logo" class="sidebar-logo shrink-0">
                <div id="sidebar-header-full" class="flex flex-col">
                    <span class="sidebar-brand-title">Campu<span>Sphere</span></span>
                    <span class="sidebar-brand-sub">Admin Portal</span>
                </div>
            </div>

            <nav class="admin-sidebar-nav flex-1 px-2 py-4 overflow-y-auto">
                <a href="/admin" class="admin-sidebar-link is-active flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="layout-dashboard" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">Dashboard</span>
                </a>
                <a href="/admin/users" class="admin-sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="users" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">Users</span>
                </a>
                <a href="/admin/news" class="admin-sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="newspaper" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">News</span>
                </a>
                <a href="/admin/faqs" class="admin-sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="help-circle" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">FAQs</span>
                </a>
                <a href="/admin/logs" class="admin-sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="file-text" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">System Logs</span>
                </a>
                <a href="/admin/campus-map" class="admin-sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="map" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">Campus Map</span>
                </a>
                <a href="/admin/vr" class="admin-sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="globe" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">VR Tour</span>
                </a>
                <a href="/admin/settings" class="admin-sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm transition-colors">
                    <i data-lucide="settings" class="h-5 w-5 shrink-0"></i>
                    <span class="sidebar-text">Settings</span>
                </a>
            </nav>

            <div class="border-t border-sidebar-border p-4">
                <div class="flex items-center gap-3">
                    <div class="ui-avatar h-9 w-9 shrink-0">
                        <div class="ui-avatar-fallback text-xs font-semibold">
                            <%= user ? ((user.first_name || '')[0] || '').toUpperCase() + ((user.last_name || '')[0] || '').toUpperCase() : 'AD' %>
                        </div>
                    </div>
                    <div id="sidebar-user-full" class="flex flex-col flex-1 min-w-0">
                        <span class="text-sm font-medium truncate"><%= user ? user.first_name + ' ' + user.last_name : 'Admin User' %></span>
                        <span class="text-xs text-sidebar-foreground/60 truncate"><%= user ? user.email : 'admin@cspc.edu.ph' %></span>
                    </div>
                    <form method="POST" action="/logout" class="logout-form" style="display:contents;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit"
                            class="ui-button ui-button-ghost ui-button-size-icon h-8 w-8 text-sidebar-foreground/70 shrink-0" title="Logout" style="cursor:pointer;">
                            <i data-lucide="log-out" class="h-4 w-4"></i>
                        </button>
                    </form>
                </div>
            </div>

            <button id="sidebar-toggle"
                class="ui-button ui-button-ghost ui-button-size-icon absolute -right-3 top-7 h-6 w-6 rounded-full border border-sidebar-border bg-sidebar text-sidebar-foreground hover:bg-sidebar-accent"
                style="width:1.5rem; height:1.5rem; padding:0;">
                <i id="sidebar-icon-left" data-lucide="chevron-left" class="h-3 w-3"></i>
                <i id="sidebar-icon-right" data-lucide="chevron-right" class="h-3 w-3 hidden"></i>
            </button>
        </aside>

        <div class="flex flex-1 flex-col overflow-hidden">
            <header class="admin-topbar flex h-16 items-center justify-between border-b border-border px-6 shrink-0">
                <div class="admin-commandbar">
                    <div class="admin-commandbar-left">
                        <span class="admin-eyebrow">CampuSphere Admin</span>
                        <h1 class="admin-command-title">Operations Command Center</h1>
                        <p class="admin-command-copy">Monitor accounts, content, campus map records, and platform activity from one control surface.</p>
                        <div class="admin-header-shortcuts">
                            <a class="admin-header-link" href="/admin/users"><i data-lucide="users" class="h-3.5 w-3.5"></i>Users</a>
                            <a class="admin-header-link" href="/admin/news"><i data-lucide="newspaper" class="h-3.5 w-3.5"></i>News</a>
                            <a class="admin-header-link" href="/admin/campus-map"><i data-lucide="map-pin" class="h-3.5 w-3.5"></i>Map</a>
                            <a class="admin-header-link" href="/admin/logs"><i data-lucide="terminal-square" class="h-3.5 w-3.5"></i>Logs</a>
                        </div>
                    </div>

                    <div class="admin-commandbar-right">
                        <div class="relative hidden md:block">
                            <i data-lucide="search"
                                class="admin-command-search-icon absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"></i>
                            <input type="search" placeholder="Search admin data..."
                                class="admin-command-input ui-input w-64 pl-9 bg-secondary/50 border-border">
                        </div>
                    </div>
                </div>
            </header>

            <main class="admin-workspace flex-1 overflow-y-auto">
                <div class="admin-page" style="display:flex; flex-direction:column; gap:1rem;">
                    <%
                        /* M12.P1-D6 truthfulness helpers.

                           `count` renders a REAL number (including a genuine 0)
                           and renders the fixed word "Unavailable" for null —
                           it never substitutes 0 for a failed read. The former
                           `|| 0` fallbacks did exactly that, which is the defect
                           D6 removes. Grouping is applied with a fixed regular
                           expression rather than toLocaleString so the rendered
                           digits are identical on every host. */
                        const groupDigits = (n) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                        const count = (n) => (typeof n === 'number' && isFinite(n)) ? groupDigits(n) : 'Unavailable';
                        const analyticsReady = analytics && analytics.state === 'ready';
                        const usersReady = analytics && analytics.status && analytics.status.users === 'ready';
                        const buildingsReady = analytics && analytics.status && analytics.status.buildings === 'ready';
                        const monthRows = (analytics && Array.isArray(analytics.months)) ? analytics.months : [];
                        const roleRows = (analytics && Array.isArray(analytics.roleRows)) ? analytics.roleRows : [];
                        const userAdditionsTotal = usersReady
                            ? monthRows.reduce((sum, m) => sum + m.userAdditions, 0) : null;
                        const buildingAdditionsTotal = buildingsReady
                            ? monthRows.reduce((sum, m) => sum + m.buildingAdditions, 0) : null;
                        const roleTotal = usersReady
                            ? roleRows.reduce((sum, r) => sum + r.count, 0) : null;
                        /* The four non-colour encodings, in role order. They
                           match ROLE_PATTERNS in
                           public/js/admin/dashboard-analytics.js, so the legend
                           swatch and the donut segment for a role always carry
                           the same pattern. Colours come from the
                           --analytics-role-N tokens, never from a literal here. */
                        const rolePatternKinds = ['solid', 'diagonal', 'crosshatch', 'dots'];
                    %>
                    <section class="admin-kpi-grid" aria-label="Key metrics">
                        <div class="admin-kpi">
                            <div class="admin-kpi-top">
                                <span class="admin-kpi-label">Total Users</span>
                                <span class="admin-kpi-icon"><i data-lucide="users" class="h-5 w-5"></i></span>
                            </div>
                            <div>
                                <div class="admin-kpi-value"><%= count(stats.totalUsers) %></div>
                                <p class="admin-kpi-note">All registered accounts</p>
                            </div>
                        </div>
                        <div class="admin-kpi">
                            <div class="admin-kpi-top">
                                <span class="admin-kpi-label">Students</span>
                                <span class="admin-kpi-icon"><i data-lucide="graduation-cap" class="h-5 w-5"></i></span>
                            </div>
                            <div>
                                <div class="admin-kpi-value"><%= count(stats.totalStudents) %></div>
                                <p class="admin-kpi-note">CSPC student role count</p>
                            </div>
                        </div>
                        <div class="admin-kpi">
                            <div class="admin-kpi-top">
                                <span class="admin-kpi-label">News Articles</span>
                                <span class="admin-kpi-icon"><i data-lucide="newspaper" class="h-5 w-5"></i></span>
                            </div>
                            <div>
                                <div class="admin-kpi-value"><%= count(stats.totalNews) %></div>
                                <p class="admin-kpi-note">Published and draft content</p>
                            </div>
                        </div>
                        <div class="admin-kpi">
                            <div class="admin-kpi-top">
                                <span class="admin-kpi-label">Buildings</span>
                                <span class="admin-kpi-icon"><i data-lucide="map" class="h-5 w-5"></i></span>
                            </div>
                            <div>
                                <div class="admin-kpi-value"><%= count(stats.totalBuildings) %></div>
                                <p class="admin-kpi-note">Campus map records</p>
                            </div>
                        </div>
                    </section>

                    <%# M12.P1-D6. Both cards below render REAL data read from the
                        currently selected backends. The semantic tables are the
                        authoritative, always-present representation and remain
                        complete without JavaScript; the canvas and the SVG are
                        progressive enhancement drawn by /js/admin/dashboard-analytics.js
                        FROM those tables. There is no interpolated JSON, no inline
                        executable data, and no fabricated value anywhere. %>
                    <section class="admin-main-grid" id="adminAnalytics"
                        data-analytics-state="<%= analytics.state %>"
                        data-analytics-timezone="<%= analytics.timezone %>">
                        <div class="admin-section">
                            <div class="admin-section-header">
                                <div>
                                    <h2 class="admin-section-title" id="additionsChartHeading">Account and Building Additions</h2>
                                    <p class="admin-section-subtitle">New accounts and new building records per calendar month.</p>
                                </div>
                                <span class="admin-pill"><%= analytics.timezone %> months</span>
                            </div>
                            <div class="admin-body-pad admin-chart-wrap">
                                <p id="additionsChartDescription" class="admin-analytics-note">
                                    Counts the accounts and building records created in each of the latest
                                    <%= analytics.monthCount %> <%= analytics.timezone %> calendar months, including the current month.
                                    These are record-creation counts only — CampuSphere records no visits, sessions, logins, map views, or page views.
                                    The full figures are listed in the table below the chart.
                                </p>
                                <% if (!usersReady && !buildingsReady) { %>
                                    <p class="admin-analytics-unavailable" role="status"><%= analytics.message %></p>
                                <% } else { %>
                                    <canvas id="additionsChart" class="admin-analytics-canvas" height="300"
                                        role="img"
                                        aria-labelledby="additionsChartHeading"
                                        aria-describedby="additionsChartDescription"></canvas>
                                    <%# Each key repeats the SAME non-colour encoding the canvas
                                        draws: a solid line with a round marker for accounts, a
                                        dashed line with a square marker for buildings. Colours
                                        come from the --analytics-* tokens; the label text stays
                                        neutral foreground text. %>
                                    <ul class="admin-analytics-legend" aria-hidden="true">
                                        <li class="admin-analytics-legend-item">
                                            <svg class="admin-analytics-linekey" viewBox="0 0 26 12" focusable="false">
                                                <line x1="1" y1="6" x2="25" y2="6" style="stroke: var(--analytics-users);" stroke-width="2"></line>
                                                <circle cx="13" cy="6" r="3.5" style="fill: var(--analytics-users);"></circle>
                                            </svg>
                                            <span class="admin-analytics-legend-text">New accounts (solid line, round marker)</span>
                                            <strong class="admin-analytics-legend-value"><%= count(userAdditionsTotal) %></strong>
                                        </li>
                                        <li class="admin-analytics-legend-item">
                                            <svg class="admin-analytics-linekey" viewBox="0 0 26 12" focusable="false">
                                                <line x1="1" y1="6" x2="25" y2="6" style="stroke: var(--analytics-buildings);" stroke-width="2" stroke-dasharray="6 4"></line>
                                                <rect x="10" y="3" width="6" height="6" style="fill: var(--analytics-buildings);"></rect>
                                            </svg>
                                            <span class="admin-analytics-legend-text">New buildings (dashed line, square marker)</span>
                                            <strong class="admin-analytics-legend-value"><%= count(buildingAdditionsTotal) %></strong>
                                        </li>
                                    </ul>
                                <% } %>

                                <div class="admin-analytics-tablewrap">
                                    <table class="admin-analytics-table" id="additionsTable">
                                        <caption>
                                            Accounts and buildings created per <%= analytics.timezone %> calendar month.
                                            Totals: <%= count(userAdditionsTotal) %> new accounts, <%= count(buildingAdditionsTotal) %> new buildings.
                                        </caption>
                                        <thead>
                                            <tr>
                                                <th scope="col">Month</th>
                                                <th scope="col">New accounts</th>
                                                <th scope="col">New buildings</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% monthRows.forEach(function (month) { %>
                                                <tr data-month-key="<%= month.key %>">
                                                    <th scope="row"><%= month.label %></th>
                                                    <td data-series="users" data-value="<%= usersReady ? month.userAdditions : '' %>"><%= count(month.userAdditions) %></td>
                                                    <td data-series="buildings" data-value="<%= buildingsReady ? month.buildingAdditions : '' %>"><%= count(month.buildingAdditions) %></td>
                                                </tr>
                                            <% }); %>
                                            <% if (monthRows.length === 0) { %>
                                                <tr><td colspan="3"><%= analytics.message %></td></tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="admin-section">
                            <div class="admin-section-header">
                                <div>
                                    <h2 class="admin-section-title" id="roleChartHeading">Account Role Distribution</h2>
                                    <p class="admin-section-subtitle">Exact account totals for each access level.</p>
                                </div>
                                <span class="admin-pill">Current totals</span>
                            </div>
                            <div class="admin-body-pad">
                                <p id="roleChartDescription" class="admin-analytics-note">
                                    Exact number of accounts currently held by each of the four CampuSphere roles.
                                    Every value is listed in the table below the chart.
                                </p>
                                <% if (!usersReady) { %>
                                    <p class="admin-analytics-unavailable" role="status"><%= analytics.message %></p>
                                <% } else { %>
                                    <div class="admin-analytics-donutwrap">
                                        <svg id="roleChart" class="admin-analytics-donut" viewBox="0 0 200 200" width="180" height="180"
                                            role="img"
                                            aria-labelledby="roleChartHeading"
                                            aria-describedby="roleChartDescription"></svg>
                                    </div>
                                    <%# Each swatch repeats the EXACT pattern its donut segment
                                        uses, so a role is identifiable without perceiving hue.
                                        The tile background is the role colour and the texture is
                                        drawn in the surface colour, matching buildRolePattern()
                                        in the client renderer. Label text stays neutral. %>
                                    <ul class="admin-mini-legend" aria-hidden="true">
                                        <% roleRows.forEach(function (row, i) { %>
                                            <% const kind = rolePatternKinds[i]; const pid = 'legend-pattern-role-' + (i + 1); %>
                                            <li class="admin-legend-row">
                                                <span class="admin-legend-label">
                                                    <svg class="admin-analytics-swatch" viewBox="0 0 16 16" focusable="false"
                                                        data-pattern-kind="<%= kind %>">
                                                        <defs>
                                                            <pattern id="<%= pid %>" patternUnits="userSpaceOnUse" width="8" height="8">
                                                                <rect width="8" height="8" style="fill: var(--analytics-role-<%= i + 1 %>);"></rect>
                                                                <% if (kind === 'diagonal') { %>
                                                                    <path d="M0,8 L8,0" style="stroke: var(--analytics-surface);" stroke-width="2"></path>
                                                                    <path d="M-2,2 L2,-2" style="stroke: var(--analytics-surface);" stroke-width="2"></path>
                                                                    <path d="M6,10 L10,6" style="stroke: var(--analytics-surface);" stroke-width="2"></path>
                                                                <% } else if (kind === 'crosshatch') { %>
                                                                    <path d="M4,0 L4,8" style="stroke: var(--analytics-surface);" stroke-width="1.6"></path>
                                                                    <path d="M0,4 L8,4" style="stroke: var(--analytics-surface);" stroke-width="1.6"></path>
                                                                <% } else if (kind === 'dots') { %>
                                                                    <circle cx="2" cy="2" r="1.4" style="fill: var(--analytics-surface);"></circle>
                                                                    <circle cx="6" cy="6" r="1.4" style="fill: var(--analytics-surface);"></circle>
                                                                <% } %>
                                                            </pattern>
                                                        </defs>
                                                        <rect width="16" height="16" fill="url(#<%= pid %>)"></rect>
                                                    </svg><%= row.label %>
                                                </span>
                                                <strong class="text-foreground"><%= count(row.count) %></strong>
                                            </li>
                                        <% }); %>
                                    </ul>
                                <% } %>

                                <div class="admin-analytics-tablewrap">
                                    <table class="admin-analytics-table" id="roleTable">
                                        <caption>
                                            Accounts per role. Total accounts: <%= count(roleTotal) %>.
                                        </caption>
                                        <thead>
                                            <tr>
                                                <th scope="col">Role</th>
                                                <th scope="col">Accounts</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% roleRows.forEach(function (row) { %>
                                                <tr data-role-key="<%= row.role %>">
                                                    <th scope="row"><%= row.label %></th>
                                                    <td data-series="role" data-value="<%= usersReady ? row.count : '' %>"><%= count(row.count) %></td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="admin-section">
                        <div class="admin-section-header">
                            <div>
                                <h2 class="admin-section-title">Quick Actions</h2>
                                <p class="admin-section-subtitle">Jump to the most-used administration workspaces.</p>
                            </div>
                        </div>
                        <div class="admin-body-pad">
                            <div class="admin-action-grid">
                                <a href="/admin/users" class="admin-action">
                                    <span class="admin-action-icon"><i data-lucide="user-plus" class="h-4 w-4"></i></span>
                                    <span>
                                        <span class="admin-action-title">Manage Users</span>
                                        <span class="admin-action-copy">Create, update, or remove accounts.</span>
                                    </span>
                                </a>
                                <a href="/admin/news" class="admin-action">
                                    <span class="admin-action-icon"><i data-lucide="newspaper" class="h-4 w-4"></i></span>
                                    <span>
                                        <span class="admin-action-title">News and Events</span>
                                        <span class="admin-action-copy">Publish announcements and schedules.</span>
                                    </span>
                                </a>
                                <a href="/admin/campus-map" class="admin-action">
                                    <span class="admin-action-icon"><i data-lucide="map-pin" class="h-4 w-4"></i></span>
                                    <span>
                                        <span class="admin-action-title">Campus Map</span>
                                        <span class="admin-action-copy">Maintain buildings and coordinates.</span>
                                    </span>
                                </a>
                                <a href="/admin/faqs" class="admin-action">
                                    <span class="admin-action-icon"><i data-lucide="help-circle" class="h-4 w-4"></i></span>
                                    <span>
                                        <span class="admin-action-title">FAQs</span>
                                        <span class="admin-action-copy">Review public help content.</span>
                                    </span>
                                </a>
                                <a href="/admin/logs" class="admin-action">
                                    <span class="admin-action-icon"><i data-lucide="file-text" class="h-4 w-4"></i></span>
                                    <span>
                                        <span class="admin-action-title">System Logs</span>
                                        <span class="admin-action-copy">Inspect recent operational events.</span>
                                    </span>
                                </a>
                                <a href="/admin/settings" class="admin-action">
                                    <span class="admin-action-icon"><i data-lucide="settings" class="h-4 w-4"></i></span>
                                    <span>
                                        <span class="admin-action-title">Settings</span>
                                        <span class="admin-action-copy">Configure portal preferences.</span>
                                    </span>
                                </a>
                            </div>
                        </div>
                    </section>

                    <section class="admin-lower-grid">
                        <div class="admin-section">
                            <div class="admin-section-header">
                                <div>
                                    <h2 class="admin-section-title">Recent Users</h2>
                                    <p class="admin-section-subtitle">Latest account records from the database.</p>
                                </div>
                                <a href="/admin/users" class="admin-command-link">View all</a>
                            </div>
                            <div class="admin-row-list">
                                <% if (recentUsers && recentUsers.length > 0) { %>
                                    <% recentUsers.forEach(account => {
                                        const roleConfig = {
                                            'admin': { label: 'Admin', colorClass: 'bg-chart-4/10 text-chart-4 border-chart-4/20' },
                                            'instructor': { label: 'Instructor', colorClass: 'bg-chart-2/10 text-chart-2 border-chart-2/20' },
                                            'student-cspc': { label: 'Student', colorClass: 'bg-chart-1/10 text-chart-1 border-chart-1/20' },
                                            'student-guest': { label: 'Guest Student', colorClass: 'bg-chart-1/10 text-chart-1 border-chart-1/20' },
                                            'guest': { label: 'Guest', colorClass: 'bg-muted/20 text-muted-foreground border-border' }
                                        };
                                        const conf = roleConfig[account.role] || { label: 'Unknown', colorClass: 'bg-muted/20 text-muted-foreground border-border' };
                                        let initials = 'NA';
                                        if (account.first_name && account.last_name) {
                                            initials = account.first_name[0] + account.last_name[0];
                                        } else if (account.email) {
                                            initials = account.email.substring(0, 2).toUpperCase();
                                        }
                                    %>
                                        <div class="admin-row">
                                            <div class="admin-row-main">
                                                <div class="ui-avatar h-10 w-10">
                                                    <div class="ui-avatar-fallback text-xs font-medium" style="font-size:0.7rem;">
                                                        <%= initials.toUpperCase() %>
                                                    </div>
                                                </div>
                                                <div class="admin-row-text">
                                                    <div class="admin-row-title"><%= account.first_name %> <%= account.last_name %></div>
                                                    <div class="admin-row-meta"><%= account.email %></div>
                                                </div>
                                            </div>
                                            <span class="ui-badge ui-badge-outline <%= conf.colorClass %>"><%= conf.label %></span>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <div class="admin-row">
                                        <p class="text-sm text-muted-foreground">No recent users found.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <div class="admin-section">
                            <div class="admin-section-header">
                                <div>
                                    <h2 class="admin-section-title">Recent News</h2>
                                    <p class="admin-section-subtitle">Newest campus announcements and articles.</p>
                                </div>
                                <a href="/admin/news" class="admin-command-link">Manage</a>
                            </div>
                            <div class="admin-row-list">
                                <% if (recentNews && recentNews.length > 0) { %>
                                    <% recentNews.forEach(item => {
                                        const catConfig = {
                                            'Announcement': 'bg-chart-1/10 text-chart-1 border-chart-1/20',
                                            'Campus Update': 'bg-chart-2/10 text-chart-2 border-chart-2/20',
                                            'Events': 'bg-chart-4/10 text-chart-4 border-chart-4/20',
                                            'Academic': 'bg-primary/10 text-primary border-primary/20',
                                            'Facilities': 'bg-chart-2/10 text-chart-2 border-chart-2/20'
                                        };
                                        const colorClass = catConfig[item.category] || 'bg-muted/20 text-muted-foreground border-border';
                                        const d = new Date(item.published_date);
                                        const dateStr = !isNaN(d) ? d.toLocaleDateString() : 'Draft';
                                        const publishLabel = item.published_date ? 'Published' : 'Draft';
                                    %>
                                        <div class="admin-row">
                                            <div class="admin-row-main">
                                                <span class="admin-action-icon"><i data-lucide="newspaper" class="h-4 w-4"></i></span>
                                                <div class="admin-row-text">
                                                    <div class="admin-row-title"><%= item.title %></div>
                                                    <div class="admin-row-meta"><%= dateStr %></div>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <span class="ui-badge ui-badge-outline <%= colorClass %>"><%= item.category %></span>
                                                <span class="ui-badge <%= item.published_date ? 'ui-badge-default' : 'ui-badge-secondary' %>"><%= publishLabel %></span>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <div class="admin-row">
                                        <p class="text-sm text-muted-foreground">No recent news found.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </section>
                </div>
            </main>
        </div>
    </div>

    <button id="admin-theme-toggle" class="admin-theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
    </button>

    <script nonce="<%= cspNonce %>">
        // M12.P1-R6: guarded. An unguarded call threw a ReferenceError when the
        // Lucide bundle was missing, which aborted this whole inline script and
        // took the activity chart below down with it. Icons degrade to absent;
        // every label, control and chart keeps working.
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }
    </script>

    <%# M12.P1-D6: the dashboard charts are drawn by a dedicated same-origin
        module that reads its numbers from the rendered tables above. No
        analytics value is interpolated into executable script, so there is no
