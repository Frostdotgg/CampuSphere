<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body class="auth-body">
    <div class="auth-page page-transition"
        style="background-image: linear-gradient(135deg, rgba(10, 22, 40, 0.72) 0%, rgba(26, 58, 107, 0.55) 100%), url('<%= backgroundImage %>');">
        <div class="auth-card">

            <%# SEC-51 correction: the theme control lives INSIDE the auth card so
                the globally fixed bottom-right placement cannot overlap the
                privacy notice or the Back to Home link. Scoped by body.auth-body
                only; every other surface keeps the global placement. %>
            <%- include('partials/theme-toggle') %>

                <!-- ===== HEADER ===== -->
            <div class="auth-header">
                <img src="/img/cspc-logo.png" alt="CSPC Logo" class="auth-logo">
                <div class="auth-brand">CAMPU<span>SPHERE</span></div>
                <p class="auth-tagline">Camarines Sur Polytechnic Colleges</p>
            </div>

            <!-- ===== TABS ===== -->
            <div class="auth-tabs" role="tablist">
                <button class="auth-tab active" id="tab-login" role="tab" aria-selected="true"
                    aria-controls="panel-login" data-tab="login">Sign In</button>
                <button class="auth-tab" id="tab-register" role="tab" aria-selected="false"
                    aria-controls="panel-register" data-tab="register">Register</button>
            </div>

            <!-- ===== ERROR / SUCCESS MESSAGES ===== -->
            <% if (typeof error !=='undefined' && error) { %>
                <div
                    style="background:rgba(239,68,68,.12);color:#dc2626;border:1px solid rgba(239,68,68,.25);padding:0.65rem 1rem;border-radius:var(--radius-md,8px);font-size:0.85rem;margin-bottom:1rem;text-align:center;">
                    <%= error %>
                </div>
                <% } %>
                    <% if (typeof success !=='undefined' && success) { %>
                        <div
                            style="background:rgba(34,197,94,.12);color:#16a34a;border:1px solid rgba(34,197,94,.25);padding:0.65rem 1rem;border-radius:var(--radius-md,8px);font-size:0.85rem;margin-bottom:1rem;text-align:center;">
                            <%= success %>
                        </div>
                        <% } %>

                            <!-- ===== LOGIN PANEL ===== -->
                            <div class="auth-panel active" id="panel-login" role="tabpanel">
                                <h2 class="auth-section-title">Welcome Back</h2>
                                <p class="auth-section-sub">Sign in to continue your campus tour</p>

                                <form id="loginForm" method="POST" action="/login">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <div class="auth-form-group">
                                        <label for="loginEmail">Email</label>
                                        <input class="auth-input" type="email" id="loginEmail" name="email"
                                            placeholder="you@cspc.edu.ph" required autocomplete="email">
                                    </div>
                                    <div class="auth-form-group">
                                        <label for="loginPassword">Password</label>
                                        <input class="auth-input" type="password" id="loginPassword" name="password"
                                            placeholder="Enter your password" required autocomplete="current-password">
                                    </div>
                                    <button class="btn-submit" type="submit" id="loginEmailBtn">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                        </svg>
                                        Sign In
                                    </button>
                                </form>

                                <div class="auth-divider">or continue with</div>

                                <a class="btn-google" id="loginGoogleBtn" href="/auth/google?intent=login">
                                    <svg class="google-g" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"
                                        width="20" height="20">
                                        <path fill="#FFC107"
                                            d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z" />
                                        <path fill="#FF3D00"
                                            d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.1 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.4 6.3 14.7z" />
                                        <path fill="#4CAF50"
                                            d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.4 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8H6.4C9.8 35.5 16.3 44 24 44z" />
                                        <path fill="#1976D2"
                                            d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4 5.5l6.2 5.2C41 35.8 44 30.3 44 24c0-1.3-.1-2.6-.4-3.9z" />
                                    </svg>
                                    Sign in using Email
                                </a>

                                <div class="auth-footer">
                                    Don't have an account?
                                    <span class="auth-link" data-tab="register">Register here</span>
                                </div>
                            </div>

                            <!-- ===== REGISTER PANEL ===== -->
                            <div class="auth-panel" id="panel-register" role="tabpanel">

                                <h2 class="auth-section-title">Create Account</h2>
                                <p class="auth-section-sub">Sign up with your CSPC or Gmail account via Google</p>

                                <a class="btn-google oauth-register-tab-link" href="/auth/google?intent=register">
                                    <svg class="google-g" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"
                                        width="20" height="20">
                                        <path fill="#FFC107"
                                            d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z" />
                                        <path fill="#FF3D00"
                                            d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.1 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.4 6.3 14.7z" />
                                        <path fill="#4CAF50"
                                            d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.4 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8H6.4C9.8 35.5 16.3 44 24 44z" />
                                        <path fill="#1976D2"
                                            d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4 5.5l6.2 5.2C41 35.8 44 30.3 44 24c0-1.3-.1-2.6-.4-3.9z" />
                                    </svg>
                                    Register using Email
                                </a>

                                <div class="auth-footer" style="margin-top:1rem;">
                                    Already have an account?
                                    <span class="auth-link" data-tab="login">Sign In</span>
                                </div>
                            </div>

                            <%# M12.P1-R8: the privacy notice must be reachable from the
                                sign-in/registration surface itself, BEFORE an account is
                                created. Anonymous route; no session required. %>
                            <p class="auth-privacy-note">
                                CampuSphere is a student capstone pilot by Team Dutchess.
                                Read the <a href="/privacy">Privacy Notice</a> to see what
                                it collects and why.
                            </p>

                            <!-- ===== BACK TO HOME ===== -->
                            <a href="/" class="auth-back-home">← Back to Home</a>

        </div>
    </div>

        <!-- ===== SCRIPTS ===== -->
        <script nonce="<%= cspNonce %>">
            /* ---- Tab Switching ---- */
            function switchTab(tab) {
                ['login', 'register'].forEach(t => {
                    document.getElementById('tab-' + t).classList.toggle('active', t === tab);
                    document.getElementById('tab-' + t).setAttribute('aria-selected', t === tab);
                    document.getElementById('panel-' + t).classList.toggle('active', t === tab);
                });
            }

            /* CSP (8.5): tab triggers use data-tab + listeners instead of inline onclick. */
            document.querySelectorAll('[data-tab]').forEach(function (el) {
                el.addEventListener('click', function () { switchTab(el.getAttribute('data-tab')); });
            });

            /* ---- Loading State Helper ---- */
            function setLoading(btn) {
                btn.disabled = true;
                btn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="animation:spin .9s linear infinite; flex-shrink:0;"><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/></svg> Authenticating...`;
            }

            /* ---- Add loading animation on form submit ---- */
            document.getElementById('loginForm').addEventListener('submit', function () {
                setLoading(document.getElementById('loginEmailBtn'));
            });

            // CSP (8.5): the @keyframes spin rule now lives in styles.css; the
            // former runtime document.createElement('style') injection was removed.

            if (window.location.hash === '#register') switchTab('register');
            <% if (typeof oauthErrorKey !== 'undefined' && oauthErrorKey) { %>
            (function () {
                <% if (oauthErrorKey === 'account_exists') { %>switchTab('login');<% } %>
                <% if (oauthErrorKey === 'account_not_found') { %>switchTab('register');<% } %>
            })();
            <% } %>
        </script>
</body>

</html>
