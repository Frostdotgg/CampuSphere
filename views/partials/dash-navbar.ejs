<% var currentTab = typeof activeTab !== 'undefined' ? activeTab : ''; %>
<!-- Server-injected session data (available to all client-side scripts) -->
<script id="sessionData" type="application/json" nonce="<%= cspNonce %>">
  <%# Keep the browser projection to fields used by shared navigation/profile
      code. Instructor legacy employee/department/position values stay server-
      side (and remain preserved in the database for compatibility) rather than
      being serialized into every authenticated page. %>
  <%- safeJson(user ? {
    id: user.id,
    username: user.username,
    email: user.email,
    role: user.role,
    first_name: user.first_name,
    last_name: user.last_name,
    profile_image_url: user.profile_image_url,
    profile_image_source: user.profile_image_source,
    student_id_number: user.student_id_number,
    course: user.course,
    year_level: user.year_level,
    enrollment_status: user.enrollment_status,
    semester: user.semester,
    address: user.address,
    phone_number: user.phone_number
  } : null) %>
</script>
<script nonce="<%= cspNonce %>">
  window.__SESSION_USER = JSON.parse(document.getElementById('sessionData').textContent);
</script>
<nav class="dash-nav" id="dashNav">
    <div class="dash-nav__inner">
        <!-- Brand -->
        <a href="/home" class="dash-nav__brand">
            <img src="/img/cspc-logo.png" alt="CSPC Logo" class="dash-nav__logo">
            <span class="dash-nav__title">CampuSphere</span>
        </a>

        <!-- Navigation Tabs -->
        <div class="dash-nav__tabs" id="dashTabs">
            <a href="/home" class="dash-nav__tab<%= currentTab === 'tabHome' ? ' dash-nav__tab--active' : '' %>" id="tabHome">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
                </svg>
                <span>Home</span>
            </a>
            <% if (user) { %>
            <a href="/dashboard" class="dash-nav__tab<%= currentTab === 'tabDashboard' ? ' dash-nav__tab--active' : '' %>" id="tabDashboard">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                </svg>
                <span>Dashboard</span>
            </a>
            <% } %>
            <a href="/buildings" class="dash-nav__tab<%= currentTab === 'tabBuildings' ? ' dash-nav__tab--active' : '' %>" id="tabBuildings">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="2" width="16" height="20" rx="2" ry="2" />
                    <path d="M9 22v-4h6v4" />
                    <path d="M8 6h.01" />
                    <path d="M16 6h.01" />
                    <path d="M12 6h.01" />
                    <path d="M12 10h.01" />
                    <path d="M12 14h.01" />
                    <path d="M16 10h.01" />
                    <path d="M16 14h.01" />
                    <path d="M8 10h.01" />
                    <path d="M8 14h.01" />
                </svg>
                <span>Buildings</span>
            </a>
            <a href="/events" class="dash-nav__tab<%= currentTab === 'tabEvents' ? ' dash-nav__tab--active' : '' %>" id="tabEvents">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
                <span>Events</span>
            </a>
            <a href="/map" class="dash-nav__tab<%= currentTab === 'tabMap' ? ' dash-nav__tab--active' : '' %>" id="tabMap">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" />
                    <line x1="8" y1="2" x2="8" y2="18" />
                    <line x1="16" y1="6" x2="16" y2="22" />
                </svg>
                <span>Campus Map</span>
            </a>
            <a href="/about" class="dash-nav__tab<%= currentTab === 'tabAbout' ? ' dash-nav__tab--active' : '' %>" id="tabAbout">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="16" x2="12" y2="12" />
                    <line x1="12" y1="8" x2="12.01" y2="8" />
                </svg>
                <span>About Us</span>
            </a>
            <a href="/faq" class="dash-nav__tab mobile-only<%= currentTab === 'tabFaq' ? ' dash-nav__tab--active' : '' %>" id="tabFaqMobile"<%= currentTab === 'tabFaq' ? ' aria-current="page"' : '' %>>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M9.5 9a2.5 2.5 0 1 1 4.1 1.9c-.9.7-1.6 1.1-1.6 2.6" />
                    <path d="M12 17h.01" />
                </svg>
                <span>FAQs</span>
            </a>

            <% if (user) { %>
            <div class="dash-nav__tabs-divider mobile-only"></div>
            <button class="dash-nav__tab dash-nav__notification-mobile mobile-only" id="mobileNotifBtn" type="button"
                data-notification-trigger aria-haspopup="dialog" aria-controls="notificationPanel"
                aria-expanded="false" aria-label="Notifications">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                </svg>
                <span>Notifications</span>
                <span class="dash-nav__notif-dot" hidden aria-hidden="true"></span>
            </button>
            <button class="dash-nav__tab mobile-only" id="mobileEditProfileBtn" type="button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                <span>Edit Profile</span>
            </button>
            <button class="dash-nav__tab dash-nav__tab--logout mobile-only" id="mobileLogoutBtn" type="button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Logout</span>
            </button>
            <% } else { %>
            <div class="dash-nav__tabs-divider mobile-only"></div>
            <a href="/auth" class="dash-nav__tab mobile-only" id="mobileLoginBtn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                    <polyline points="10 17 15 12 10 7"></polyline>
                    <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                <span>Login</span>
            </a>
            <% } %>
        </div>

        <!-- Right: Notification + User -->
        <div class="dash-nav__right">
            <a href="/faq" class="dash-nav__tab<%= currentTab === 'tabFaq' ? ' dash-nav__tab--active' : '' %>" id="tabFaq"<%= currentTab === 'tabFaq' ? ' aria-current="page"' : '' %>>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M9.5 9a2.5 2.5 0 1 1 4.1 1.9c-.9.7-1.6 1.1-1.6 2.6" />
                    <path d="M12 17h.01" />
                </svg>
                <span>FAQ</span>
            </a>
            <% if (user) { %>
            <button class="dash-nav__icon-btn" id="notifBtn" type="button" data-notification-trigger
                aria-haspopup="dialog" aria-controls="notificationPanel" aria-expanded="false"
                aria-label="Notifications">
                <!-- Inline SVG (was iconify-icon): the web component injects a
                     shadow-root <style> that violates style-src-elem under the
                     nonce CSP. Inline SVG needs no style permissions. -->
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                </svg>
                <span class="dash-nav__notif-dot" hidden aria-hidden="true"></span>
            </button>
            <div class="dash-nav__user" id="userMenu">
                <div class="dash-nav__avatar">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </div>
                <span class="dash-nav__username" id="navUsername"><%= user.first_name || 'User' %></span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round" class="dash-nav__chevron" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9" />
                </svg>
            </div>
            <% } else { %>
            <a href="/auth" class="dash-nav__login-btn" id="navLoginBtn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                    <polyline points="10 17 15 12 10 7"></polyline>
                    <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                <span>Login</span>
            </a>
            <% } %>
        </div>

        <!-- Mobile Hamburger (M12.P1-D2: state owned solely by the shared
             /js/authenticated-nav.js client loaded below) -->
        <button class="dash-nav__hamburger" id="dashHamburger" type="button"
            aria-controls="dashTabs" aria-expanded="false"
            aria-label="Open navigation menu">
            <span></span><span></span><span></span>
        </button>
    </div>
    <% if (user) { %>
    <section id="notificationPanel" class="dash-nav__notifications-panel" role="dialog" aria-modal="false"
        aria-labelledby="notificationPanelTitle" aria-hidden="true" hidden>
        <div class="dash-nav__notifications-header">
            <h2 id="notificationPanelTitle" tabindex="-1">Notifications</h2>
            <button id="notificationPanelClose" class="dash-nav__notification-close" type="button"
                aria-label="Close notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
        <p id="notificationPanelStatus" class="dash-nav__notification-status" role="status" aria-live="polite">
            Loading notifications...
        </p>
        <div id="notificationPanelError" class="dash-nav__notification-error" role="alert" hidden>
            <p>Notifications are temporarily unavailable.</p>
            <button id="notificationPanelRetry" class="dash-nav__notification-retry" type="button">Try again</button>
        </div>
        <div id="notificationPanelContent" class="dash-nav__notification-content" hidden>
            <section id="notificationAnnouncementsSection" class="dash-nav__notification-section"
                aria-labelledby="notificationAnnouncementsHeading">
                <h3 id="notificationAnnouncementsHeading">Announcements</h3>
                <div id="notificationAnnouncementsList" class="dash-nav__notification-list"></div>
            </section>
            <section id="notificationEventsSection" class="dash-nav__notification-section"
                aria-labelledby="notificationEventsHeading">
                <h3 id="notificationEventsHeading">Upcoming events</h3>
                <div id="notificationEventsList" class="dash-nav__notification-list"></div>
            </section>
        </div>
        <p id="notificationPanelEmpty" class="dash-nav__notification-empty" hidden>
            No announcements or upcoming events.
        </p>
        <div class="dash-nav__notifications-footer">
            <a id="notificationAnnouncementsLink" href="/dashboard?section=news">View announcements</a>
            <a id="notificationEventsLink" href="/events">View events</a>
        </div>
    </section>
    <% } %>
</nav>
<%# M12.P1-D2: the ONE shared authenticated-navigation client. Every page that
    renders this partial (including both VR views) gets exactly this include —
    page-local dashHamburger handlers were removed. %>
<script src="/js/authenticated-nav.js" defer></script>
<script src="/js/user-presence.js" defer></script>
<script src="/js/notification-panel.js" defer></script>
