<% const footerSettings = (typeof siteSettings === 'object' && siteSettings) ? siteSettings : {}; %>
<footer class="footer" id="footer">
    <div class="container">
        <div class="footer__inner">
            <!-- Column 1: Brand + SDGs -->
            <div>
                <div class="footer__brand">
                    <img src="/img/cspc-logo.png" alt="CSPC Logo" class="footer__brand-logo">
                    <span class="footer__brand-name">CampuSphere</span>
                </div>
                <p class="footer__desc">
                    A role-based online portal with Progressive Web App for interactive
                    campus mapping at <%= footerSettings.school_name || 'Camarines Sur Polytechnic Colleges' %>,
                    <%= footerSettings.school_address || 'Nabua, Camarines Sur, Philippines' %>.
                </p>
                <div class="footer__sdg">
                    <span class="footer__sdg-badge footer__sdg-badge--sdg4">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                        </svg>
                        SDG 4 — Quality Education
                    </span>
                    <span class="footer__sdg-badge footer__sdg-badge--sdg9">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="4" y="2" width="16" height="20" rx="2" ry="2" />
                            <line x1="12" y1="18" x2="12.01" y2="18" />
                        </svg>
                        SDG 9 — Innovation &amp; Infrastructure
                    </span>
                </div>
            </div>

            <!-- Column 2: Quick Links -->
            <div>
                <h4 class="footer__heading">Quick Links</h4>
                <ul class="footer__list">
                    <li><a href="/">Home</a></li>
                    <li><a href="/map">Campus Map</a></li>
                    <li><a href="/buildings">Buildings</a></li>
                    <li><a href="/faq">FAQs</a></li>
                    <li><a href="/about">About</a></li>
                    <li><a href="/auth">Sign In</a></li>
                </ul>
            </div>

            <%# M12.P1-R8: every link below must resolve to a real destination.
                FAQ now points to the public, server-rendered FAQ page; do not
                replace it with an empty-fragment placeholder. %>
            <!-- Column 3: Resources -->
            <div>
                <h4 class="footer__heading">Resources</h4>
                <ul class="footer__list">
                    <li><a href="<%= footerSettings.contact_website || 'https://cspc.edu.ph' %>"
                            rel="noopener noreferrer" target="_blank"><%= footerSettings.school_acronym || 'CSPC' %>
                            Official Website</a></li>
                    <li><a href="/faq">Frequently Asked Questions</a></li>
                    <li><a href="/privacy">Privacy Notice</a></li>
                </ul>
            </div>

            <!-- Column 4: Team Dutchess -->
            <div>
                <h4 class="footer__heading">Team Dutchess</h4>
                <div class="footer__team-member">Carl Andrie D. Baldoza</div>
                <div class="footer__team-member">Carl Ryan P. Lagrimas</div>
                <div class="footer__team-member">Ocean Derek L. Regondola</div>
                <div class="footer__team-member">Aaron V. Lasprillas</div>
                <div class="footer__team-member">John Lawrence A. Paga</div>
            </div>
        </div>

        <div class="footer__bottom">
            <span>&copy; 2026 CampuSphere — Team Dutchess. All rights reserved.</span>
            <%# The former "Terms of Use" placeholder is REMOVED: no terms document
                exists, and inventing a destination would be worse than omitting
                the link. The privacy link now resolves to the real /privacy
                notice instead of an empty fragment. %>
            <div class="footer__bottom-links">
                <a href="/privacy">Privacy Notice</a>
                <a href="https://cspc.edu.ph/governance/privacy-policy/" rel="noopener noreferrer"
                    target="_blank">CSPC Privacy Policy</a>
            </div>
        </div>
    </div>
</footer>
