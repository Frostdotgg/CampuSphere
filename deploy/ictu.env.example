# CampuSphere ICTU production Docker template.
# Copy this file to a protected path outside the repository, replace every
# placeholder there, restrict access to the ICTU deployment account, and pass
# that protected file with Docker Compose --env-file. Never commit the copy.

# Image and host binding. Keep the safe loopback default when ICTU's HTTPS
# reverse proxy runs on the same host.
IMAGE_TAG=ictu
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000

# Express session signing. Generate a unique random value of at least 32
# characters; do not reuse a Google, Supabase, or offline-signing credential.
SESSION_SECRET=REPLACE_WITH_UNIQUE_RANDOM_32_PLUS_CHARACTER_VALUE
SESSION_SECRET_PREVIOUS=
SESSION_COOKIE_MAX_AGE_MS=86400000

# Existing external Supabase project. These values are server-only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SUPABASE_KEY

# Google OAuth web application. The callback itself is fixed by Compose to
# https://campusphere.cspc.edu.ph/auth/callback.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_WEB_CLIENT_SECRET

# Public, signed offline-map release configuration. The private signing key is
# not a runtime variable and must never be placed on the ICTU application host.
OFFLINE_MAP_RELEASE_MODE=drive
OFFLINE_MAP_MANIFEST_URL=https://drive.google.com/REPLACE_WITH_PUBLIC_MANIFEST_PATH
OFFLINE_MAP_SIGNING_PUBLIC_KEY=REPLACE_WITH_ED25519_PUBLIC_VERIFICATION_KEY
