{
  "name": "campusphere",
  "version": "1.0.0",
  "description": "CampusSphere — CSPC Virtual Campus Map Tour (MVC Architecture)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/quality-gates.js",
    "qa": "node scripts/quality-gates.js && node scripts/db-perf-gate.js && node scripts/supabase-smoke.js && node scripts/verify-identity-constraints.js && npm audit --omit=dev",
    "qa:contracts": "node scripts/quality-gates.js",
    "qa:db": "node scripts/db-perf-gate.js",
    "qa:smoke": "node scripts/supabase-smoke.js",
    "qa:identity": "node scripts/verify-identity-constraints.js",
    "qa:audit": "npm audit --omit=dev"
  },
  "keywords": [
    "cspc",
    "campus",
    "map",
    "express",
    "ejs"
  ],
  "author": "Team Dutchess",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@upstash/redis": "1.38.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "ejs": "6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "mysql2": "^3.22.2"
  }
}
